@model MarketingPage
@{
    Layout = null;
    const string pageTitle = "OJunnySyS | CRM, POS e inventario en una sola plataforma";
    const string pageDescription = "Conoce OJunnySyS: una plataforma comercial web e instalable para clientes, ventas, punto de venta, inventario y compras. Un espacio para cada negocio.";
}
<!doctype html>
<html lang="es-DO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <link rel="stylesheet" href="~/tailwind.css" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#102b29" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:site_name" content="OJunnySyS" />
    <meta property="og:title" content="OJunnySyS | Tu negocio, en orden" />
    <meta property="og:description" content="Clientes, ventas, inventario y compras en una plataforma que puedes instalar." />
    <meta name="twitter:card" content="summary" />
    @if (Model.CanonicalUrl is not null) { <link rel="canonical" href="@Model.CanonicalUrl" /> }
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/ojunnysy-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json">@Html.Raw(Model.StructuredDataJson)</script>
    <style>
        :root{--ink:#132b27;--deep:#102b29;--deep-2:#173e37;--green:#19815e;--mint:#b9f2d2;--lime:#dbff8b;--paper:#f6f8f5;--muted:#698079;--line:#dce7e0;--white:#fff;--shadow:0 28px 80px #0e2f2414}
        *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 "DM Sans",sans-serif}a{color:inherit;text-decoration:none}button,a{-webkit-tap-highlight-color:transparent}.wrap{width:min(1180px,calc(100% - 48px));margin:auto}
        .button{min-height:46px;padding:0 19px;display:inline-flex;align-items:center;justify-content:center;border-radius:11px;font-weight:700;font-size:14px;transition:transform .18s ease,background .18s ease}.button:hover{transform:translateY(-2px)}.button-dark{background:var(--deep);color:white}.button-dark:hover{background:#1c5044}.button-lime{background:var(--lime);color:var(--deep)}.button-quiet{color:#35554d}.button-outline{border:1px solid #b7cec2;background:#ffffff70;color:var(--deep)}
        .hero{position:relative;overflow:hidden;padding:84px 0 68px;background:var(--deep);color:white}.hero:before{content:"";position:absolute;width:620px;height:620px;top:-345px;right:3%;border:1px solid #ffffff14;border-radius:50%;box-shadow:0 0 0 70px #ffffff08,0 0 0 145px #ffffff06}.hero:after{content:"";position:absolute;width:450px;height:450px;bottom:-365px;left:36%;border:1px solid #b9f2d21a;border-radius:50%;box-shadow:0 0 0 70px #b9f2d20b}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:68px}.eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--mint);font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.eyebrow i{width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 14px var(--lime)}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:Manrope,sans-serif;letter-spacing:-.045em}h1{max-width:680px;margin:20px 0 18px;font-size:clamp(42px,5.3vw,70px);line-height:1.04;font-weight:800}.hero h1 span{color:var(--lime)}.hero-copy{max-width:560px;color:#c0d4cd;font-size:18px;line-height:1.7}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin:28px 0 22px}.hero-footnote{color:#95b2a7;font-size:13px}.trust-line{display:flex;align-items:center;gap:10px;color:#c0d4cd;font-size:13px}.trust-line span{color:var(--lime);font-size:18px}
        .product-window{position:relative;padding:14px;border:1px solid #ffffff27;border-radius:22px;background:#f7faf8;box-shadow:0 34px 90px #061b17a3;transform:rotate(1deg)}.window-top{display:flex;align-items:center;justify-content:space-between;padding:5px 7px 13px;color:#637770;font-size:11px}.window-dots{display:flex;gap:5px}.window-dots i{height:7px;width:7px;background:#c7d6cf;border-radius:50%}.window-body{min-height:355px;display:grid;grid-template-columns:58px 1fr;gap:11px}.mini-sidebar{padding:10px 8px;border-radius:12px;background:var(--deep);display:flex;flex-direction:column;align-items:center;gap:11px}.mini-logo{width:27px;height:27px;display:grid;place-items:center;border-radius:9px;background:var(--lime);color:var(--deep);font-weight:900}.mini-icon{width:31px;height:28px;display:grid;place-items:center;border-radius:8px;color:#aec8bd}.mini-icon.active{background:#effcf4;color:#276d52}.mini-content{padding:11px 12px;color:var(--ink)}.mini-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.mini-top small,.mini-card small{display:block;color:#7d9289;font-size:10px}.mini-top strong{font-size:13px}.mini-badge{padding:5px 8px;border-radius:999px;background:#e7f6ed;color:#31825c;font-size:9px;font-weight:800}.mini-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mini-card{min-height:76px;padding:10px;border:1px solid #e4ede7;border-radius:10px;background:#fff}.mini-card strong{display:block;margin-top:9px;font:700 17px Manrope}.mini-card small{font-size:8px;letter-spacing:.04em}.mini-bottom{display:grid;grid-template-columns:1.2fr .8fr;gap:9px;margin-top:10px}.mini-panel{min-height:149px;padding:11px;border:1px solid #e4ede7;border-radius:10px;background:#fff}.mini-panel h3{margin-bottom:8px;font-size:11px}.chart{height:83px;display:flex;align-items:end;gap:7px;padding:4px 5px}.chart i{flex:1;border-radius:4px 4px 1px 1px;background:linear-gradient(0deg,#21815b,#b7edbc)}.mini-sale{display:flex;align-items:center;gap:7px;padding:7px 0;border-bottom:1px solid #edf2ee}.mini-sale:last-child{border:0}.mini-sale i{width:23px;height:23px;border-radius:7px;background:#e2f2e7}.mini-sale span{flex:1;color:#637770;font-size:8px}.mini-sale strong{font-size:8px}.floating-chip{position:absolute;right:-20px;bottom:28px;padding:11px 15px;border:1px solid #d7e8dc;border-radius:13px;background:white;color:var(--deep);box-shadow:var(--shadow);font-size:12px;font-weight:750}.floating-chip span{color:var(--green)}.preview-note{display:inline-block;margin-top:9px;color:#71857d;font-size:9px;font-weight:600}
        .proof{padding:22px 0;border-bottom:1px solid var(--line);background:#fff}.proof-inner{display:flex;align-items:center;justify-content:space-between;gap:22px;color:#748980;font-size:13px}.proof-inner strong{color:var(--deep);font-size:14px}.proof-points{display:flex;gap:24px;flex-wrap:wrap}.proof-points span:before{content:"✓";margin-right:7px;color:var(--green);font-weight:900}
        section.content{padding:86px 0}.section-heading{max-width:700px;margin:0 auto 40px;text-align:center}.section-heading .eyebrow{color:var(--green)}.section-heading h2{margin:13px 0 12px;font-size:clamp(30px,4vw,46px);line-height:1.12}.section-heading p{color:var(--muted);font-size:17px}.modules{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.module-card{min-height:205px;padding:24px;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:0 8px 22px #17382b08}.module-icon{width:43px;height:43px;display:grid;place-items:center;border-radius:13px;background:#e4f6e9;color:#237450;font-size:21px}.module-card:nth-child(2) .module-icon{background:#e5f1ff;color:#356eae}.module-card:nth-child(3) .module-icon{background:#fef0d9;color:#a66a15}.module-card:nth-child(4) .module-icon{background:#ecedff;color:#5960a9}.module-card:nth-child(5) .module-icon{background:#ffe8e4;color:#b45c4e}.module-card:nth-child(6) .module-icon{background:#e2f4f2;color:#287a71}.module-card h3{margin:18px 0 7px;font-size:19px}.module-card p{margin:0;color:var(--muted);font-size:14px;line-height:1.65}
        .install{padding:0 0 86px}.install-box{display:grid;grid-template-columns:1.05fr .95fr;gap:30px;align-items:center;overflow:hidden;padding:42px;border-radius:22px;background:#e7f4ec}.install-box h2{margin:10px 0;font-size:34px;line-height:1.15}.install-box p{max-width:500px;margin-bottom:20px;color:#58756a}.device-row{display:flex;justify-content:center;align-items:end;gap:16px;min-height:215px}.device{border:5px solid #173c34;background:#fff;box-shadow:0 20px 35px #1c48371c}.device.desktop{width:252px;height:157px;padding:13px;border-radius:14px}.device.mobile{width:84px;height:157px;padding:12px 7px;border-width:4px;border-radius:20px}.device-screen{height:100%;border-radius:7px;background:linear-gradient(145deg,#143b32,#237855);padding:10px;color:white;font-size:8px}.device-screen b{display:block;color:var(--lime);font-size:10px}.device-screen i{display:block;height:14px;margin-top:7px;border-radius:4px;background:#ffffff25}.device-screen i:nth-child(3){width:73%}.device-screen i:nth-child(4){width:88%}
        .steps{background:#fff}.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.step{padding:25px;border-top:2px solid #b9d7c3}.step b{color:var(--green);font:800 14px Manrope;letter-spacing:.1em}.step h3{margin:14px 0 7px;font-size:19px}.step p{color:var(--muted);font-size:14px}
        .faq-list{max-width:790px;margin:auto}.faq-list details{padding:20px 2px;border-bottom:1px solid var(--line)}.faq-list summary{cursor:pointer;list-style:none;font:700 16px Manrope}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary:after{content:"+";float:right;color:var(--green);font-size:20px}.faq-list details[open] summary:after{content:"−"}.faq-list details p{margin:11px 36px 0 0;color:var(--muted);font-size:15px}
        .cta{padding:72px 0;background:var(--deep);color:#fff;text-align:center}.cta h2{max-width:670px;margin:0 auto 13px;font-size:clamp(32px,4vw,48px);line-height:1.12}.cta p{margin-bottom:24px;color:#c0d4cd;font-size:16px}.cta .button{margin:0 auto}.footer{padding:27px 0;background:#0b211f;color:#afc4bb}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer .brand-word{color:white}.footer small{font-size:12px}.footer-links{display:flex;gap:19px;font-size:13px}
        @@media(max-width:900px){.hero-grid{gap:30px}.hero{padding:64px 0}.modules{grid-template-columns:repeat(2,1fr)}.proof-inner{align-items:flex-start;flex-direction:column}.install-box{padding:30px}.device.desktop{width:215px}}@@media(max-width:680px){.wrap{width:min(100% - 32px,520px)}.hero{padding:54px 0 48px}.hero-grid{grid-template-columns:1fr;gap:34px}.hero-copy{font-size:16px}.product-window{max-width:490px;margin:0 auto;transform:none}.window-body{min-height:300px}.floating-chip{right:-4px;bottom:14px}.proof{padding:18px 0}.proof-points{gap:11px 17px}.content{padding:66px 0!important}.section-heading{margin-bottom:28px}.section-heading p{font-size:15px}.modules{grid-template-columns:1fr}.module-card{min-height:0;padding:21px}.install-box{grid-template-columns:1fr;padding:25px 20px}.install-box h2{font-size:29px}.device-row{min-height:180px}.steps-grid{grid-template-columns:1fr;gap:4px}.step{padding:18px 4px}.footer-inner{align-items:flex-start;flex-direction:column}.footer-links{flex-wrap:wrap}}
        @@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
    </style>
</head>
<body>
<header class="site-header sticky top-0 z-10 border-b border-[#e5ece7] bg-[#f6f8f5]/95 backdrop-blur"><div class="wrap nav mx-auto flex h-16 items-center justify-between gap-4 xl:h-[78px]"><a class="brand flex shrink-0 items-center gap-2.5" href="/" aria-label="OJunnySyS inicio"><span class="brand-mark grid size-11 place-items-center rounded-[14px] bg-[var(--deep)] font-[Manrope] text-[21px] font-extrabold text-white">O<b class="text-[var(--lime)]">.</b></span><span class="brand-word whitespace-nowrap font-[Manrope] text-lg font-extrabold tracking-[-.04em] text-[var(--ink)]">ojunny<span class="text-[var(--green)]">sys</span></span></a><nav class="nav-links hidden items-center gap-[30px] text-sm font-semibold text-[#55716a] min-[1100px]:flex" aria-label="Navegación"><a href="#plataforma">Plataforma</a><a href="#instalable">App instalable</a><a href="#preguntas">Preguntas frecuentes</a></nav><div class="nav-actions flex shrink-0 items-center gap-2.5"><a class="button button-quiet hidden min-[1100px]:inline-flex" href="/account/login?returnUrl=%2Fapp">Iniciar sesión</a><a class="button button-dark min-h-10 whitespace-nowrap px-3 text-xs sm:px-4 sm:text-sm" href="/account/register"><span class="hidden min-[1100px]:inline">Crear espacio de prueba</span><span class="min-[1100px]:hidden">Crear cuenta</span></a></div></div></header>
<main>
    <section class="hero"><div class="wrap hero-grid"><div><span class="eyebrow"><i></i> Una plataforma para hacer crecer negocios</span><h1>Tu negocio, en orden. <span>Tu equipo, en movimiento.</span></h1><p class="hero-copy">Clientes, ventas, productos y compras en un solo espacio. Abre OJunnySyS desde el navegador o instálalo para trabajar como en una aplicación de escritorio.</p><div class="hero-actions"><a class="button button-lime" href="/account/register">Crear mi espacio de prueba</a><a class="button button-outline" href="#plataforma">Conocer la plataforma</a></div><p class="hero-footnote">Un espacio independiente y privado para cada empresa.</p><div class="trust-line"><span>✦</span> Diseñado para equipos que venden, compran y atienden clientes.</div></div>
        <div class="product-window" aria-label="Vista previa ilustrativa del panel comercial"><div class="window-top"><div class="window-dots"><i></i><i></i><i></i></div><span>OJunnySyS · espacio de trabajo</span><span>•••</span></div><div class="window-body"><aside class="mini-sidebar"><div class="mini-logo">O</div><span class="mini-icon active">⌂</span><span class="mini-icon">♧</span><span class="mini-icon">▦</span><span class="mini-icon">▣</span><span class="mini-icon">▤</span></aside><div class="mini-content"><div class="mini-top"><div><small>RESUMEN DEL NEGOCIO</small><strong>Un día claro para decidir</strong></div><span class="mini-badge">● En línea</span></div><div class="mini-cards"><div class="mini-card"><small>VENTAS DE HOY</small><strong>RD$ 24.8k</strong></div><div class="mini-card"><small>ÓRDENES</small><strong>38</strong></div><div class="mini-card"><small>CLIENTES</small><strong>126</strong></div></div><div class="mini-bottom"><section class="mini-panel"><h3>Actividad de ventas</h3><div class="chart"><i style="height:38%"></i><i style="height:58%"></i><i style="height:47%"></i><i style="height:76%"></i><i style="height:61%"></i><i style="height:91%"></i><i style="height:69%"></i><i style="height:82%"></i></div></section><section class="mini-panel"><h3>Últimos movimientos</h3><div class="mini-sale"><i></i><span>Venta en mostrador</span><strong>+2.4k</strong></div><div class="mini-sale"><i></i><span>Compra a proveedor</span><strong>−8.1k</strong></div><div class="mini-sale"><i></i><span>Cliente nuevo</span><strong>CRM</strong></div></section></div></div><small class="preview-note">Vista ilustrativa · cifras de ejemplo</small></div></div><div class="floating-chip"><span>✓</span> Una experiencia web, como una app</div></div></div></section>
    <section class="proof"><div class="wrap proof-inner"><strong>Una sola vista para coordinar el trabajo diario</strong><div class="proof-points"><span>Privacidad por empresa</span><span>Escritorio y móvil</span><span>Roles para tu equipo</span><span>Datos bajo tu control</span></div></div></section>
    <section class="content" id="plataforma"><div class="wrap"><div class="section-heading"><span class="eyebrow">Tu operación, conectada</span><h2>Más claridad en cada parte del negocio</h2><p>La plataforma crece por módulos para que cada equipo tenga las herramientas que usa a diario, con la información de su empresa aislada.</p></div><div class="modules">
        <article class="module-card"><span class="module-icon">♧</span><h3>Relaciones con clientes</h3><p>Centraliza contactos, historial de compras y seguimiento para que cada conversación tenga contexto.</p></article>
        <article class="module-card"><span class="module-icon">▣</span><h3>Punto de venta</h3><p>Registra artículos, cliente, pagos e impuestos desde una pantalla ágil diseñada para mostrador.</p></article>
        <article class="module-card"><span class="module-icon">▦</span><h3>Productos e inventario</h3><p>Consulta existencias, organiza el catálogo y detecta qué productos necesitan reposición.</p></article>
        <article class="module-card"><span class="module-icon">↗</span><h3>Compras y proveedores</h3><p>Da seguimiento a órdenes de compra y abastecimiento en el mismo sistema de ventas.</p></article>
        <article class="module-card"><span class="module-icon">▤</span><h3>Caja, pagos y recibos</h3><p>Conecta la actividad de caja con cierres, comprobantes e historial por usuario.</p></article>
        <article class="module-card"><span class="module-icon">▥</span><h3>Reportes de gestión</h3><p>Revisa ventas, pagos, productos y actividad del negocio en informes fáciles de interpretar.</p></article>
    </div></div></section>
    <section class="install" id="instalable"><div class="wrap install-box"><div><span class="eyebrow" style="color:#237450">Una aplicación, donde la necesites</span><h2>Instálala en tu escritorio. Llévala contigo.</h2><p>OJunnySyS es una aplicación web progresiva. Puedes abrirla en el navegador o instalarla en un computador y en dispositivos compatibles para acceder desde su propio ícono.</p><a class="button button-dark" href="/account/login?returnUrl=%2Fapp">Abrir mi espacio</a></div><div class="device-row" aria-hidden="true"><div class="device desktop"><div class="device-screen"><b>ojunnysys</b><i></i><i></i><i></i><i></i></div></div><div class="device mobile"><div class="device-screen"><b>O.</b><i></i><i></i><i></i></div></div></div></div></section>
    <section class="content steps"><div class="wrap"><div class="section-heading"><span class="eyebrow">Empieza simple</span><h2>Tu equipo en marcha en tres pasos</h2></div><div class="steps-grid"><article class="step"><b>01 / TU EMPRESA</b><h3>Configura tu espacio</h3><p>Registra tu empresa, confirma tu correo y comienza con un espacio privado y 14 días de prueba.</p></article><article class="step"><b>02 / TU EQUIPO</b><h3>Asigna roles</h3><p>Organiza quién puede consultar clientes, atender ventas o revisar reportes.</p></article><article class="step"><b>03 / TU OPERACIÓN</b><h3>Trabaja en la web o instalada</h3><p>Abre la misma experiencia desde navegador o una PWA en tu escritorio y teléfono.</p></article></div></div></section>
    <section class="content" id="preguntas"><div class="wrap"><div class="section-heading"><span class="eyebrow">Preguntas frecuentes</span><h2>Lo esencial antes de comenzar</h2></div><div class="faq-list"><details><summary>¿OJunnySyS es una aplicación web o de escritorio?</summary><p>Es una aplicación web progresiva. Funciona desde el navegador y puede instalarse en dispositivos compatibles para abrirse en una ventana propia, como una app.</p></details><details><summary>¿Cada negocio comparte los datos con los demás?</summary><p>No. Cada cuenta trabaja dentro de su propio espacio de empresa y la plataforma aplica una separación de datos por empresa.</p></details><details><summary>¿Puedo trabajar sin conexión a internet?</summary><p>La app instalada puede conservar su interfaz básica, pero las ventas y cambios requieren conexión para confirmar y guardar la información en MySQL. La sincronización segura sin conexión está en desarrollo.</p></details><details><summary>¿Qué módulos incluye la plataforma?</summary><p>Incluye CRM de clientes, catálogo, inventario por almacén, punto de venta, ventas, compras, proveedores, turnos de caja y reportes. La facturación electrónica DGII, la operación offline de ventas y la contratación de planes en línea aún no están habilitadas.</p></details><details><summary>¿Dónde quedan mis datos?</summary><p>La aplicación está diseñada sobre MySQL y usa almacenamiento aislado por empresa. El alojamiento definitivo y las políticas de respaldo deben configurarse antes de producción.</p></details></div></div></section>
    <section class="cta"><div class="wrap"><h2>Una operación más clara empieza con un buen espacio de trabajo.</h2><p>Entra a la plataforma local y conoce la experiencia que estamos construyendo.</p><a class="button button-lime" href="/account/login?returnUrl=%2Fapp">Iniciar sesión en OJunnySyS</a></div></section>
</main>
<footer class="footer"><div class="wrap footer-inner"><a class="brand" href="/"><span class="brand-mark">O<b>.</b></span><span class="brand-word">ojunny<span>sys</span></span></a><small>© @DateTime.UtcNow.Year OJunnySyS. Gestión comercial para equipos en movimiento.</small><nav class="footer-links" aria-label="Enlaces del pie"><a href="/account/login">Acceso a la plataforma</a><a href="#preguntas">Preguntas frecuentes</a></nav></div></footer>
</body>
</html>

