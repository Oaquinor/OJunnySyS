@model IReadOnlyList<OJunnySyS.Application.Contracts.TenantSummary>
@{
    Layout = null;
    var input = ViewData["Input"] as CreateTenantInput ?? new CreateTenantInput();
    string StatusLabel(OJunnySyS.Domain.Tenancy.TenantStatus status) => status switch { OJunnySyS.Domain.Tenancy.TenantStatus.Trial => "Prueba", OJunnySyS.Domain.Tenancy.TenantStatus.Active => "Activa", OJunnySyS.Domain.Tenancy.TenantStatus.Suspended => "Suspendida", _ => "Cerrada" };
}
<!doctype html>
<html lang="es-DO"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Empresas · Administración de plataforma</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<style>
:root{--ink:#142b26;--green:#19815e;--mint:#dbff8b;--muted:#70857c;--line:#e0e9e3}*{box-sizing:border-box}body{margin:0;background:#f3f6f2;color:var(--ink);font:15px/1.5 system-ui,sans-serif}.shell{min-height:100vh;display:grid;grid-template-columns:235px 1fr}.side{padding:25px 18px;background:linear-gradient(180deg,#12322e,#0d2927);color:#edf6f0}.brand{display:flex;align-items:center;gap:10px;margin:0 0 35px;font-weight:800;font-size:18px}.mark{width:39px;height:39px;display:grid;place-items:center;border-radius:12px;background:var(--mint);color:#12322e;font-weight:900}.label{margin:0 9px 10px;color:#9ab6aa;font-size:11px;letter-spacing:.12em;font-weight:800}.side a{display:block;padding:11px 12px;border-radius:9px;color:#c6d9cf;text-decoration:none;font-size:14px}.side a.active{background:var(--mint);color:#183e32;font-weight:750}.main{min-width:0}.top{height:69px;padding:0 35px;display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid var(--line)}.top a{color:var(--green);font-weight:650;text-decoration:none}.content{max-width:1440px;margin:auto;padding:34px}.heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:22px}.heading small{color:var(--green);font-size:11px;font-weight:800;letter-spacing:.13em}.heading h1{margin:5px 0;font-size:30px;letter-spacing:-.04em}.heading p{margin:0;color:var(--muted)}.layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(310px,.75fr);gap:17px}.card{padding:20px;border:1px solid var(--line);border-radius:15px;background:#fff;box-shadow:0 10px 28px #153f2b07}.card h2{margin:0 0 4px;font-size:18px}.card>p{margin:0 0 15px;color:var(--muted);font-size:13px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse}th{padding:11px 9px;border-bottom:1px solid var(--line);color:#81938a;text-align:left;font-size:10px;letter-spacing:.08em}td{padding:14px 9px;border-bottom:1px solid #edf2ee;vertical-align:middle;font-size:13px}td strong{display:block}.secondary{display:block;color:#809188;font-size:11px}.badge{display:inline-block;padding:4px 9px;border-radius:999px;background:#e5f5e8;color:#267450;font-size:11px;font-weight:750}.badge.suspended{background:#fff0e2;color:#98591c}.status-form button{padding:6px 9px;border:1px solid var(--line);border-radius:7px;background:#fff;color:#42685a;font:inherit;font-size:11px;cursor:pointer}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:700}.field input{min-width:0;min-height:41px;padding:8px 10px;border:1px solid #dce7e0;border-radius:8px;font:inherit;font-size:13px}.btn-primary{min-height:44px;width:100%;margin-top:13px;border:0;border-radius:9px;background:var(--green);color:#fff;font:700 14px system-ui;cursor:pointer}.alert{padding:12px 15px;border-radius:9px;margin-bottom:16px;background:#e7f6ec;color:#236848}.alert.error,.validation-summary-errors{background:#fae6e3;color:#953e36}.validation-summary-errors{padding:10px;border-radius:8px;margin-bottom:12px}.validation-summary-errors ul{margin:0;padding-left:19px}.notice{margin-top:14px;padding:11px;border-radius:8px;background:#f1f6f1;color:#687c71;font-size:12px}.logout{padding:7px 11px;border:1px solid var(--line);border-radius:8px;background:white;color:#48665a;font:inherit;font-size:12px;cursor:pointer}
@@media(max-width:1000px){.shell{grid-template-columns:68px 1fr}.side{padding:20px 10px}.brand span:last-child,.label,.side a:not(.active){font-size:0}.brand{justify-content:center}.side a{width:47px;height:42px;padding:12px 7px;overflow:hidden;white-space:nowrap}.side a.active{font-size:0}.layout{grid-template-columns:1fr}.content{padding:24px}.top{padding:0 22px}}@@media(max-width:560px){.heading{flex-direction:column}.content{padding:18px 13px}.card{padding:15px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.top{padding:0 14px}}
</style></head><body><div class="shell"><aside class="side"><div class="brand"><span class="mark">O.</span><span>OJunnySyS</span></div><p class="label">PLATAFORMA</p><a class="active" href="/platform/tenants">▣ &nbsp; Empresas</a><a href="/app">↗ &nbsp; Espacio de trabajo</a></aside><main class="main"><header class="top"><span>Administración central</span><a href="/app">Volver al sistema</a></header><div class="content"><div class="heading"><div><small>CONTROL DE LA PLATAFORMA</small><h1>Empresas y accesos</h1><p>Administra espacios aislados y sus cuentas administradoras.</p></div><span class="badge">@(Model.Count) empresas</span></div>
@if (TempData["Success"] is string success) { <div class="alert">@success</div> } @if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
<div class="layout"><section class="card"><h2>Espacios de empresa</h2><p>Estado, responsable y personas con acceso.</p><div asp-validation-summary="ModelOnly" role="alert"></div><div class="table-wrap"><table><thead><tr><th>EMPRESA</th><th>RESPONSABLE</th><th>PLAN</th><th>USUARIOS</th><th>ESTADO</th><th></th></tr></thead><tbody>@foreach (var tenant in Model) { <tr><td><strong>@tenant.Name</strong><span class="secondary">/@tenant.Slug</span></td><td>@tenant.OwnerEmail</td><td>@tenant.PlanCode</td><td>@tenant.UserCount</td><td><span class="badge @(tenant.Status == OJunnySyS.Domain.Tenancy.TenantStatus.Suspended ? "suspended" : "")">@StatusLabel(tenant.Status)</span></td><td><form class="status-form" method="post" action="/platform/tenants/@tenant.Id/status">@Html.AntiForgeryToken()<input type="hidden" name="active" value="@(tenant.Status == OJunnySyS.Domain.Tenancy.TenantStatus.Suspended ? "true" : "false")"/><button type="submit">@(tenant.Status == OJunnySyS.Domain.Tenancy.TenantStatus.Suspended ? "Activar" : "Suspender")</button></form></td></tr> }</tbody></table></div></section>
<section class="card"><h2>Crear empresa</h2><p>Se inicia con 14 días de prueba y un administrador.</p><form method="post" action="/platform/tenants">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" role="alert"></div><div class="form-grid"><div class="field full"><label for="Name">Nombre de empresa</label><input id="Name" name="Name" value="@input.Name" maxlength="160" required/></div><div class="field"><label for="Slug">Identificador</label><input id="Slug" name="Slug" value="@input.Slug" placeholder="mi-negocio" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required/></div><div class="field"><label for="CurrencyCode">Moneda</label><input id="CurrencyCode" name="CurrencyCode" value="@input.CurrencyCode" maxlength="3" required/></div><div class="field full"><label for="TimeZoneId">Zona horaria</label><input id="TimeZoneId" name="TimeZoneId" value="@input.TimeZoneId" required/></div><div class="field full"><label for="OwnerEmail">Correo responsable</label><input id="OwnerEmail" type="email" name="OwnerEmail" value="@input.OwnerEmail" required/></div><div class="field full"><label for="AdministratorName">Nombre administrador</label><input id="AdministratorName" name="AdministratorName" value="@input.AdministratorName" required/></div><div class="field full"><label for="AdministratorEmail">Correo de acceso inicial</label><input id="AdministratorEmail" type="email" name="AdministratorEmail" value="@input.AdministratorEmail" required/></div><div class="field full"><label for="InitialPassword">Contraseña temporal</label><input id="InitialPassword" type="password" name="InitialPassword" minlength="12" autocomplete="new-password" required/></div></div><button class="btn-primary" type="submit">Crear espacio de prueba</button></form><div class="notice">La contraseña temporal no se guarda en texto abierto y deberá cambiarse al iniciar sesión. Comparte las credenciales usando un canal seguro.</div></section></div></div></main></div></body></html>
