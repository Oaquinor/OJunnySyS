@model IReadOnlyList<OJunnySyS.Application.Contracts.TenantSummary>
@{
    Layout = null;
    var input = ViewData["Input"] as CreateTenantInput ?? new CreateTenantInput();
    string StatusLabel(OJunnySyS.Domain.Tenancy.TenantStatus status) => status switch { OJunnySyS.Domain.Tenancy.TenantStatus.Trial => "Prueba", OJunnySyS.Domain.Tenancy.TenantStatus.Active => "Activa", OJunnySyS.Domain.Tenancy.TenantStatus.Suspended => "Suspendida", _ => "Cerrada" };
}
<!doctype html>
<html lang="es-DO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Empresas · Administración de plataforma</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/tailwind.css" />
</head>
<body class="min-h-screen bg-canvas font-sans text-ink">
    <div class="grid min-h-screen lg:grid-cols-[15rem_minmax(0,1fr)]">
        <aside class="flex flex-col gap-6 bg-[#12322e] p-5 text-emerald-50 sm:p-6">
            <div class="flex items-center gap-3 font-display text-lg font-extrabold"><span class="grid size-10 place-items-center rounded-xl bg-lime-200 text-emerald-950">O.</span>OJunnySyS</div>
            <nav class="grid gap-2" aria-label="Administración de plataforma">
                <span class="px-3 text-xs font-bold tracking-widest text-emerald-200">PLATAFORMA</span>
                <a class="rounded-xl bg-lime-200 px-3 py-2.5 text-sm font-bold text-emerald-950" href="/platform/tenants">▣ &nbsp; Empresas</a>
                <a class="rounded-xl px-3 py-2.5 text-sm text-emerald-100 hover:bg-white/10" href="/app">↗ &nbsp; Espacio de trabajo</a>
            </nav>
        </aside>
        <main class="min-w-0">
            <header class="flex min-h-16 items-center justify-between gap-4 border-b border-line bg-white px-4 sm:px-7">
                <span class="text-sm font-semibold">Administración central</span>
                <a class="text-sm font-semibold text-brand-600 hover:underline" href="/app">Volver al sistema</a>
            </header>
            <div class="mx-auto grid w-full max-w-[98rem] gap-5 p-4 sm:p-7">
                <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                    <div><span class="text-xs font-bold tracking-widest text-brand-600">CONTROL DE LA PLATAFORMA</span><h1 class="mt-1 font-display text-3xl font-bold tracking-tight">Empresas y accesos</h1><p class="mt-1 text-sm text-slate-600">Administra espacios aislados y sus cuentas administradoras.</p></div>
                    <span class="w-fit rounded-full bg-brand-50 px-3 py-1.5 text-sm font-bold text-brand-700">@(Model.Count) empresas</span>
                </div>
                @if (TempData["Success"] is string success) { <div role="status" class="rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@success</div> }
                @if (TempData["Error"] is string error) { <div role="alert" class="rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-800">@error</div> }
                <div class="grid items-start gap-4 xl:grid-cols-[minmax(0,1.45fr)_minmax(20rem,.75fr)]">
                    <section class="min-w-0 rounded-2xl border border-line bg-white p-4 shadow-sm sm:p-5">
                        <h2 class="font-display text-lg font-bold">Espacios de empresa</h2><p class="mb-4 mt-1 text-sm text-slate-600">Estado, responsable y personas con acceso.</p>
                        <div asp-validation-summary="ModelOnly" role="alert" class="mb-3 rounded-xl bg-rose-50 p-3 text-sm text-rose-800"></div>
                        <div class="overflow-x-auto"><table class="w-full min-w-[42rem] border-collapse text-left text-sm"><thead><tr class="border-b border-line text-xs font-bold tracking-wide text-slate-500"><th class="p-3">EMPRESA</th><th class="p-3">RESPONSABLE</th><th class="p-3">PLAN</th><th class="p-3">USUARIOS</th><th class="p-3">ESTADO</th><th class="p-3"></th></tr></thead><tbody>
                            @foreach (var tenant in Model)
                            {
                                <tr class="border-b border-slate-100 last:border-0"><td class="p-3"><strong class="block font-semibold">@tenant.Name</strong><span class="text-xs text-slate-500">/@tenant.Slug</span></td><td class="p-3">@tenant.OwnerEmail</td><td class="p-3">@tenant.PlanCode</td><td class="p-3">@tenant.UserCount</td><td class="p-3"><span class="rounded-full px-2.5 py-1 text-xs font-bold @(tenant.Status == OJunnySyS.Domain.Tenancy.TenantStatus.Suspended ? "bg-amber-50 text-amber-800" : "bg-emerald-50 text-emerald-800")">@StatusLabel(tenant.Status)</span></td><td class="p-3"><form method="post" action="/platform/tenants/@tenant.Id/status" class="m-0">@Html.AntiForgeryToken()<input type="hidden" name="active" value="@(tenant.Status == OJunnySyS.Domain.Tenancy.TenantStatus.Suspended ? "true" : "false")"/><button class="rounded-lg border border-line px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50" type="submit">@(tenant.Status == OJunnySyS.Domain.Tenancy.TenantStatus.Suspended ? "Activar" : "Suspender")</button></form></td></tr>
                            }
                        </tbody></table></div>
                    </section>
                    <section class="rounded-2xl border border-line bg-white p-4 shadow-sm sm:p-5">
                        <h2 class="font-display text-lg font-bold">Crear empresa</h2><p class="mb-4 mt-1 text-sm text-slate-600">Se inicia con 14 días de prueba y un administrador.</p>
                        <form method="post" action="/platform/tenants" class="grid grid-cols-1 gap-3 sm:grid-cols-2">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" role="alert" class="sm:col-span-2 rounded-xl bg-rose-50 p-3 text-sm text-rose-800"></div>
                            <div class="grid gap-1.5 sm:col-span-2"><label for="Name" class="text-sm font-semibold">Nombre de empresa</label><input id="Name" name="Name" value="@input.Name" maxlength="160" required /></div>
                            <div class="grid gap-1.5"><label for="Slug" class="text-sm font-semibold">Identificador</label><input id="Slug" name="Slug" value="@input.Slug" placeholder="mi-negocio" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required /></div>
                            <div class="grid gap-1.5"><label for="CurrencyCode" class="text-sm font-semibold">Moneda</label><input id="CurrencyCode" name="CurrencyCode" value="@input.CurrencyCode" maxlength="3" required /></div>
                            <div class="grid gap-1.5 sm:col-span-2"><label for="TimeZoneId" class="text-sm font-semibold">Zona horaria</label><input id="TimeZoneId" name="TimeZoneId" value="@input.TimeZoneId" required /></div>
                            <div class="grid gap-1.5 sm:col-span-2"><label for="OwnerEmail" class="text-sm font-semibold">Correo responsable</label><input id="OwnerEmail" type="email" name="OwnerEmail" value="@input.OwnerEmail" required /></div>
                            <div class="grid gap-1.5 sm:col-span-2"><label for="AdministratorName" class="text-sm font-semibold">Nombre administrador</label><input id="AdministratorName" name="AdministratorName" value="@input.AdministratorName" required /></div>
                            <div class="grid gap-1.5 sm:col-span-2"><label for="AdministratorEmail" class="text-sm font-semibold">Correo de acceso inicial</label><input id="AdministratorEmail" type="email" name="AdministratorEmail" value="@input.AdministratorEmail" required /></div>
                            <div class="grid gap-1.5 sm:col-span-2"><label for="InitialPassword" class="text-sm font-semibold">Contraseña temporal</label><input id="InitialPassword" type="password" name="InitialPassword" minlength="12" autocomplete="new-password" required /></div>
                            <button class="sm:col-span-2 mt-1 min-h-12 rounded-xl bg-brand-600 px-4 text-sm font-bold text-white transition hover:bg-brand-700" type="submit">Crear espacio de prueba</button>
                        </form>
                        <p class="mb-0 mt-4 rounded-xl bg-slate-50 p-3 text-xs leading-5 text-slate-600">La contraseña temporal no se guarda en texto abierto y deberá cambiarse al iniciar sesión. Comparte las credenciales usando un canal seguro.</p>
                    </section>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
