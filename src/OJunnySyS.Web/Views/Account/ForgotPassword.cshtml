@model ForgotPasswordInput
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Recuperar contraseña · OJunnySyS";
}

@await Html.PartialAsync("_AccountBrand")
<h1 class="font-display text-2xl font-bold tracking-tight text-ink">Recupera tu acceso</h1>
<p class="mb-6 mt-1 text-sm text-slate-600">Te enviaremos un enlace seguro si encontramos una cuenta confirmada con ese correo.</p>
<form method="post" action="/account/forgot-password" class="grid gap-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" role="alert" class="rounded-xl bg-rose-50 p-3 text-sm text-rose-800"></div>
    <div class="grid gap-1.5">
        <label asp-for="Email" class="text-sm font-semibold text-slate-700">Correo electrónico</label>
        <input asp-for="Email" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="text-xs text-rose-700"></span>
    </div>
    <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand-600 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700">Enviar instrucciones</button>
</form>
<p class="mt-5 text-center text-sm"><a class="font-semibold text-brand-600 hover:underline" href="/account/login">Volver a iniciar sesión</a></p>
