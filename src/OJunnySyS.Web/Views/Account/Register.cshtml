@model RegisterInput
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Crea el espacio de tu empresa · OJunnySyS";
}

@await Html.PartialAsync("_AccountBrand")
<h1 class="font-display text-2xl font-bold tracking-tight text-ink">Crea el espacio de tu empresa</h1>
<p class="mb-6 mt-1 text-sm text-slate-600">Empieza tu prueba y configura después a tu equipo, productos e impuestos.</p>
<form method="post" action="/account/register" autocomplete="on" class="grid gap-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" role="alert" class="rounded-xl bg-rose-50 p-3 text-sm text-rose-800"></div>
    <div class="grid gap-1.5"><label asp-for="CompanyName" class="text-sm font-semibold text-slate-700">Nombre de la empresa</label><input asp-for="CompanyName" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="organization" maxlength="160" autofocus /><span asp-validation-for="CompanyName" class="text-xs text-rose-700"></span></div>
    <div class="grid gap-1.5"><label asp-for="OwnerName" class="text-sm font-semibold text-slate-700">Nombre del responsable</label><input asp-for="OwnerName" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="name" maxlength="160" /><span asp-validation-for="OwnerName" class="text-xs text-rose-700"></span></div>
    <div class="grid gap-1.5"><label asp-for="Email" class="text-sm font-semibold text-slate-700">Correo electrónico</label><input asp-for="Email" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="email" maxlength="254" /><span asp-validation-for="Email" class="text-xs text-rose-700"></span></div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="grid gap-1.5"><label asp-for="CurrencyCode" class="text-sm font-semibold text-slate-700">Moneda principal</label><select asp-for="CurrencyCode" class="min-h-12 rounded-xl border border-slate-200 bg-white px-3 text-sm"><option value="DOP">DOP · Peso dominicano</option><option value="USD">USD · Dólar estadounidense</option></select></div>
        <div class="grid gap-1.5"><label asp-for="TimeZoneId" class="text-sm font-semibold text-slate-700">Zona horaria</label><select asp-for="TimeZoneId" class="min-h-12 rounded-xl border border-slate-200 bg-white px-3 text-sm"><option value="America/Santo_Domingo">Santo Domingo</option></select></div>
    </div>
    <div class="grid gap-1.5"><label asp-for="Password" class="text-sm font-semibold text-slate-700">Contraseña</label><input asp-for="Password" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="new-password" /><small class="text-xs text-slate-500">Mínimo 12 caracteres, con mayúscula, minúscula, número y símbolo.</small><span asp-validation-for="Password" class="text-xs text-rose-700"></span></div>
    <div class="grid gap-1.5"><label asp-for="ConfirmPassword" class="text-sm font-semibold text-slate-700">Confirma la contraseña</label><input asp-for="ConfirmPassword" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-xs text-rose-700"></span></div>
    <button type="submit" class="mt-1 inline-flex min-h-12 items-center justify-center rounded-xl bg-brand-600 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">Crear espacio de prueba</button>
</form>
<div class="mt-5 flex flex-col justify-between gap-2 text-sm sm:flex-row"><a class="font-semibold text-brand-600 hover:underline" href="/">Volver al sitio</a><span class="text-slate-600">¿Ya tienes espacio? <a class="font-semibold text-brand-600 hover:underline" href="/account/login">Inicia sesión</a></span></div>
