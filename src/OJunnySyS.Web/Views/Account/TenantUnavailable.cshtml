@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Acceso no disponible · OJunnySyS";
}

<div class="grid size-12 place-items-center rounded-2xl bg-brand-100 font-display text-2xl font-extrabold text-brand-700">O<span>.</span></div>
<span class="mt-7 block text-xs font-bold tracking-[0.14em] text-brand-600">ESPACIO DE TRABAJO</span>
<h1 class="mt-2 font-display text-2xl font-bold tracking-tight text-ink">Este espacio no está disponible</h1>
<p class="mb-6 mt-2 text-sm leading-6 text-slate-600">El acceso de la empresa o de esta cuenta está suspendido, vencido o desactivado. Contacta a la persona administradora o al equipo de OJunnySyS para continuar.</p>
<form method="post" action="/account/logout">
    @Html.AntiForgeryToken()
    <button class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-brand-600 px-5 text-sm font-bold text-white transition hover:bg-brand-700" type="submit">Cerrar sesión</button>
</form>
