@model ChangePasswordInput
@{
    Layout = null;
    ViewData["Title"] = "Cambia tu contraseña · OJunnySyS";
}
<!doctype html>
<html lang="es-DO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body{min-height:100vh;margin:0;display:grid;place-items:center;padding:20px;background:#f3f6f2;color:#132b27;font:16px/1.5 system-ui,sans-serif}main{width:min(100%,480px);padding:36px;background:white;border:1px solid #dce7e0;border-radius:18px;box-shadow:0 24px 70px #102b2913}h1{font-size:26px;font-weight:750;letter-spacing:-.04em}.intro{color:#698079}label{font-weight:650}.form-control{min-height:46px}.btn-primary{min-height:47px;width:100%;border-color:#19815e;background:#19815e;font-weight:700}.validation-summary-errors{margin-bottom:15px;padding:12px;color:#842029;background:#f8d7da;border-radius:8px}
    </style>
</head>
<body><main><h1>Crea tu nueva contraseña</h1><p class="intro">Para proteger tu cuenta, cambia la contraseña temporal antes de continuar.</p><form method="post" action="/account/change-password">
    @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="mb-3"><label asp-for="CurrentPassword">Contraseña temporal</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /></div>
    <div class="mb-3"><label asp-for="NewPassword">Nueva contraseña</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><small class="text-muted">Al menos 12 caracteres, con mayúscula, minúscula, número y símbolo.</small></div>
    <div class="mb-3"><label asp-for="ConfirmPassword">Repite la nueva contraseña</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
    <button class="btn btn-primary" type="submit">Guardar contraseña</button>
</form></main></body></html>
