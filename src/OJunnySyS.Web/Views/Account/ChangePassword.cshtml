@model ChangePasswordInput
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Cambia tu contraseña · OJunnySyS";
}

@await Html.PartialAsync("_AccountBrand")
<h1 class="font-display text-2xl font-bold tracking-tight text-ink">Crea tu nueva contraseña</h1>
<p class="mb-6 mt-1 text-sm text-slate-600">Para proteger tu cuenta, cambia la contraseña temporal antes de continuar.</p>
<form method="post" action="/account/change-password" class="grid gap-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" role="alert" class="rounded-xl bg-rose-50 p-3 text-sm text-rose-800"></div>
    <div class="grid gap-1.5"><label asp-for="CurrentPassword" class="text-sm font-semibold text-slate-700">Contraseña temporal</label><input asp-for="CurrentPassword" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="current-password" /></div>
    <div class="grid gap-1.5"><label asp-for="NewPassword" class="text-sm font-semibold text-slate-700">Nueva contraseña</label><input asp-for="NewPassword" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="new-password" /><small class="text-xs text-slate-500">Al menos 12 caracteres, con mayúscula, minúscula, número y símbolo.</small></div>
    <div class="grid gap-1.5"><label asp-for="ConfirmPassword" class="text-sm font-semibold text-slate-700">Repite la nueva contraseña</label><input asp-for="ConfirmPassword" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="new-password" /></div>
    <button class="mt-1 inline-flex min-h-12 items-center justify-center rounded-xl bg-brand-600 px-5 text-sm font-bold text-white transition hover:bg-brand-700" type="submit">Guardar contraseña</button>
</form>
