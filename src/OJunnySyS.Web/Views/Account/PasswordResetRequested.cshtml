@model PasswordResetRequestedViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Revisa tu correo · OJunnySyS";
}

@await Html.PartialAsync("_AccountBrand")
<h1 class="font-display text-2xl font-bold tracking-tight text-ink">Revisa tu correo</h1>
<p class="mt-2 text-sm leading-6 text-slate-600">@Model.Message</p>
@if (!string.IsNullOrWhiteSpace(Model.LocalResetUrl))
{
    <div class="mt-5 grid gap-2 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
        <strong>Enlace local de desarrollo</strong>
        <a class="break-all font-semibold underline" href="@Model.LocalResetUrl">Restablecer contraseña</a>
    </div>
}
<p class="mt-6 text-center text-sm"><a class="font-semibold text-brand-600 hover:underline" href="/account/login">Volver a iniciar sesión</a></p>
