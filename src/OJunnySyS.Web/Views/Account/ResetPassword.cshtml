@model ResetPasswordInput
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Nueva contraseña · OJunnySyS";
}

@await Html.PartialAsync("_AccountBrand")
<h1 class="font-display text-2xl font-bold tracking-tight text-ink">Crea una contraseña nueva</h1>
<p class="mb-6 mt-1 text-sm text-slate-600">Usa al menos 12 caracteres y una contraseña que no hayas utilizado antes.</p>
<form method="post" action="@(Model.IsInvitation ? "/account/accept-invitation" : "/account/reset-password")" class="grid gap-4">
    @Html.AntiForgeryToken()
    <input asp-for="UserId" type="hidden" />
    <input asp-for="Token" type="hidden" />
    <input asp-for="IsInvitation" type="hidden" />
    <div asp-validation-summary="ModelOnly" role="alert" class="rounded-xl bg-rose-50 p-3 text-sm text-rose-800"></div>
    <div class="grid gap-1.5">
        <label asp-for="Password" class="text-sm font-semibold text-slate-700">Nueva contraseña</label>
        <input asp-for="Password" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="new-password" autofocus />
        <span asp-validation-for="Password" class="text-xs text-rose-700"></span>
    </div>
    <div class="grid gap-1.5">
        <label asp-for="ConfirmPassword" class="text-sm font-semibold text-slate-700">Confirma la contraseña</label>
        <input asp-for="ConfirmPassword" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-700"></span>
    </div>
    <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand-600 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700">Guardar contraseña</button>
</form>
