@model EmailConfirmationViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Confirmación de correo · OJunnySyS";
}

@await Html.PartialAsync("_AccountBrand")
<div class="mb-4 grid size-12 place-items-center rounded-full @(Model.Confirmed ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700")" aria-hidden="true">@(Model.Confirmed ? "✓" : "!")</div>
<h1 class="font-display text-2xl font-bold tracking-tight text-ink">@(Model.Confirmed ? "Correo confirmado" : "No se pudo confirmar")</h1>
<p class="mb-6 mt-2 text-sm leading-6 text-slate-600">@Model.Message</p>
@if (Model.Confirmed)
{
    <a class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-brand-600 px-5 text-sm font-bold text-white transition hover:bg-brand-700" href="/account/login">Iniciar sesión</a>
}
else
{
    <a class="font-semibold text-brand-600 hover:underline" href="/account/resend-confirmation">Solicitar otro enlace</a>
}
