@model OJunnySyS.Application.Contracts.RegistrationSubmittedViewModel
@{
    Layout = null;
    ViewData["Title"] = "Confirma tu correo · OJunnySyS";
}
<!DOCTYPE html>
<html lang="es"><head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" /><title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>body{min-height:100vh;margin:0;display:grid;place-items:center;background:#f4f7f5;color:#18251f;font:16px/1.55 system-ui,sans-serif}main{width:min(100% - 32px,520px);padding:38px;background:white;border:1px solid #e3e9e5;border-radius:18px;box-shadow:0 20px 70px #183d2a12}.mark{width:48px;height:48px;display:grid;place-items:center;background:#236c4d;color:white;border-radius:14px;font-weight:750;font-size:23px}.brand{display:flex;align-items:center;gap:12px;margin-bottom:30px}.brand strong,.brand small{display:block}.brand small{color:#6e7b73;font-size:12px;letter-spacing:.1em}h1{font-size:27px}.muted{color:#6e7b73}.dev-link{overflow-wrap:anywhere}a{color:#236c4d}</style>
</head><body><main>
    <div class="brand"><div class="mark">O.</div><div><strong>OJunnySyS</strong><small>GESTIÓN COMERCIAL</small></div></div>
    <h1>Revisa tu correo</h1>
    @if (!string.IsNullOrWhiteSpace(Model.CompanyName)) { <p class="muted">Espacio de empresa: <strong>@Model.CompanyName</strong></p> }
    <p>@Model.Message</p>
    @if (!string.IsNullOrWhiteSpace(Model.DevelopmentConfirmationUrl)) { <p class="dev-link"><a href="@Model.DevelopmentConfirmationUrl">Confirmar correo en este entorno local</a></p> }
    <p class="muted">Si necesitas otro enlace, puedes <a href="/account/resend-confirmation">solicitar una nueva confirmación</a>.</p>
    <a href="/">Volver a OJunnySyS</a>
</main></body></html>
