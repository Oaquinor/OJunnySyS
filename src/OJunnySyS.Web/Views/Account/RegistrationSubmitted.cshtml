@model OJunnySyS.Application.Contracts.RegistrationSubmittedViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Confirma tu correo · OJunnySyS";
}

@await Html.PartialAsync("_AccountBrand")
<div class="mb-4 grid size-12 place-items-center rounded-full bg-brand-50 text-xl font-bold text-brand-600" aria-hidden="true">✉</div>
<h1 class="font-display text-2xl font-bold tracking-tight text-ink">Revisa tu correo</h1>
@if (!string.IsNullOrWhiteSpace(Model.CompanyName))
{
    <p class="mt-2 text-sm text-slate-600">Espacio de empresa: <strong class="text-ink">@Model.CompanyName</strong></p>
}
<p class="mt-3 text-sm leading-6 text-slate-600">@Model.Message</p>
@if (!string.IsNullOrWhiteSpace(Model.DevelopmentConfirmationUrl))
{
    <p class="mt-4 break-all text-sm"><a class="font-semibold text-brand-600 hover:underline" href="@Model.DevelopmentConfirmationUrl">Confirmar correo en este entorno local</a></p>
}
<p class="mt-4 text-sm leading-6 text-slate-600">Si necesitas otro enlace, puedes <a class="font-semibold text-brand-600 hover:underline" href="/account/resend-confirmation">solicitar una nueva confirmación</a>.</p>
<a class="mt-5 inline-block text-sm font-semibold text-brand-600 hover:underline" href="/">Volver a OJunnySyS</a>
