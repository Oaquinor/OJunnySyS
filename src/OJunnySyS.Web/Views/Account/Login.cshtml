@model LoginInput
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Iniciar sesión · OJunnySyS";
}

@await Html.PartialAsync("_AccountBrand")
<h1 class="font-display text-2xl font-bold tracking-tight text-ink">Bienvenido</h1>
<p class="mb-6 mt-1 text-sm text-slate-600">Inicia sesión para abrir tu espacio de trabajo.</p>
<form method="post" action="/account/login" class="grid gap-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" role="alert" class="rounded-xl bg-rose-50 p-3 text-sm text-rose-800"></div>
    <div class="grid gap-1.5">
        <label asp-for="Email" class="text-sm font-semibold text-slate-700">Correo electrónico</label>
        <input asp-for="Email" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="text-xs text-rose-700"></span>
    </div>
    <div class="grid gap-1.5">
        <label asp-for="Password" class="text-sm font-semibold text-slate-700">Contraseña</label>
        <input asp-for="Password" class="w-full rounded-xl border border-slate-200 px-3 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-xs text-rose-700"></span>
    </div>
    <a class="justify-self-end text-sm font-semibold text-brand-600 hover:underline" href="/account/forgot-password">¿Olvidaste tu contraseña?</a>
    <label class="flex items-center gap-2 text-sm text-slate-600"><input asp-for="RememberMe" class="size-4 accent-brand-600" />Mantener sesión iniciada</label>
    <button type="submit" class="mt-1 inline-flex min-h-12 items-center justify-center rounded-xl bg-brand-600 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">Iniciar sesión</button>
</form>
<p class="mt-6 text-center text-sm text-slate-600">¿Aún no tienes espacio? <a class="font-semibold text-brand-600 hover:underline" href="/account/register">Crea tu empresa de prueba</a></p>
<p class="mb-0 text-center text-sm"><a class="font-semibold text-brand-600 hover:underline" href="/account/resend-confirmation">Reenviar confirmación de correo</a></p>
