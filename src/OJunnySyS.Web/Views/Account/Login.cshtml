@model LoginInput
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión · OJunnySyS";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root { color-scheme: light; --ink: #18251f; --muted: #6e7b73; --green: #236c4d; --line: #e3e9e5; }
        body { min-height: 100vh; margin: 0; display: grid; place-items: center; background: #f4f7f5; color: var(--ink); font: 16px/1.5 system-ui, sans-serif; }
        main { width: min(100% - 32px, 440px); padding: 40px; background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 20px 70px #183d2a12; }
        .brand { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; }
        .mark { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 14px; background: var(--green); color: white; font-size: 25px; font-weight: 750; }
        .brand strong { display: block; font-size: 19px; letter-spacing: .01em; }.brand small { color: var(--muted); font-size: 12px; letter-spacing: .1em; }
        h1 { margin: 0 0 6px; font-size: 26px; }.intro { margin: 0 0 26px; color: var(--muted); }
        label { display: block; margin-bottom: 7px; font-weight: 600; }.form-control { min-height: 48px; border-color: var(--line); }
        .btn-primary { width: 100%; min-height: 48px; margin-top: 10px; border-color: var(--green); background: var(--green); font-weight: 650; }
        .validation-summary-errors { margin-bottom: 16px; padding: 12px 14px; color: #842029; background: #f8d7da; border-radius: 8px; }
        .validation-summary-errors ul { margin: 0; padding-left: 20px; }
        @@media (max-width: 480px) { main { padding: 28px 22px; } }
    </style>
</head>
<body>
    <main>
        <div class="brand"><div class="mark">O.</div><div><strong>OJunnySyS</strong><small>GESTIÓN COMERCIAL</small></div></div>
        <h1>Bienvenido</h1>
        <p class="intro">Inicia sesión para abrir tu espacio de trabajo.</p>
        <form method="post" action="/account/login">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="mb-3"><label asp-for="Email">Correo electrónico</label><input asp-for="Email" class="form-control" autocomplete="username" autofocus /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password">Contraseña</label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Mantener sesión iniciada</label></div>
            <button type="submit" class="btn btn-primary">Iniciar sesión</button>
        </form>
    </main>
</body>
</html>
