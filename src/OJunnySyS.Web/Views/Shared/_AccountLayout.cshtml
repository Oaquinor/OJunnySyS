<!doctype html>
<html lang="es-DO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#176c4a" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/tailwind.css" />
</head>
<body class="grid min-h-screen place-items-center bg-canvas px-4 py-8 font-sans text-ink antialiased">
    <main class="w-full max-w-lg rounded-2xl border border-line bg-white p-6 shadow-xl sm:p-9">
        @RenderBody()
    </main>
</body>
</html>
