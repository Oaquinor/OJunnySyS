@page "/app/settings"
@attribute [Authorize(Roles = "Administrator")]
@inject TenantSettingsService TenantConfig
@inject ILogger<Settings> Logger

<PageTitle>Empresa e impuestos · OJunnySyS</PageTitle>
<PageHeader Eyebrow="CONFIGURACIÓN" Title="Empresa y POS" Description="Configura datos fiscales, terminales y la impresión de tus comprobantes."><Actions><a class="button button-secondary" href="/app/settings/taxes">Administrar perfiles de impuesto</a></Actions></PageHeader>

@if (_loading)
{
    <div class="loading-panel">Cargando la configuración de tu empresa…</div>
}
else if (_model is not null)
{
    <section class="panel settings-panel">
        <div class="panel-heading"><div><h2>@_model.Name</h2><p>Espacio <span class="mono">@_model.Slug</span></p></div></div>
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="settings-form">
            <DataAnnotationsValidator />
            <div class="form-grid settings-base-grid">
                <label>Moneda (código ISO)<InputText @bind-Value="_model.CurrencyCode" maxlength="3" /></label>
                <label>Tasa general de impuesto (%)<NumericInput @bind-Value="_model.TaxPercent" min="0" max="100" step="0.01" /></label>
            </div>
            <h2 class="settings-section-title">Identidad y formato del recibo</h2>
            <div class="form-grid">
                <label>Nombre legal<InputText @bind-Value="_model.LegalName" maxlength="160" /></label>
                <label>RNC / identificación fiscal<InputText @bind-Value="_model.TaxIdentifier" maxlength="40" /></label>
                <label>Teléfono<InputText @bind-Value="_model.BusinessPhone" maxlength="40" /></label>
                <label>Dirección<InputText @bind-Value="_model.BusinessAddress" maxlength="240" /></label>
                <label>Encabezado<InputText @bind-Value="_model.ReceiptHeader" maxlength="240" /></label>
                <label>Mensaje al pie<InputText @bind-Value="_model.ReceiptFooter" maxlength="240" /></label>
                <label>Ancho de papel<InputSelect @bind-Value="_model.ReceiptPaperWidthMm"><option value="58">58 mm · compacto</option><option value="80">80 mm · estándar</option><option value="210">210 mm · A4</option></InputSelect></label>
            </div>
            <h2 class="settings-section-title">Diseñador de impresión</h2>
            <div class="form-grid">
                <label>Diseño<InputSelect @bind-Value="_model.ReceiptDesign"><option value="classic">Clásico</option><option value="minimal">Minimalista</option><option value="detailed">Detallado</option></InputSelect></label>
                <label>Tipografía<InputSelect @bind-Value="_model.ReceiptFontFamily"><option value="classic">Clásica · monoespaciada</option><option value="modern">Moderna</option><option value="compact">Compacta</option></InputSelect></label>
                <label>Tamaño de letra<InputSelect @bind-Value="_model.ReceiptFontSize"><option value="11">Pequeña</option><option value="12">Mediana</option><option value="13">Grande</option></InputSelect></label>
                <label>Margen izquierdo (mm)<NumericInput @bind-Value="_model.ReceiptMarginLeftMm" min="0" max="10" /></label>
                <label>Margen derecho (mm)<NumericInput @bind-Value="_model.ReceiptMarginRightMm" min="0" max="10" /></label>
            </div>
            <div class="receipt-options">
                <label><InputCheckbox @bind-Value="_model.ReceiptCompactLineSpacing" /> Interlineado reducido</label>
                <label><InputCheckbox @bind-Value="_model.ReceiptShowCustomer" /> Mostrar cliente</label>
                <label><InputCheckbox @bind-Value="_model.ReceiptShowSku" /> Mostrar referencia/SKU</label>
                <label><InputCheckbox @bind-Value="_model.ReceiptShowUnitPrice" /> Mostrar precio unitario</label>
                <label><InputCheckbox @bind-Value="_model.ReceiptShowLineTotals" /> Mostrar importe por artículo</label>
                <label><InputCheckbox @bind-Value="_model.ReceiptShowTax" /> Mostrar impuestos</label>
            </div>
            <p class="muted-foot">Esta tasa se calcula en el servidor y queda guardada en cada venta como snapshot. Configura el porcentaje que corresponda a tu negocio; los comprobantes fiscales oficiales requieren una integración DGII aparte.</p>
            <ValidationSummary />
            @if (_error is not null) { <div class="inline-error">@_error</div> }
            @if (_notice is not null) { <div class="toast">✓ @_notice</div> }
            <div class="modal-actions"><button class="button button-primary" type="submit" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar configuración")</button></div>
        </EditForm>
    </section>
}
else
{
    <div class="inline-error">No se pudo cargar la configuración de la empresa.</div>
}

@code {
    private SettingsForm? _model;
    private bool _loading = true, _saving;
    private string? _error, _notice;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await TenantConfig.GetAsync();
            _model = new SettingsForm { Name = settings.Name, Slug = settings.Slug, TimeZoneId = settings.TimeZoneId,
                CurrencyCode = settings.CurrencyCode, TaxPercent = settings.DefaultTaxRate * 100m, LegalName = settings.LegalName,
                TaxIdentifier = settings.TaxIdentifier, BusinessPhone = settings.BusinessPhone, BusinessAddress = settings.BusinessAddress,
                ReceiptHeader = settings.ReceiptHeader, ReceiptFooter = settings.ReceiptFooter, ReceiptPaperWidthMm = settings.ReceiptPaperWidthMm,
                ReceiptShowCustomer = settings.ReceiptShowCustomer, ReceiptShowSku = settings.ReceiptShowSku, ReceiptShowTax = settings.ReceiptShowTax,
                ReceiptDesign = settings.ReceiptDesign, ReceiptCompactLineSpacing = settings.ReceiptCompactLineSpacing,
                ReceiptFontFamily = settings.ReceiptFontFamily, ReceiptFontSize = settings.ReceiptFontSize,
                ReceiptMarginLeftMm = settings.ReceiptMarginLeftMm, ReceiptMarginRightMm = settings.ReceiptMarginRightMm,
                ReceiptShowUnitPrice = settings.ReceiptShowUnitPrice, ReceiptShowLineTotals = settings.ReceiptShowLineTotals };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo cargar la configuración de empresa.");
            _error = "No se pudo cargar la configuración. Recarga la página e inténtalo de nuevo.";
        }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        _saving = true; _error = null; _notice = null;
        try
        {
            var result = await TenantConfig.UpdateAsync(new UpdateTenantBusinessSettingsRequest(_model.TimeZoneId,
                _model.CurrencyCode, _model.TaxPercent / 100m, _model.LegalName, _model.TaxIdentifier, _model.BusinessPhone,
                _model.BusinessAddress, _model.ReceiptHeader, _model.ReceiptFooter, _model.ReceiptPaperWidthMm,
                _model.ReceiptShowCustomer, _model.ReceiptShowSku, _model.ReceiptShowTax, _model.ReceiptDesign,
                _model.ReceiptCompactLineSpacing, _model.ReceiptFontFamily, _model.ReceiptFontSize,
                _model.ReceiptMarginLeftMm, _model.ReceiptMarginRightMm, _model.ReceiptShowUnitPrice, _model.ReceiptShowLineTotals));
            _model.CurrencyCode = result.CurrencyCode;
            _notice = "La configuración se guardó correctamente.";
        }
        catch (DomainException ex) { _error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo actualizar la configuración de empresa.");
            _error = "No se pudo guardar la configuración. Inténtalo de nuevo.";
        }
        finally { _saving = false; }
    }

    private sealed class SettingsForm
    {
        public string Name { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        [Required, StringLength(100)] public string TimeZoneId { get; set; } = "America/Santo_Domingo";
        [Required, RegularExpression("^[A-Za-z]{3}$", ErrorMessage = "Usa un código de moneda de tres letras.")] public string CurrencyCode { get; set; } = "DOP";
        [Range(typeof(decimal), "0", "100", ErrorMessage = "La tasa debe estar entre 0 y 100 por ciento.")] public decimal TaxPercent { get; set; } = 18m;
        [StringLength(160)] public string LegalName { get; set; } = string.Empty;
        [StringLength(40)] public string TaxIdentifier { get; set; } = string.Empty;
        [StringLength(40)] public string BusinessPhone { get; set; } = string.Empty;
        [StringLength(240)] public string BusinessAddress { get; set; } = string.Empty;
        [StringLength(240)] public string ReceiptHeader { get; set; } = string.Empty;
        [StringLength(240)] public string ReceiptFooter { get; set; } = "Gracias por su compra.";
        [Range(58, 210)] public int ReceiptPaperWidthMm { get; set; } = 80;
        public bool ReceiptShowCustomer { get; set; } = true;
        public bool ReceiptShowSku { get; set; } = true;
        public bool ReceiptShowTax { get; set; } = true;
        [Required] public string ReceiptDesign { get; set; } = "classic";
        public bool ReceiptCompactLineSpacing { get; set; }
        [Required] public string ReceiptFontFamily { get; set; } = "modern";
        [Range(11, 13)] public int ReceiptFontSize { get; set; } = 12;
        [Range(0, 10)] public int ReceiptMarginLeftMm { get; set; }
        [Range(0, 10)] public int ReceiptMarginRightMm { get; set; }
        public bool ReceiptShowUnitPrice { get; set; } = true;
        public bool ReceiptShowLineTotals { get; set; } = true;
    }
}
