@page "/app/settings"
@attribute [Authorize(Roles = "Administrator")]
@inject TenantSettingsService TenantConfig
@inject ILogger<Settings> Logger

<PageTitle>Empresa e impuestos · OJunnySyS</PageTitle>
<PageHeader Eyebrow="CONFIGURACIÓN" Title="Empresa e impuestos" Description="Define la zona horaria, moneda y tasa general que usa el punto de venta." />

@if (_loading)
{
    <div class="loading-panel">Cargando la configuración de tu empresa…</div>
}
else if (_model is not null)
{
    <section class="panel settings-panel">
        <div class="panel-heading"><div><h2>@_model.Name</h2><p>Espacio <span class="mono">@_model.Slug</span></p></div></div>
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label>Zona horaria<InputText @bind-Value="_model.TimeZoneId" placeholder="America/Santo_Domingo" /></label>
                <label>Moneda (código ISO)<InputText @bind-Value="_model.CurrencyCode" maxlength="3" /></label>
                <label>Tasa general de impuesto (%)<InputNumber @bind-Value="_model.TaxPercent" min="0" max="100" step="0.01" /></label>
            </div>
            <p class="muted-foot">Esta tasa se calcula en el servidor y queda guardada en cada venta como snapshot. Configura el porcentaje que corresponda a tu negocio; los comprobantes fiscales oficiales requieren una integración DGII aparte.</p>
            <ValidationSummary />
            @if (_error is not null) { <div class="inline-error">@_error</div> }
            @if (_notice is not null) { <div class="toast">✓ @_notice</div> }
            <div class="modal-actions"><button class="button button-primary" type="submit" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar configuración")</button></div>
        </EditForm>
    </section>
}
else
{
    <div class="inline-error">No se pudo cargar la configuración de la empresa.</div>
}

@code {
    private SettingsForm? _model;
    private bool _loading = true, _saving;
    private string? _error, _notice;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await TenantConfig.GetAsync();
            _model = new SettingsForm { Name = settings.Name, Slug = settings.Slug, TimeZoneId = settings.TimeZoneId,
                CurrencyCode = settings.CurrencyCode, TaxPercent = settings.DefaultTaxRate * 100m };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo cargar la configuración de empresa.");
            _error = "No se pudo cargar la configuración. Recarga la página e inténtalo de nuevo.";
        }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        _saving = true; _error = null; _notice = null;
        try
        {
            var result = await TenantConfig.UpdateAsync(new UpdateTenantBusinessSettingsRequest(_model.TimeZoneId,
                _model.CurrencyCode, _model.TaxPercent / 100m));
            _model.CurrencyCode = result.CurrencyCode;
            _notice = "La configuración se guardó correctamente.";
        }
        catch (DomainException ex) { _error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo actualizar la configuración de empresa.");
            _error = "No se pudo guardar la configuración. Inténtalo de nuevo.";
        }
        finally { _saving = false; }
    }

    private sealed class SettingsForm
    {
        public string Name { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        [Required, StringLength(100)] public string TimeZoneId { get; set; } = "America/Santo_Domingo";
        [Required, RegularExpression("^[A-Za-z]{3}$", ErrorMessage = "Usa un código de moneda de tres letras.")] public string CurrencyCode { get; set; } = "DOP";
        [Range(typeof(decimal), "0", "100", ErrorMessage = "La tasa debe estar entre 0 y 100 por ciento.")] public decimal TaxPercent { get; set; } = 18m;
    }
}
