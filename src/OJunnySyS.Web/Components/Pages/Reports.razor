@page "/app/reports"
@attribute [Authorize(Roles = "Administrator,Manager")]
@inject StoreService Store
@inject TenantSettingsService TenantSettings
@inject WarehouseService Warehouses
@inject TenantUserService TenantUsers
@inject OJunnySyS.Application.Abstractions.IBusinessClock Clock

<PageTitle>Reportes · OjunnySyS</PageTitle>
<PageHeader Eyebrow="ANÁLISIS / VENTAS" Title="Reportes" Description="Entiende el rendimiento de las ventas en el período que elijas.">
    <Actions>@if (_report is not null) { <a class="button button-secondary" href="@ExportUrl">↓ Descargar CSV</a> }</Actions>
</PageHeader>
<div class="report-presets" aria-label="Períodos rápidos">
    <span>Período rápido</span>
    <button class="button button-secondary" @onclick="() => SetPeriodAsync(Today.AddDays(-6), Today)">Últimos 7 días</button>
    <button class="button button-secondary" @onclick="() => SetPeriodAsync(Today.AddDays(-29), Today)">Últimos 30 días</button>
    <button class="button button-secondary" @onclick="() => SetPeriodAsync(new DateOnly(Today.Year, Today.Month, 1), Today)">Este mes</button>
    <button class="button button-secondary" @onclick="PreviousMonthAsync">Mes anterior</button>
</div>
<section class="panel report-filter">
    <label>Desde<InputDate @bind-Value="_from" /></label>
    <label>Hasta<InputDate @bind-Value="_to" /></label>
    <label>Almacén<InputSelect @bind-Value="_warehouseId"><option value="">Todos los almacenes</option>@foreach (var warehouse in _warehouses) { <option value="@warehouse.Id">@warehouse.Name</option> }</InputSelect></label>
    <label>Vendedor<InputSelect @bind-Value="_sellerUserId"><option value="">Todos los vendedores</option>@foreach (var seller in _sellers) { <option value="@seller.Id">@seller.DisplayName</option> }</InputSelect></label>
    <label>Número de venta o nota<InputText @bind-Value="_documentNumber" maxlength="64" placeholder="Ej. V-2026… o NC-…" /></label>
    <button class="button button-primary" @onclick="LoadAsync" disabled="@_loading">@(_loading ? "Generando…" : "Generar reporte")</button>
    <small class="report-filter-note">Fechas en la zona horaria del negocio. El número busca ventas y notas de crédito; el filtro de documento no altera el informe de caja.</small>
</section>
<div class="report-period">REPORTES OPERATIVOS <strong>Ventas · Caja y arqueos</strong></div>
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error">@_error</div> }
@if (_report is not null)
{
    <div class="report-period">PERÍODO <strong>@_report.From.ToString("dd MMM yyyy") — @_report.To.ToString("dd MMM yyyy")</strong></div>
    <div class="stats-grid report-stats">
        <MetricCard Label="VENTAS NETAS" Value="@DisplayFormat.Money(_report.Subtotal)" Icon="↗" Tone="green"><span class="muted-foot">@_report.SalesCount transacciones</span></MetricCard>
        <MetricCard Label="IMPUESTOS" Value="@DisplayFormat.Money(_report.TaxAmount)" Icon="◈" Tone="lilac"><span class="muted-foot">Impuestos calculados</span></MetricCard>
        <MetricCard Label="TOTAL COBRADO" Value="@DisplayFormat.Money(_report.Total)" Icon="▤" Tone="blue"><span class="muted-foot">Monto del período</span></MetricCard>
        <MetricCard Label="PROMEDIO POR VENTA" Value="@DisplayFormat.Money(Average)" Icon="◷" Tone="amber"><span class="muted-foot">Por transacción completada</span></MetricCard>
    </div>
    @if (_report.Documents is { Count: > 0 })
    {
        <section class="panel report-document-panel">
            <div class="panel-heading"><div><span class="eyebrow">DOCUMENTOS DEL PERÍODO</span><h2>Ventas y notas de crédito</h2><p>Importes netos de impuestos, cobros registrados y saldo actual por venta.</p></div><span class="result-count">@_report.Documents.Count documentos</span></div>
            <div class="table-wrap"><table><thead><tr><th>NÚMERO</th><th>TIPO</th><th>FECHA</th><th>CLIENTE</th><th>VENDEDOR</th><th>FORMA DE PAGO</th><th class="align-right">SUBTOTAL</th><th class="align-right">IMPUESTO</th><th class="align-right">TOTAL</th><th class="align-right">COBRADO</th><th class="align-right">SALDO ACTUAL</th></tr></thead><tbody>
            @foreach (var document in _report.Documents)
            {
                <tr><td class="mono"><strong>@document.Number</strong>@if (document.RelatedSaleNumber is not null) { <small class="bank-subline">Venta @document.RelatedSaleNumber</small> }</td><td>@document.Type</td><td>@Clock.ToBusinessTime(document.Date).ToString("dd/MM/yyyy HH:mm")</td><td>@document.CustomerName</td><td>@(document.SellerName ?? "—")</td><td>@document.PaymentMethod</td><td class="align-right">@Money(document.Subtotal)</td><td class="align-right">@Money(document.TaxAmount)</td><td class="align-right amount">@Money(document.Total)</td><td class="align-right">@Money(document.Collected)</td><td class="align-right">@Money(document.Balance)</td></tr>
            }
            </tbody></table></div>
        </section>
    }
    @if (_report.Documents is null || _report.Documents.Count == 0)
    {
        <section class="panel"><EmptyState Icon="▤" Title="Sin ventas en este período" Description="Prueba con otras fechas o registra una venta desde el punto de venta." /></section>
    }
    else
    {
        <div class="report-grid">
            <section class="panel report-panel">
                <div class="panel-heading"><div><h2>Ventas por día</h2><p>Importe cobrado · DOP</p></div></div>
                @if (_report.DailySales.Count == 0) { <div class="empty-state"><p>No hay movimientos para graficar.</p></div> }
                else
                {
                    var maxDaily = _report.DailySales.Max(x => x.Total);
                    <div class="daily-chart">@foreach (var day in _report.DailySales)
                    {
                        var height = maxDaily == 0 ? 0 : Math.Max(4, (int)Math.Round(day.Total / maxDaily * 100));
                        <div class="daily-column" title="@($"{day.Date:dd MMM}: {Money(day.Total)}")"><div class="daily-bar-wrap"><i style="height:@(height)%"></i></div><span>@day.Date.ToString("dd")</span></div>
                    }</div>
                }
            </section>
            <section class="panel report-panel">
                <div class="panel-heading"><div><h2>Métodos de pago</h2><p>Distribución de transacciones</p></div></div>
                @foreach (var payment in _report.Payments)
                {
                    <div class="report-row"><div><strong>@payment.Method</strong><small>@payment.Sales ventas</small></div><strong>@Money(payment.Total)</strong></div>
                }
            </section>
            <section class="panel report-panel top-products-panel">
                <div class="panel-heading"><div><h2>Productos más vendidos</h2><p>Margen calculado sobre unidades con costo conocido</p></div></div>
                <div class="table-wrap"><table><thead><tr><th>PRODUCTO</th><th class="align-right">UNIDADES</th><th class="align-right">INGRESOS</th><th class="align-right">COSTO CONOCIDO</th><th class="align-right">MARGEN BRUTO*</th><th class="align-right">SIN COSTO</th></tr></thead><tbody>@foreach (var product in _report.TopProducts) { <tr><td><strong>@product.ProductName</strong></td><td class="align-right">@product.Quantity</td><td class="align-right amount">@Money(product.Revenue)</td><td class="align-right">@Money(product.Cost)</td><td class="align-right amount">@Money(product.GrossProfit)</td><td class="align-right">@product.UncostedUnits</td></tr> }</tbody></table></div><small class="report-filter-note">* El margen es parcial cuando la columna «Sin costo» muestra unidades. Los costos históricos desconocidos no se incluyen.</small>
            </section>
            <section class="panel report-panel">
                <div class="panel-heading"><div><h2>Ventas por vendedor</h2><p>Ventas completadas atribuidas en el período</p></div></div>
                @foreach (var seller in _report.Sellers ?? []) { <div class="report-row"><div><strong>@seller.SellerName</strong><small>@seller.Sales ventas</small></div><strong>@Money(seller.Revenue)</strong></div> }
            </section>
            <section class="panel report-panel">
                <div class="panel-heading"><div><h2>Ventas por cliente</h2><p>Subtotal, impuestos e importe total de cada cliente</p></div></div>
                @foreach (var customer in _report.Customers ?? []) { <div class="report-row"><div><strong>@customer.CustomerName</strong><small>@customer.Sales ventas · Impuestos @Money(customer.TaxAmount)</small></div><strong>@Money(customer.Total)</strong></div> }
            </section>
            <section class="panel report-panel">
                <div class="panel-heading"><div><h2>Ventas por almacén</h2><p>Desempeño del almacén asignado a la terminal</p></div></div>
                @foreach (var warehouse in _report.Warehouses ?? []) { <div class="report-row"><div><strong>@WarehouseName(warehouse.WarehouseId)</strong><small>@warehouse.Sales ventas · Impuestos @Money(warehouse.TaxAmount)</small></div><strong>@Money(warehouse.Total)</strong></div> }
            </section>
        </div>
    }
}
@if (_cashReport is not null)
{
    <section class="panel report-panel cash-report-panel">
        <div class="panel-heading"><div><span class="eyebrow">CAJA · ARQUEOS</span><h2>Turnos y movimientos de efectivo</h2><p>@_cashReport.Sessions turnos · @_cashReport.OpenSessions abiertos en el período</p></div></div>
        <div class="stats-grid report-stats">
            <MetricCard Label="VENTAS EN EFECTIVO" Value="@Money(_cashReport.CashSales)" Icon="＄" Tone="green" />
            <MetricCard Label="ENTRADAS DE CAJA" Value="@Money(_cashReport.CashIn)" Icon="↘" Tone="blue" />
            <MetricCard Label="RETIROS DE CAJA" Value="@Money(_cashReport.CashOut)" Icon="↗" Tone="amber" />
            <MetricCard Label="DIFERENCIA DE ARQUEO" Value="@Money(_cashReport.CountedDifference)" Icon="◈" Tone="lilac" />
        </div>
        @if (_cashReport.Items.Count == 0) { <EmptyState Icon="＄" Title="Sin turnos en este período" Description="Al abrir y cerrar turnos de caja, los arqueos aparecerán en este informe." /> }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>CAJA</th><th>APERTURA</th><th>CIERRE</th><th>FONDO</th><th>VENTAS EFECTIVO</th><th>ENTRADAS</th><th>RETIROS</th><th>ARQUEO</th><th>DIFERENCIA</th><th>ESTADO</th></tr></thead><tbody>
            @foreach (var item in _cashReport.Items) { <tr><td><strong>@item.RegisterCode</strong></td><td>@Clock.ToBusinessTime(item.OpenedAtUtc).ToString("dd/MM/yy HH:mm")</td><td>@(item.ClosedAtUtc is { } closed ? Clock.ToBusinessTime(closed).ToString("dd/MM/yy HH:mm") : "—")</td><td class="align-right">@Money(item.OpeningFloat)</td><td class="align-right">@Money(item.CashSales)</td><td class="align-right">@Money(item.CashIn)</td><td class="align-right">@Money(item.CashOut)</td><td class="align-right">@(item.CountedCash is { } counted ? Money(counted) : "—")</td><td class="align-right">@Money(item.Difference ?? 0m)</td><td>@(item.Status == CashSessionStatus.Open ? "Abierta" : "Cerrada")</td></tr> }
            </tbody></table></div>
        }
    </section>
}

@code {
    private DateOnly _from, _to;
    private SalesReport? _report;
    private CashSessionReport? _cashReport;
    private IReadOnlyList<WarehouseDto> _warehouses = [];
    private IReadOnlyList<TenantMemberDto> _sellers = [];
    private Guid? _warehouseId, _sellerUserId;
    private string? _documentNumber;
    private string _currencyCode = "DOP";
    private string? _error;
    private bool _loading;
    private DateOnly Today => DateOnly.FromDateTime(Clock.ToBusinessTime(Clock.UtcNow).DateTime);
    private decimal Average => _report is null || _report.SalesCount == 0 ? 0 : decimal.Round(_report.Total / _report.SalesCount, 2);
    private string ExportUrl => $"/api/v1/reports/sales.csv?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}" +
        (_warehouseId is { } warehouse ? $"&warehouseId={warehouse}" : "") + (_sellerUserId is { } seller ? $"&sellerUserId={seller}" : "") +
        (!string.IsNullOrWhiteSpace(_documentNumber) ? $"&documentNumber={Uri.EscapeDataString(_documentNumber.Trim())}" : "");

    protected override async Task OnInitializedAsync()
    {
        _to = DateOnly.FromDateTime(Clock.ToBusinessTime(Clock.UtcNow).DateTime);
        _from = _to.AddDays(-29);
        _currencyCode = (await TenantSettings.GetAsync()).CurrencyCode;
        _warehouses = await Warehouses.GetAsync(includeInactive: false);
        _sellers = await TenantUsers.GetActiveSalespeopleAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _report = await Store.GetSalesReportAsync(_from, _to, _warehouseId, _sellerUserId, _documentNumber); _cashReport = await Store.GetCashSessionReportAsync(_from, _to); }
        catch (DomainException ex) { _report = null; _cashReport = null; _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SetPeriodAsync(DateOnly from, DateOnly to) { _from = from; _to = to; await LoadAsync(); }
    private Task PreviousMonthAsync()
    {
        var start = new DateOnly(Today.Year, Today.Month, 1).AddMonths(-1);
        return SetPeriodAsync(start, start.AddMonths(1).AddDays(-1));
    }

    private string Money(decimal value) => DisplayFormat.Money(value, _currencyCode);
    private string WarehouseName(Guid warehouseId) => _warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Name ?? "Almacén inactivo";
    private static string PaymentLabel(PaymentMethod value) => DisplayFormat.PaymentLabel(value);
}


