@page "/app/products"
@attribute [Authorize(Roles = "Administrator,Manager")]
@inject StoreService Store
@inject ILogger<Products> Logger

<PageTitle>Productos · OjunnySyS</PageTitle>
<PageHeader Eyebrow="INVENTARIO / PRODUCTOS" Title="Productos" Description="Administra el catálogo sin perder las referencias del historial de ventas.">
    <Actions><button class="button button-primary" @onclick="OpenCreate"><span>＋</span> Nuevo producto</button></Actions>
</PageHeader>
<div class="inventory-summary"><div><span>PRODUCTOS ACTIVOS</span><strong>@_products.Count(x => x.IsActive)</strong></div><div><span>UNIDADES DISPONIBLES</span><strong>@_products.Where(x => x.IsActive).Sum(x => x.StockOnHand)</strong></div><div><span>INVENTARIO BAJO</span><strong class="@(LowStock > 0 ? "alert-number" : "")">@LowStock</strong></div><div><span>VALOR DEL INVENTARIO</span><strong>@Money(_products.Where(x => x.IsActive).Sum(x => x.UnitPrice * x.StockOnHand))</strong></div></div>
<div class="panel list-panel">
    <div class="list-toolbar product-toolbar"><SearchField @bind-Value="_search" @bind-Value:after="LoadAsync" Placeholder="Buscar producto, SKU o código de barras…" /><label class="product-include-inactive"><InputCheckbox @bind-Value="_includeInactive" @bind-Value:after="LoadAsync" /> Mostrar inactivos</label><span class="result-count">@_products.Count productos</span></div>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error product-page-error">@_error</div> }
    <div class="table-wrap"><table><thead><tr><th>PRODUCTO</th><th>SKU</th><th>CATEGORÍA</th><th class="align-right">PRECIO</th><th class="align-right">UNIDADES</th><th>ESTADO</th><th class="align-right">ACCIONES</th></tr></thead><tbody>
        @foreach (var product in _products) { <tr class="@(!product.IsActive ? "product-inactive-row" : "")"><td><span class="product-cell"><span class="product-thumb">@ProductIcon(product.Category)</span><strong>@product.Name</strong></span></td><td class="mono">@product.Sku</td><td><span class="category-pill">@product.Category</span></td><td class="align-right amount">@Money(product.UnitPrice)</td><td class="align-right"><strong class="@(product.IsActive && product.StockOnHand <= 5 ? "alert-number" : "")">@product.StockOnHand</strong></td><td><span class="@(product.IsActive ? product.StockOnHand <= 5 ? "status-pill status-warning" : "status-pill" : "status-pill status-inactive")"><i></i>@(product.IsActive ? product.StockOnHand <= 5 ? "Reponer" : "Disponible" : "Inactivo")</span></td><td class="align-right"><div class="product-row-actions"><button class="button button-secondary button-small" @onclick="() => OpenEdit(product)">Editar</button><button class="button @(product.IsActive ? "button-quiet-danger" : "button-quiet-success") button-small" @onclick="() => _pendingStatus = product">@(product.IsActive ? "Desactivar" : "Activar")</button></div></td></tr> }
    </tbody></table></div>
    @if (_products.Count == 0) { <div class="empty-state"><strong>No hay productos que coincidan</strong><p>Prueba otra búsqueda o crea el primer artículo de tu catálogo.</p></div> }
</div>
@if (_showForm) { <div class="modal-backdrop" @onclick="CloseForm"><section class="modal-card" @onclick:stopPropagation="true"><div class="modal-heading"><div><span class="eyebrow">INVENTARIO · CATÁLOGO</span><h2>@(_form.Id == Guid.Empty ? "Agregar producto" : "Editar producto")</h2><p>@(_form.Id == Guid.Empty ? "Define el artículo y registra las existencias iniciales." : "El stock se mantiene por movimientos de inventario y no se altera al editar el catálogo.")</p></div><button class="icon-button" @onclick="CloseForm">×</button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="form-grid"><label>Nombre<InputText @bind-Value="_form.Name" placeholder="Nombre del producto" /></label><label>SKU<InputText @bind-Value="_form.Sku" placeholder="Ej. CAF-006" /></label><label>Categoría<InputText @bind-Value="_form.Category" placeholder="Ej. Café" /></label><label>Código de barras <span class="optional">Opcional</span><InputText @bind-Value="_form.Barcode" placeholder="EAN / UPC" /></label><label>Precio<InputNumber @bind-Value="_form.UnitPrice" min="0" step="0.01" /></label>@if (_form.Id == Guid.Empty) { <label>Existencias iniciales<InputNumber @bind-Value="_form.Stock" min="0" /></label>}</div><ValidationSummary />@if (!string.IsNullOrWhiteSpace(_formError)) { <div class="inline-error">@_formError</div> }<div class="modal-actions"><button type="button" class="button button-secondary" @onclick="CloseForm">Cancelar</button><button type="submit" class="button button-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar producto")</button></div></EditForm></section></div> }
@if (_pendingStatus is { } pending) { <div class="modal-backdrop" @onclick="() => _pendingStatus = null"><section class="modal-card confirm-card" @onclick:stopPropagation="true"><div class="modal-heading"><div><span class="eyebrow">INVENTARIO · ESTADO</span><h2>@(pending.IsActive ? "Desactivar producto" : "Reactivar producto")</h2><p>@(pending.IsActive ? $"«{pending.Name}» dejará de aparecer para nuevas ventas y compras. Su stock y sus referencias históricas se conservarán." : $"«{pending.Name}» volverá a estar disponible en ventas y compras.")</p></div><button class="icon-button" @onclick="() => _pendingStatus = null">×</button></div>@if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error">@_error</div> }<div class="modal-actions"><button class="button button-secondary" @onclick="() => _pendingStatus = null">Cancelar</button><button class="button button-primary" disabled="@_saving" @onclick="ChangeStatusAsync">@(pending.IsActive ? "Desactivar" : "Reactivar")</button></div></section></div> }
@if (!string.IsNullOrWhiteSpace(_notice)) { <div class="toast">✓ @_notice</div> }

@code {
    private List<ProductDto> _products = [];
    private ProductDto? _pendingStatus;
    private string _search = "";
    private bool _includeInactive, _showForm, _saving;
    private string? _error, _formError, _notice;
    private ProductForm _form = new();
    private int LowStock => _products.Count(x => x.IsActive && x.StockOnHand <= 5);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() => _products = (await Store.SearchProductsAsync(_search, _includeInactive)).ToList();
    private void OpenCreate() { _form = new(); _formError = null; _showForm = true; }
    private void OpenEdit(ProductDto product) { _form = new() { Id = product.Id, ExpectedRevision = product.Revision, Sku = product.Sku, Name = product.Name, Category = product.Category, Barcode = product.Barcode, UnitPrice = product.UnitPrice }; _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync()
    {
        _saving = true; _formError = null;
        try { if (_form.Id == Guid.Empty) await Store.CreateProductAsync(_form.Sku, _form.Name, _form.Category, _form.UnitPrice, _form.Stock, _form.Barcode); else await Store.UpdateProductAsync(_form.Id, new(_form.Sku, _form.Name, _form.Category, _form.UnitPrice, _form.Barcode, _form.ExpectedRevision)); _showForm = false; _notice = _form.Id == Guid.Empty ? "Producto agregado correctamente" : "Producto actualizado correctamente"; _error = null; await LoadAsync(); }
        catch (DomainException ex) { _formError = ex.Message; }
        catch (ConcurrencyConflictException ex) { _formError = ex.Message; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo guardar el producto."); _formError = "No se pudo guardar el producto. Inténtalo de nuevo."; }
        finally { _saving = false; }
    }
    private async Task ChangeStatusAsync()
    {
        if (_pendingStatus is not { } product) return;
        _saving = true; _error = null;
        try { await Store.SetProductActiveAsync(product.Id, new(!product.IsActive, product.Revision)); _notice = product.IsActive ? "Producto desactivado; el historial se conservó" : "Producto reactivado"; _pendingStatus = null; await LoadAsync(); }
        catch (Exception ex) when (ex is DomainException or ConcurrencyConflictException) { _error = ex.Message; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo cambiar el estado del producto {ProductId}.", product.Id); _error = "No se pudo actualizar el producto."; }
        finally { _saving = false; }
    }
    private static string Money(decimal amount) => DisplayFormat.Money(amount);
    private static string ProductIcon(string category) => category.Contains("Café", StringComparison.OrdinalIgnoreCase) ? "☕" : category.Contains("Bebida", StringComparison.OrdinalIgnoreCase) ? "◉" : "✳";
    private sealed class ProductForm
    {
        public Guid Id { get; set; }
        public long ExpectedRevision { get; set; }
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(160, MinimumLength = 2)] public string Name { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(40, MinimumLength = 1)] public string Sku { get; set; } = "";
        [System.ComponentModel.DataAnnotations.StringLength(80)] public string Category { get; set; } = "General";
        [System.ComponentModel.DataAnnotations.StringLength(64)] public string? Barcode { get; set; }
        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "999999999999")] public decimal UnitPrice { get; set; }
        [System.ComponentModel.DataAnnotations.Range(0, int.MaxValue)] public int Stock { get; set; }
    }
}
