@page "/app/products"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Manager")]
@inject StoreService Store
@inject TenantSettingsService TenantSettings
@inject TaxProfileService TaxProfiles
@inject WarehouseService Warehouses
@inject ProductImageStorage ImageStorage
@inject ILogger<Products> Logger

<PageTitle>Productos · OjunnySyS</PageTitle>
<PageHeader Eyebrow="INVENTARIO / PRODUCTOS" Title="Productos" Description="Administra el catálogo sin perder las referencias del historial de ventas.">
    <Actions><button class="button button-primary" @onclick="OpenCreate"><span>＋</span> Nuevo producto</button></Actions>
</PageHeader>
<div class="inventory-summary"><div><span>PRODUCTOS ACTIVOS</span><strong>@_products.Count(x => x.IsActive)</strong></div><div><span>UNIDADES DISPONIBLES</span><strong>@_products.Where(x => x.IsActive).Sum(x => x.StockOnHand)</strong></div><div><span>INVENTARIO BAJO</span><strong class="@(LowStock > 0 ? "alert-number" : "")">@LowStock</strong></div><div><span>INVENTARIO A COSTO</span><strong>@Money(_valuation.CostedInventoryValue)</strong></div><div><span>UNIDADES SIN COSTO</span><strong class="@(_valuation.UncostedUnits > 0 ? "alert-number" : "")">@_valuation.UncostedUnits</strong></div></div>
<div class="panel list-panel">
    <div class="list-toolbar product-toolbar"><SearchField @bind-Value="_search" @bind-Value:after="LoadAsync" Placeholder="Buscar producto, SKU o código de barras…" /><label class="product-include-inactive"><InputCheckbox @bind-Value="_includeInactive" @bind-Value:after="LoadAsync" /> Mostrar inactivos</label><span class="result-count">@_products.Count productos</span></div>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error product-page-error">@_error</div> }
    <div class="table-wrap"><table><thead><tr><th>PRODUCTO</th><th>SKU</th><th>CATEGORÍA</th><th>IMPUESTO</th><th class="align-right">PRECIO</th><th class="align-right">UNIDADES</th><th>ESTADO</th><th class="align-right">ACCIONES</th></tr></thead><tbody>
        @foreach (var product in _products) { <tr class="@(!product.IsActive ? "product-inactive-row" : "")"><td><span class="product-cell"><span class="product-thumb">@if (!string.IsNullOrWhiteSpace(product.ImageUrl)) { <img class="product-photo" src="@product.ImageUrl" alt="" loading="lazy" /> } else { @ProductIcon(product.Category) }</span><strong>@product.Name</strong></span></td><td class="mono">@product.Sku</td><td><span class="category-pill">@product.Category</span></td><td>@TaxLabel(product)</td><td class="align-right amount">@Money(product.UnitPrice)</td><td class="align-right"><strong class="@(product.IsActive && product.StockOnHand <= 5 ? "alert-number" : "")">@product.StockOnHand</strong></td><td><span class="@(product.IsActive ? product.StockOnHand <= 5 ? "status-pill status-warning" : "status-pill" : "status-pill status-inactive")"><i></i>@(product.IsActive ? product.StockOnHand <= 5 ? "Reponer" : "Disponible" : "Inactivo")</span></td><td class="align-right"><div class="product-row-actions"><button class="button button-secondary button-small" @onclick="() => OpenEdit(product)">Editar</button><button class="button @(product.IsActive ? "button-quiet-danger" : "button-quiet-success") button-small" @onclick="() => _pendingStatus = product">@(product.IsActive ? "Desactivar" : "Activar")</button></div></td></tr> }
    </tbody></table></div>
    @if (_products.Count == 0) { <div class="empty-state"><strong>No hay productos que coincidan</strong><p>Prueba otra búsqueda o crea el primer artículo de tu catálogo.</p></div> }
</div>
    @if (_showForm) { <div class="modal-backdrop" @onclick="CloseFormAsync"><section class="modal-card" @onclick:stopPropagation="true"><div class="modal-heading"><div><span class="eyebrow">INVENTARIO · CATÁLOGO</span><h2>@(_form.Id == Guid.Empty ? "Agregar producto" : "Editar producto")</h2><p>@(_form.Id == Guid.Empty ? "Define el artículo y registra las existencias iniciales." : "El stock se mantiene por movimientos de inventario y no se altera al editar el catálogo.")</p></div><button class="icon-button" @onclick="CloseFormAsync">×</button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="form-grid"><label>Nombre<InputText @bind-Value="_form.Name" placeholder="Nombre del producto" /></label><label>SKU<InputText @bind-Value="_form.Sku" placeholder="Ej. CAF-006" /></label><label>Categoría<InputText @bind-Value="_form.Category" placeholder="Ej. Café" /></label><label>Código de barras <span class="optional">Opcional</span><InputText @bind-Value="_form.Barcode" placeholder="EAN / UPC" /></label><label>Precio de venta<NumericInput @bind-Value="_form.UnitPrice" min="0" step="0.01" /></label><label>Impuesto<InputSelect @bind-Value="_form.TaxSelection"><option value="">Impuesto general de la empresa · @($"{_defaultTaxRate * 100m:0.##}%")</option>@foreach (var profile in _taxProfiles) { <option value="@profile.Id">@profile.Name · @($"{profile.Rate * 100m:0.##}%")</option> }<option value="custom">Tasa personalizada</option></InputSelect></label>@if (_form.TaxSelection == "custom") { <label>Tasa personalizada (%)<NumericInput @bind-Value="_form.TaxRatePercent" min="0" max="100" step="0.01" /></label> }@if (_form.Id == Guid.Empty) { <label>Existencias iniciales<NumericInput @bind-Value="_form.Stock" min="0" /></label><label>Almacén inicial<InputSelect @bind-Value="_form.InitialWarehouseId"><option value="">Almacén principal por defecto</option>@foreach (var warehouse in _warehouses) { <option value="@warehouse.Id">@warehouse.Name · @warehouse.Code</option> }</InputSelect></label><label>Costo unitario inicial <span class="optional">Opcional si lo conoces</span><NumericInput @bind-Value="_form.InitialUnitCost" min="0" step="0.01" /></label>}<label class="full-span">Imagen del producto <span class="optional">Carga PNG, JPEG o WebP (máximo 5 MB), o usa un enlace</span><InputText @bind-Value="_form.ImageUrl" type="url" maxlength="500" placeholder="https://.../producto.jpg" /><InputFile OnChange="UploadImageAsync" accept="image/png,image/jpeg,image/webp" /></label>@if (_form.ImageUrl is { Length: > 0 }) { <div class="product-image-preview full-span"><img src="@_form.ImageUrl" alt="Vista previa de @_form.Name" loading="lazy" /></div>}</div><small class="report-filter-note">Los perfiles guardados se reutilizan en productos. Cada venta conserva la tasa aplicada aunque luego se edite el perfil.</small><ValidationSummary />@if (!string.IsNullOrWhiteSpace(_formError)) { <div class="inline-error">@_formError</div> }<div class="modal-actions"><button type="button" class="button button-secondary" @onclick="CloseFormAsync">Cancelar</button><button type="submit" class="button button-primary" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar producto")</button></div></EditForm></section></div> }
@if (_pendingStatus is { } pending) { <div class="modal-backdrop" @onclick="() => _pendingStatus = null"><section class="modal-card confirm-card" @onclick:stopPropagation="true"><div class="modal-heading"><div><span class="eyebrow">INVENTARIO · ESTADO</span><h2>@(pending.IsActive ? "Desactivar producto" : "Reactivar producto")</h2><p>@(pending.IsActive ? $"«{pending.Name}» dejará de aparecer para nuevas ventas y compras. Su stock y sus referencias históricas se conservarán." : $"«{pending.Name}» volverá a estar disponible en ventas y compras.")</p></div><button class="icon-button" @onclick="() => _pendingStatus = null">×</button></div>@if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error">@_error</div> }<div class="modal-actions"><button class="button button-secondary" @onclick="() => _pendingStatus = null">Cancelar</button><button class="button button-primary" disabled="@_saving" @onclick="ChangeStatusAsync">@(pending.IsActive ? "Desactivar" : "Reactivar")</button></div></section></div> }
@if (!string.IsNullOrWhiteSpace(_notice)) { <div class="toast">✓ @_notice</div> }

@code {
    private List<ProductDto> _products = [];
    private IReadOnlyList<WarehouseDto> _warehouses = [];
    private IReadOnlyList<TaxProfileDto> _taxProfiles = [];
    private ProductDto? _pendingStatus;
    private string _search = "";
    private bool _includeInactive, _showForm, _saving;
    private string? _error, _formError, _notice;
    private ProductForm _form = new();
    private string? _originalImageUrl, _stagedImageUrl;
    private int LowStock => _products.Count(x => x.IsActive && x.StockOnHand <= 5);
    private decimal _defaultTaxRate = 0.18m;
    protected override async Task OnInitializedAsync() { _defaultTaxRate = (await TenantSettings.GetAsync()).DefaultTaxRate; _taxProfiles = await TaxProfiles.GetAsync(); _warehouses = await Warehouses.GetAsync(includeInactive: false); await LoadAsync(); }
    private InventoryValuationDto _valuation = new(0m, 0);
    private async Task LoadAsync()
    {
        _products = (await Store.SearchProductsAsync(_search, _includeInactive)).ToList();
        _valuation = await Store.GetInventoryValuationAsync();
    }
    private void OpenCreate() { _form = new() { TaxRatePercent = _defaultTaxRate * 100m, InitialWarehouseId = _warehouses.FirstOrDefault(x => x.Code == "MAIN")?.Id ?? _warehouses.FirstOrDefault()?.Id }; _originalImageUrl = _stagedImageUrl = null; _formError = null; _showForm = true; }
    private void OpenEdit(ProductDto product) { _form = new() { Id = product.Id, ExpectedRevision = product.Revision, Sku = product.Sku, Name = product.Name, Category = product.Category, Barcode = product.Barcode, UnitPrice = product.UnitPrice, ImageUrl = product.ImageUrl, TaxSelection = product.TaxProfileId?.ToString() ?? (product.TaxRateOverride is null ? "" : "custom"), TaxRatePercent = (product.TaxRateOverride ?? product.TaxProfileRate ?? _defaultTaxRate) * 100m }; _originalImageUrl = product.ImageUrl; _stagedImageUrl = null; _formError = null; _showForm = true; }
    private async Task CloseFormAsync() { if (_saving) return; _showForm = false; await ImageStorage.DeleteAsync(_stagedImageUrl); _stagedImageUrl = null; }
    private async Task UploadImageAsync(InputFileChangeEventArgs args)
    {
        _formError = null;
        try
        {
            var uploadedUrl = await ImageStorage.SaveAsync(args.File);
            await ImageStorage.DeleteAsync(_stagedImageUrl);
            _stagedImageUrl = uploadedUrl;
            _form.ImageUrl = uploadedUrl;
        }
        catch (DomainException ex) { _formError = ex.Message; }
        catch (IOException) { _formError = "No se pudo guardar la imagen. Inténtalo de nuevo."; }
    }
    private async Task SaveAsync()
    {
        _saving = true; _formError = null;
        try { var previousImage = _originalImageUrl; var savedImage = _form.ImageUrl; decimal? taxOverride = _form.TaxSelection == "custom" ? _form.TaxRatePercent / 100m : null; var taxProfileId = Guid.TryParse(_form.TaxSelection, out var parsedTaxId) ? parsedTaxId : (Guid?)null; if (_form.Id == Guid.Empty) await Store.CreateProductAsync(_form.Sku, _form.Name, _form.Category, _form.UnitPrice, _form.Stock, _form.Barcode, taxOverride, _form.InitialUnitCost, taxProfileId, _form.ImageUrl, _form.InitialWarehouseId); else await Store.UpdateProductAsync(_form.Id, new(_form.Sku, _form.Name, _form.Category, _form.UnitPrice, _form.Barcode, _form.ExpectedRevision, taxOverride, taxProfileId, _form.ImageUrl)); _showForm = false; if (!string.Equals(previousImage, savedImage, StringComparison.Ordinal)) await ImageStorage.DeleteAsync(previousImage); if (!string.Equals(_stagedImageUrl, savedImage, StringComparison.Ordinal)) await ImageStorage.DeleteAsync(_stagedImageUrl); _originalImageUrl = _stagedImageUrl = null; _notice = _form.Id == Guid.Empty ? "Producto agregado correctamente" : "Producto actualizado correctamente"; _error = null; await LoadAsync(); }
        catch (DomainException ex) { _formError = ex.Message; }
        catch (ConcurrencyConflictException ex) { _formError = ex.Message; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo guardar el producto."); _formError = "No se pudo guardar el producto. Inténtalo de nuevo."; }
        finally { _saving = false; }
    }
    private async Task ChangeStatusAsync()
    {
        if (_pendingStatus is not { } product) return;
        _saving = true; _error = null;
        try { await Store.SetProductActiveAsync(product.Id, new(!product.IsActive, product.Revision)); _notice = product.IsActive ? "Producto desactivado; el historial se conservó" : "Producto reactivado"; _pendingStatus = null; await LoadAsync(); }
        catch (Exception ex) when (ex is DomainException or ConcurrencyConflictException) { _error = ex.Message; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo cambiar el estado del producto {ProductId}.", product.Id); _error = "No se pudo actualizar el producto."; }
        finally { _saving = false; }
    }
    private string TaxLabel(ProductDto product) => product.TaxProfileId is not null ? $"{product.TaxProfileName ?? "Perfil"} · {((product.TaxProfileRate ?? _defaultTaxRate) * 100m):0.##}%" : product.TaxRateOverride is { } rate ? rate == 0 ? "Exento · 0%" : $"{rate * 100m:0.##}% · personalizado" : $"General · {_defaultTaxRate * 100m:0.##}%";
    private static string Money(decimal amount) => DisplayFormat.Money(amount);
    private static string ProductIcon(string category) => category.Contains("Café", StringComparison.OrdinalIgnoreCase) ? "☕" : category.Contains("Bebida", StringComparison.OrdinalIgnoreCase) ? "◉" : "✳";
    private sealed class ProductForm
    {
        public Guid Id { get; set; }
        public long ExpectedRevision { get; set; }
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(160, MinimumLength = 2)] public string Name { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(40, MinimumLength = 1)] public string Sku { get; set; } = "";
        [System.ComponentModel.DataAnnotations.StringLength(80)] public string Category { get; set; } = "General";
        [System.ComponentModel.DataAnnotations.StringLength(64)] public string? Barcode { get; set; }
        [System.ComponentModel.DataAnnotations.StringLength(500)] public string? ImageUrl { get; set; }
        public Guid? InitialWarehouseId { get; set; }
        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "999999999999")] public decimal UnitPrice { get; set; }
        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "9999999999.9999")] public decimal? InitialUnitCost { get; set; }
        public string TaxSelection { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "100", ErrorMessage = "El impuesto debe estar entre 0 y 100 %.")] public decimal TaxRatePercent { get; set; } = 18m;
        [System.ComponentModel.DataAnnotations.Range(0, int.MaxValue)] public int Stock { get; set; }
    }
}
