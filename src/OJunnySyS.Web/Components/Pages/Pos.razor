@page "/app/pos"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Authorize(Roles = "Administrator,Manager,Cashier")]
@inject StoreService Store
@inject ParkedSaleService ParkedSales
@inject TenantSettingsService TenantSettings
@inject PosRegisterService PosRegisters
@inject WarehouseService WarehouseService
@inject PosPaymentMethodService PaymentMethods
@inject TenantUserService TenantUsers
@inject AuthenticationStateProvider AuthenticationState
@inject ILogger<Pos> Logger
@inject IJSRuntime JS

<PageTitle>Punto de venta · OjunnySyS</PageTitle>
<PageHeader Eyebrow="VENTAS / PUNTO DE VENTA" Title="Punto de venta" Description="Agrega productos, elige cómo cobrar y listo.">
    <Actions><div class="flex flex-wrap items-end gap-3"><label class="grid min-w-36 gap-1 text-xs font-semibold text-slate-600" for="pos-terminal">Terminal<select id="pos-terminal" class="min-h-10 rounded-xl border border-slate-200 bg-white px-3 text-sm" @bind="_registerCode" @bind:after="OnRegisterChangedAsync"><option value="">Selecciona un terminal</option>@foreach (var register in _registers) { <option value="@register.Code">@register.Name</option> }</select></label><a class="flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-ink" href="/app/cash"><span class="size-2 rounded-full @(CashOpen ? "bg-emerald-500" : "bg-amber-500")"></span><span class="grid gap-0.5"><strong class="text-xs">@(CashOpen ? "Caja abierta" : "Caja cerrada")</strong><small class="text-xs text-muted">@(_registers.FirstOrDefault(x => x.Code == _registerCode)?.Name ?? _registerCode) · @_warehouses.FirstOrDefault(x => x.Id == _warehouseId)?.Name · administrar</small></span></a><ReceiptPrintQuickSettings /></div></Actions>
</PageHeader>
@if (_loading)
{
    <div class="loading-panel" role="status">Preparando caja, terminales, impuestos y catálogo…</div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="inline-error cash-error" role="alert">@_loadError <button type="button" class="button button-secondary button-small" @onclick="InitializeAsync">Reintentar</button></div>
}
else
{
@if (!string.IsNullOrWhiteSpace(_notice)) { <div class="success-banner">✓ @_notice @if (_lastSaleId is { } saleId) { <a class="receipt-quick-link" href="/app/receipts/@saleId">Ver recibo</a> }<button @onclick="() => _notice = null">×</button></div> }
@if (!CashOpen && !string.IsNullOrEmpty(_registerCode)) { <div class="cash-opening-prompt"><span class="cash-prompt-icon">◷</span><div><strong>El turno se abrirá al cobrar</strong><p>Indica el efectivo inicial de @_registers.FirstOrDefault(x => x.Code == _registerCode)?.Name. Tu orden se conservará.</p></div><button type="button" class="button button-secondary button-small" @onclick="() => _showOpeningPrompt = true">Abrir turno</button></div> }
@if (_registers.Count == 0) { <div class="inline-error cash-error">No hay terminales POS activos. Pide al administrador que configure uno en <a href="/app/pos/registers">Terminales POS</a>.</div> }
<AuthorizeView Roles="Administrator,Manager"><Authorized><details class="pos-configuration"><summary><span><strong>Configuración del punto de venta</strong><small>Productos, almacenes, terminales, pagos y recibos</small></span><span class="pos-configuration-toggle">Abrir <b>⌄</b></span></summary><nav aria-label="Configuración del punto de venta"><a href="/app/products"><strong>Productos</strong><small>Catálogo, precios e impuestos</small></a><a href="/app/inventory/warehouses"><strong>Almacenes</strong><small>Existencias y traslados</small></a><a href="/app/pos/registers"><strong>Terminales y cajas</strong><small>Asignar cada caja a un almacén</small></a><a href="/app/payment-methods"><strong>Medios de pago</strong><small>Efectivo, tarjetas y transferencias</small></a><a href="/app/settings"><strong>Empresa e impresión</strong><small>Datos fiscales y formato del recibo</small></a></nav></details></Authorized></AuthorizeView>
<div class="grid min-w-0 items-start gap-4 xl:grid-cols-[minmax(0,1.45fr)_minmax(21rem,.8fr)]">
    <section class="grid min-w-0 content-start gap-4">
        <div class="grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-3"><SearchField @bind-Value="_search" @bind-Value:after="LoadProductsAsync" InputId="pos-search" CssClass="grid min-w-0 grid-cols-[auto_minmax(0,1fr)] items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-slate-500" InputClass="min-w-0 border-0 bg-transparent px-0 py-2 text-sm outline-none" Placeholder="Buscar producto o escanear código…" /><span class="result-count">@_filteredProducts.Count() productos</span></div>
        <div class="flex max-w-full flex-wrap gap-2 overflow-x-auto pb-1" aria-label="Grupos de artículos"><button class="@CategoryClass(null)" @onclick="() => { _category = null; _subcategory = null; }">Todos los grupos</button>@foreach (var category in _categories) { <button class="@CategoryClass(category)" @onclick="() => SelectGroup(category)">@category</button> }</div>
        @if (_category is not null && _subcategories.Count > 0) { <div class="flex max-w-full flex-wrap gap-2 overflow-x-auto pb-1" aria-label="Subgrupos de @_category"><button class="@SubcategoryClass(null)" @onclick="() => _subcategory = null">Todos en @_category</button>@foreach (var subgroup in _subcategories) { <button class="@SubcategoryClass(subgroup)" @onclick="() => _subcategory = subgroup">@subgroup</button> }</div> }
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3 2xl:grid-cols-4">
            @foreach (var product in _filteredProducts)
            {
                var inCart = _cart.GetValueOrDefault(product.Id);
                <button class="grid min-w-0 content-start gap-3 rounded-2xl border border-slate-200 bg-white p-3 text-left shadow-sm transition hover:border-brand-500 hover:shadow-md disabled:cursor-not-allowed disabled:opacity-50 sm:p-4" @onclick="() => Add(product)" disabled="@(inCart >= product.StockOnHand || _parkedSaleId is not null)">
                    <span class="grid aspect-square min-h-24 place-items-center gap-2 overflow-hidden rounded-xl p-3 text-2xl @ArtClass(product.Category)">@if (!string.IsNullOrWhiteSpace(product.ImageUrl)) { <img class="max-h-full max-w-full object-contain" src="@product.ImageUrl" alt="Imagen de @product.Name" loading="lazy" /> } else { <span>@ProductIcon(product.Category)</span> }<span class="ml-auto grid size-7 place-items-center rounded-full bg-white/80 text-sm text-brand-700">＋</span></span>
                    <span class="grid min-w-0 gap-1"><strong class="truncate text-sm font-semibold text-ink">@product.Name</strong><small class="line-clamp-2 text-xs leading-5 text-muted">@ProductGroup(product.Category)@if (ProductSubgroup(product.Category) is { Length: > 0 } subgroup) { <span> · @subgroup</span> } · @_cart.GetValueOrDefault(product.Id) en orden · @TaxLabel(product)</small><b class="text-base font-bold text-brand-700">@Money(product.UnitPrice)</b></span>
                    @if (product.StockOnHand <= 5) { <span class="w-fit rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-800">Quedan @product.StockOnHand</span> }
                </button>
            }
        </div>
    </section>
    <aside class="grid h-fit min-w-0 gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm xl:sticky xl:top-3">
        <div class="flex flex-wrap items-center justify-between gap-3"><div><span class="eyebrow">VENTA ACTUAL</span><h2 class="mt-1 font-display text-lg font-bold text-ink">Tu orden <span class="inline-grid min-w-6 place-items-center rounded-md bg-brand-50 px-1.5 py-0.5 align-middle text-xs text-brand-700">@_cart.Values.Sum()</span></h2></div><div class="flex items-center gap-2"><button class="button button-secondary button-small" @onclick="ParkCurrentSaleAsync" disabled="@(_cart.Count == 0 || _saving || _parkedSaleId is not null)">Guardar en espera</button><button class="rounded-lg px-2 py-1 text-xs font-semibold text-slate-500 hover:bg-slate-50 disabled:opacity-40" @onclick="ClearCartAsync" disabled="@(_cart.Count == 0 || _saving)">Vaciar</button></div></div>
        @if (_parkedSaleId is not null) { <div class="grid gap-1 rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900"><strong>Venta en espera retomada</strong><span>Artículos y descuentos quedan protegidos. Los precios e impuestos se actualizan al cobrar.</span></div> }
        @if (_parkedSales.Count > 0)
        {
            <section class="grid gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3" aria-label="Ventas en espera">
                <div class="flex items-center justify-between gap-2"><div><span class="eyebrow">TURNO DE VENTA</span><h3 class="mt-1 text-sm font-bold text-ink">En espera <span class="inline-grid min-w-5 place-items-center rounded-md bg-brand-50 px-1 text-xs text-brand-700">@_parkedSales.Count</span></h3></div><button type="button" class="grid size-8 place-items-center rounded-lg border border-slate-200 bg-white" @onclick="RefreshParkedSalesAsync" aria-label="Actualizar ventas en espera">↻</button></div>
                @foreach (var parked in _parkedSales)
                {
                    <article class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 py-2">
                        <div class="grid min-w-0 flex-1 gap-0.5"><strong class="text-xs text-ink">@parked.CustomerName</strong><span class="text-xs text-muted">@parked.Lines.Sum(x => x.Quantity) unidades · guardada @parked.CreatedAtUtc.LocalDateTime.ToString("t")</span><small class="max-w-56 truncate text-xs text-muted">@string.Join(" · ", parked.Lines.Select(x => $"{x.Quantity} {x.ProductName}"))</small></div>
                        <div class="flex shrink-0 items-center gap-1"><button type="button" class="button button-secondary button-small" @onclick="() => ResumeParkedSaleAsync(parked, false)" disabled="@(_saving || _cart.Count > 0)">Retomar</button><button type="button" class="button button-quiet button-small" @onclick="() => ResumeParkedSaleAsync(parked, true)" disabled="@(_saving || _cart.Count > 0)">Editar</button><button type="button" class="grid size-8 place-items-center rounded-lg text-rose-700 hover:bg-rose-50 disabled:opacity-40" @onclick="() => CancelParkedSaleAsync(parked)" disabled="@_saving" aria-label="Cancelar venta en espera">×</button></div>
                    </article>
                }
            </section>
        }
        <label class="grid gap-1 text-xs font-semibold text-slate-600" for="customer">Cliente<select id="customer" class="min-h-10 rounded-xl border border-slate-200 bg-white px-3 text-sm" @bind="_customerId" @bind:after="ResetCheckoutKey" disabled="@(_parkedSaleId is not null)"><option value="">Consumidor final</option>@foreach (var customer in _customers) { <option value="@customer.Id">@customer.Name</option> }</select></label>
        <label class="grid gap-1 text-xs font-semibold text-slate-600" for="seller">Vendedor<select id="seller" class="min-h-10 rounded-xl border border-slate-200 bg-white px-3 text-sm" @bind="_sellerUserId" @bind:after="ResetCheckoutKey" disabled="@(_parkedSaleId is not null)"><option value="">Sin asignar</option>@foreach (var seller in _salespeople) { <option value="@seller.Id">@seller.DisplayName</option> }</select></label>
        <div class="max-h-64 overflow-auto border-y border-slate-100">
            @if (_cart.Count == 0) { <div class="grid place-items-center gap-1 px-3 py-8 text-center text-slate-500"><span class="text-xl text-brand-500">▣</span><strong class="text-sm text-ink">Tu orden está vacía</strong><p class="m-0 text-xs">Selecciona un producto para comenzar la venta.</p></div> }
            @foreach (var line in CartLines)
            {
                <div class="grid grid-cols-[2.25rem_minmax(0,1fr)_auto] items-start gap-2 border-b border-slate-100 py-3"><span class="grid size-9 shrink-0 place-items-center rounded-lg text-lg @ArtClass(line.Product.Category)">@ProductIcon(line.Product.Category)</span><div class="grid min-w-0 gap-1"><strong class="truncate text-xs text-ink">@line.Product.Name</strong><small class="text-xs text-muted">@Money(line.Product.UnitPrice) / unidad</small><div class="flex items-center gap-2"><button class="grid size-7 place-items-center rounded-md border border-slate-200 bg-white text-brand-700 disabled:opacity-40" @onclick="() => ChangeQuantity(line.Product, -1)" disabled="@(_parkedSaleId is not null)">−</button><span class="text-xs font-bold">@line.Quantity</span><button class="grid size-7 place-items-center rounded-md border border-slate-200 bg-white text-brand-700 disabled:opacity-40" @onclick="() => ChangeQuantity(line.Product, 1)" disabled="@(line.Quantity >= line.Product.StockOnHand || _parkedSaleId is not null)">＋</button></div>@if (_canApplyDiscount) { <label class="grid grid-cols-[minmax(0,1fr)_5rem] items-center gap-2 text-xs font-semibold text-slate-600">Descuento (%)<NumericInput aria-label="Descuento por producto (%)" @bind-Value="_discounts[line.Product.Id].Percent" @bind-Value:after="() => OnDiscountChanged(line.Product.Id)" min="0" max="100" step="0.01" disabled="@(_parkedSaleId is not null)" /></label> }@if (LineDiscount(line.Product, line.Quantity) > 0) { <small class="text-xs font-semibold text-amber-700">Descuento: −@Money(LineDiscount(line.Product, line.Quantity))</small> }</div><strong class="pt-1 text-right text-xs tabular-nums text-ink">@Money(NetLineTotal(line.Product, line.Quantity))</strong></div>
            }
        </div>
        <div class="grid gap-2 py-2 text-xs"><div class="flex justify-between text-slate-600"><span>Subtotal</span><strong>@Money(GrossSubtotal)</strong></div>@if (DiscountTotal > 0) { <div class="flex justify-between text-amber-700"><span>Descuento</span><strong>−@Money(DiscountTotal)</strong></div> }<div class="flex justify-between text-slate-600"><span>Base imponible</span><strong>@Money(Subtotal)</strong></div><div class="flex justify-between text-slate-600"><span>Impuesto</span><strong>@Money(Tax)</strong></div><div class="flex items-center justify-between border-t border-slate-100 pt-2 text-sm font-bold text-ink"><span>Total</span><strong class="font-display text-2xl">@Money(Total)</strong></div></div>
        <div class="grid gap-3">
            <label class="grid gap-1 text-xs font-semibold text-slate-600" for="sale-mode">Forma de venta<select id="sale-mode" class="min-h-10 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm" @bind="_isCredit" @bind:after="OnSaleModeChanged"><option value="false">Cobro inmediato</option><option value="true">A crédito</option></select></label>
            @if (_isCredit)
            {
                <label class="grid gap-1 text-xs font-semibold text-slate-600">Vencimiento<InputDate class="min-h-10 w-full rounded-xl border border-slate-200 px-3 text-sm" @bind-Value="_dueDate" @bind-Value:after="ResetCheckoutKey" /></label>
                <small class="text-xs leading-5 text-muted">El saldo quedará en cuentas por cobrar; no se suma a la caja hasta registrar un abono.</small>
            }
            else
            {
                <div class="grid gap-2">
                    <div class="flex items-center justify-between gap-2"><strong class="text-xs font-semibold text-slate-600">Distribución de pago</strong><button type="button" class="button button-secondary button-small" @onclick="AddTender" disabled="@(_tenders.Count >= 10 || _tenders.Count >= _paymentMethods.Count)">＋ Dividir pago</button></div>
                    @foreach (var tender in _tenders)
                    {
                        <div class="grid grid-cols-[minmax(0,1fr)_minmax(5rem,.75fr)_auto_auto] items-center gap-2">
                            <select class="min-h-10 min-w-0 w-full rounded-xl border border-slate-200 bg-white px-2 text-sm" aria-label="Medio de pago" @bind="tender.PaymentMethodId" @bind:after="ResetCheckoutKey">
                                @foreach (var method in AvailableMethods(tender)) { <option value="@method.Id">@method.Name</option> }
                            </select>
                            <NumericInput aria-label="Importe de pago" @bind-Value="tender.Amount" @bind-Value:after="ResetCheckoutKey" min="0.01" step="0.01" />
                            <span class="text-right text-xs font-semibold tabular-nums">@Money(tender.Amount)</span>
                            @if (_tenders.Count > 1) { <button type="button" class="grid size-8 place-items-center rounded-lg border border-slate-200 text-rose-700" @onclick="() => RemoveTender(tender)" aria-label="Quitar medio">×</button> }
                        </div>
                    }
                    @if (_paymentMethods.FirstOrDefault(x => x.Id == _tenders.FirstOrDefault()?.PaymentMethodId) is { } selected && (!string.IsNullOrWhiteSpace(selected.Instructions) || !string.IsNullOrWhiteSpace(selected.AccountLabel) || !string.IsNullOrWhiteSpace(selected.AccountReference) || !string.IsNullOrWhiteSpace(selected.QrPayload)))
                    {
                        <small class="rounded-lg bg-emerald-50 p-2 text-xs leading-5 text-emerald-900 [overflow-wrap:anywhere]">@selected.Instructions @selected.AccountLabel @selected.AccountReference @selected.QrPayload</small>
                    }
                    <small class="text-right text-xs font-semibold @(TenderBalance == 0 ? "text-emerald-700" : "text-amber-800")">
                        @if (TenderBalance == 0) { <span>Pago completo</span> }
                        else if (TenderBalance > 0) { <span>Falta @Money(TenderBalance)</span> }
                        else { <span>Exceso @Money(-TenderBalance)</span> }
                    </small>
                </div>
            }
        </div>
        <div class="flex flex-wrap items-center gap-2 border-t border-line pt-3 text-xs text-slate-500" aria-label="Atajos de teclado"><span class="font-semibold">Atajos:</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans text-xs">F2</kbd> Buscar</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans text-xs">F3</kbd> Cliente</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans text-xs">F4</kbd> Vendedor</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans text-xs">F6</kbd> Pago</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans text-xs">F9</kbd> Cobrar</span></div>
        <button id="pos-checkout" class="button button-primary flex min-h-11 w-full justify-between rounded-xl px-4 text-sm" @onclick="BeginCheckoutAsync" disabled="@(_cart.Count == 0 || _saving || (_isCredit ? (_customerId is null || _dueDate is null) : (_paymentMethods.Count == 0 || TenderBalance != 0 || _tenders.Any(x => x.Amount <= 0))))">@(_saving ? "Procesando…" : _isCredit ? "Crear cuenta · " + Money(Total) : CashOpen ? "Cobrar · " + Money(Total) : "Abrir turno y cobrar · " + Money(Total)) <span class="text-lg">→</span></button>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error">@_error</div> }
        <div class="text-center text-xs text-muted">▣ Transacción registrada de forma segura</div>
    </aside>
</div>
}
@if (_showOpeningPrompt) { <div class="modal-backdrop" @onclick="() => _showOpeningPrompt = false"><section class="modal-card cash-opening-modal" role="dialog" aria-modal="true" aria-labelledby="cash-opening-title" @onclick:stopPropagation="true"><div class="modal-heading"><div><span class="eyebrow">PUNTO DE VENTA · APERTURA</span><h2 id="cash-opening-title">Abre el turno para cobrar</h2><p>Terminal: @_registers.FirstOrDefault(x => x.Code == _registerCode)?.Name. El efectivo inicial se usará para el arqueo de caja.</p></div><button type="button" class="icon-button" @onclick="() => _showOpeningPrompt = false" aria-label="Cerrar">×</button></div><label class="cash-opening-amount">Efectivo inicial<NumericInput @bind-Value="_openingFloat" min="0" step="0.01" /></label>@if (!string.IsNullOrWhiteSpace(_openingError)) { <div class="inline-error" role="alert">@_openingError</div> }<div class="modal-actions"><button type="button" class="button button-secondary" @onclick="() => _showOpeningPrompt = false">Volver a la venta</button><button type="button" class="button button-primary" disabled="@_saving" @onclick="OpenShiftAndCheckoutAsync">@(_saving ? "Abriendo turno…" : "Abrir turno y cobrar")</button></div></section></div> }

@code {
    private List<ProductDto> _products = [];
    private List<CustomerDto> _customers = [];
    private List<TenantMemberDto> _salespeople = [];
    private List<PosRegisterDto> _registers = [];
    private IReadOnlyList<ParkedSaleDto> _parkedSales = [];
    private List<WarehouseDto> _warehouses = [];
    private CashSessionDto? _cashSession;
    private Guid _cashierUserId;
    private Guid? _lastSaleId;
    private Guid? _parkedSaleId;
    private long _parkedSaleRevision;
    private readonly Dictionary<Guid, int> _cart = [];
    private readonly Dictionary<Guid, CartDiscountForm> _discounts = [];
    private string _search = "";
    private string? _category, _subcategory, _error, _notice;
    private Guid? _customerId;
    private bool _isCredit;
    private bool _canApplyDiscount;
    private DateOnly? _dueDate = DateOnly.FromDateTime(DateTime.Today).AddDays(30);
    private Guid? _sellerUserId;
    private string _registerCode = "MAIN";
    private Guid _warehouseId;
    private IReadOnlyList<TenantPaymentMethodDto> _paymentMethods = [];
    private readonly List<TenderForm> _tenders = [];
    private bool _saving, _loading = true;
    private bool _showOpeningPrompt;
    private decimal _openingFloat;
    private string? _openingError;
    private string? _loadError;
    private Guid _checkoutKey = Guid.NewGuid();
    private Guid _parkKey = Guid.NewGuid();
    private decimal _taxRate = 0.18m;
    private IJSObjectReference? _shortcutsModule;
    private IReadOnlyList<string> _categories => _products.Select(x => ProductGroup(x.Category)).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToArray();
    private IReadOnlyList<string> _subcategories => _category is null ? [] : _products.Select(x => x.Category).Where(x => ProductGroup(x).Equals(_category, StringComparison.OrdinalIgnoreCase)).Select(ProductSubgroup).Where(x => x.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToArray();
    private IEnumerable<ProductDto> _filteredProducts => _products.Where(x => (_category is null || ProductGroup(x.Category).Equals(_category, StringComparison.OrdinalIgnoreCase)) && (_subcategory is null || ProductSubgroup(x.Category).Equals(_subcategory, StringComparison.OrdinalIgnoreCase)) && x.StockOnHand > 0);
    private IEnumerable<(ProductDto Product, int Quantity)> CartLines => _cart.Select(x => (_products.FirstOrDefault(p => p.Id == x.Key), x.Value)).Where(x => x.Item1 is not null).Select(x => (x.Item1!, x.Value));
    private decimal GrossSubtotal => CartLines.Sum(x => decimal.Round(x.Product.UnitPrice * x.Quantity, 2, MidpointRounding.AwayFromZero));
    private decimal DiscountTotal => CartLines.Sum(x => LineDiscount(x.Product, x.Quantity));
    private decimal Subtotal => GrossSubtotal - DiscountTotal;
    private decimal Tax => CartLines.Sum(x => decimal.Round(NetLineTotal(x.Product, x.Quantity) * (x.Product.TaxProfileRate ?? x.Product.TaxRateOverride ?? _taxRate), 2));
    private decimal Total => Subtotal + Tax;
    private decimal TenderBalance => decimal.Round(Total - _tenders.Sum(x => x.Amount), 2);
    private bool CashOpen => _cashSession?.Status == CashSessionStatus.Open;
    protected override Task OnInitializedAsync() => InitializeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _shortcutsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pos-shortcuts.js");
        await _shortcutsModule.InvokeVoidAsync("register");
    }

    public async ValueTask DisposeAsync()
    {
        if (_shortcutsModule is null)
            return;

        try
        {
            await _shortcutsModule.InvokeVoidAsync("unregister");
            await _shortcutsModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The Blazor circuit is already gone; the browser is cleaning up the page.
        }
    }
    private async Task InitializeAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var principal = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            _canApplyDiscount = principal.IsInRole("Administrator") || principal.IsInRole("Manager");
            if (!Guid.TryParse(principal.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier), out _cashierUserId))
                throw new InvalidOperationException("No se pudo identificar al cajero.");

            _registers = (await PosRegisters.GetRegistersAsync(includeInactive: false)).ToList();
            _warehouses = (await WarehouseService.GetAsync(includeInactive: false)).ToList();
            _salespeople = (await TenantUsers.GetActiveSalespeopleAsync()).ToList();
            if (_registers.All(x => x.Code != _registerCode)) _registerCode = _registers.FirstOrDefault()?.Code ?? "";
            _warehouseId = _registers.FirstOrDefault(x => x.Code == _registerCode)?.WarehouseId ?? Guid.Empty;
            _paymentMethods = await PaymentMethods.GetAsync(false);
            if (_tenders.Count == 0 && _paymentMethods.FirstOrDefault(x => x.Type == PaymentMethodType.Cash) is { } cashMethod)
                _tenders.Add(new(cashMethod.Id, 0));
            _taxRate = (await TenantSettings.GetAsync()).DefaultTaxRate;
            _cashSession = string.IsNullOrEmpty(_registerCode) ? null : await Store.GetCurrentCashSessionAsync(_registerCode);
            await RefreshParkedSalesAsync();
            await LoadProductsAsync();
            _customers = (await Store.SearchCustomersAsync(null)).ToList();
            ResetCheckoutKey();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo preparar el punto de venta.");
            _loadError = "No se pudo cargar la caja. Comprueba tu conexión y vuelve a intentarlo.";
        }
        finally
        {
            _loading = false;
        }
    }
    private async Task OnRegisterChangedAsync() { ResetCartState(); _error = null; _warehouseId = _registers.FirstOrDefault(x => x.Code == _registerCode)?.WarehouseId ?? Guid.Empty; _cashSession = string.IsNullOrEmpty(_registerCode) ? null : await Store.GetCurrentCashSessionAsync(_registerCode); await RefreshParkedSalesAsync(); await LoadProductsAsync(); }
    private async Task LoadProductsAsync() => _products = _warehouseId == Guid.Empty ? [] : (await Store.SearchProductsInWarehouseAsync(_search, _warehouseId)).ToList();
    private void ResetCheckoutKey() { _checkoutKey = Guid.NewGuid(); _parkKey = Guid.NewGuid(); if (_tenders.Count == 1) _tenders[0].Amount = Total; }
    private async Task RefreshParkedSalesAsync() => _parkedSales = string.IsNullOrWhiteSpace(_registerCode) ? [] : await ParkedSales.GetParkedSalesAsync(_registerCode);
    private IEnumerable<TenantPaymentMethodDto> AvailableMethods(TenderForm tender) => _paymentMethods.Where(m => m.Id == tender.PaymentMethodId || _tenders.All(x => x == tender || x.PaymentMethodId != m.Id));
    private void AddTender() { var available = _paymentMethods.FirstOrDefault(m => _tenders.All(x => x.PaymentMethodId != m.Id)); if (available is null) return; _tenders.Add(new(available.Id, 0)); ResetCheckoutKey(); }
    private void RemoveTender(TenderForm tender) { _tenders.Remove(tender); ResetCheckoutKey(); }
    private void Add(ProductDto product) { if (_cart.GetValueOrDefault(product.Id) < product.StockOnHand) { _cart[product.Id] = _cart.GetValueOrDefault(product.Id) + 1; _discounts.TryAdd(product.Id, new()); ResetCheckoutKey(); } _error = null; }
    private void ChangeQuantity(ProductDto product, int delta) { var quantity = _cart.GetValueOrDefault(product.Id) + delta; if (quantity <= 0) { _cart.Remove(product.Id); _discounts.Remove(product.Id); ResetCheckoutKey(); } else if (quantity <= product.StockOnHand) { _cart[product.Id] = quantity; ResetCheckoutKey(); } }
    private void ResetCartState() { _cart.Clear(); _discounts.Clear(); _parkedSaleId = null; _parkedSaleRevision = 0; _isCredit = false; _customerId = null; _sellerUserId = null; ResetCheckoutKey(); _error = null; }
    private async Task ClearCartAsync()
    {
        if (_parkedSaleId is { } parkedId)
        {
            try
            {
                await ParkedSales.CancelParkedSaleAsync(parkedId, _cashierUserId, new CancelParkedSaleRequest(_parkedSaleRevision));
                await RefreshParkedSalesAsync();
            }
            catch (DomainException ex) { _error = ex.Message; return; }
            catch (Exception ex) { Logger.LogError(ex, "No se pudo cancelar la venta en espera."); _error = "No se pudo cancelar la venta en espera. Actualiza la lista e inténtalo otra vez."; return; }
        }
        ResetCartState();
    }
    private async Task ParkCurrentSaleAsync()
    {
        if (_cart.Count == 0 || _parkedSaleId is not null) return;
        _saving = true; _error = null;
        try
        {
            var parked = await ParkedSales.ParkSaleAsync(new ParkSaleRequest(_parkKey, _registerCode, _customerId, _sellerUserId,
                _cart.Select(x => new ParkedSaleLineRequest(x.Key, x.Value, DiscountPercent(x.Key))).ToArray()), _cashierUserId);
            _notice = $"Venta guardada en espera · {parked.Lines.Sum(x => x.Quantity)} unidades";
            ResetCartState();
            await RefreshParkedSalesAsync();
        }
        catch (DomainException ex) { _error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo guardar la venta en espera."); _error = "No se pudo guardar la venta en espera. Puedes reintentar sin duplicar el registro."; }
        finally { _saving = false; }
    }
    private async Task ResumeParkedSaleAsync(ParkedSaleDto parked, bool edit)
    {
        if (_cart.Count > 0) { _error = "Vacía o guarda la venta actual antes de retomar otra."; return; }
        if (parked.CustomerId is { } customerId && _customers.All(x => x.Id != customerId)) { _error = "El cliente de esta venta ya no está disponible. Cancela la pendiente o pide a un administrador reactivarlo."; return; }
        if (parked.SellerUserId is { } sellerId && _salespeople.All(x => x.Id != sellerId)) { _error = "El vendedor asignado ya no está disponible. Cancela la pendiente o pide a un administrador reactivarlo."; return; }
        _saving = true; _error = null;
        try
        {
            var found = new List<(ParkedSaleLineDto Line, ProductDto Product)>();
            foreach (var line in parked.Lines)
            {
                var product = _products.FirstOrDefault(x => x.Id == line.ProductId);
                if (product is null)
                    product = (await Store.SearchProductsInWarehouseAsync(line.Sku, _warehouseId)).FirstOrDefault(x => x.Id == line.ProductId);
                if (product is null) { _error = $"El artículo {line.Sku} ya no está activo en este terminal; no se cargó la venta."; return; }
                found.Add((line, product));
            }
            if (edit)
            {
                var cancelled = await ParkedSales.CancelParkedSaleAsync(parked.Id, _cashierUserId, new CancelParkedSaleRequest(parked.Revision));
                if (cancelled.Status != ParkedSaleStatus.Cancelled) { _error = "La venta pendiente cambió mientras la retomabas. Actualiza la lista."; return; }
                await RefreshParkedSalesAsync();
            }
            ResetCartState();
            _customerId = parked.CustomerId;
            _sellerUserId = parked.SellerUserId;
            foreach (var item in found)
            {
                _cart[item.Line.ProductId] = item.Line.Quantity;
                _discounts[item.Line.ProductId] = new CartDiscountForm { Percent = item.Line.DiscountPercent };
            }
            if (!edit) { _parkedSaleId = parked.Id; _parkedSaleRevision = parked.Revision; }
            _notice = edit ? "Venta recuperada para editar · el registro pendiente se canceló" : "Venta en espera retomada · verifica existencias y precios antes de cobrar";
            ResetCheckoutKey();
        }
        catch (DomainException ex) { _error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo retomar la venta en espera."); _error = "No se pudo retomar la venta. Actualiza la lista e inténtalo de nuevo."; }
        finally { _saving = false; }
    }
    private async Task CancelParkedSaleAsync(ParkedSaleDto parked)
    {
        _saving = true; _error = null;
        try { await ParkedSales.CancelParkedSaleAsync(parked.Id, _cashierUserId, new CancelParkedSaleRequest(parked.Revision)); _notice = "Venta en espera cancelada"; await RefreshParkedSalesAsync(); }
        catch (DomainException ex) { _error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo cancelar la venta en espera."); _error = "No se pudo cancelar la venta. Actualiza la lista e inténtalo de nuevo."; }
        finally { _saving = false; }
    }
    private Task BeginCheckoutAsync()
    {
        if (!_isCredit && !CashOpen)
        {
            _openingError = null;
            _showOpeningPrompt = true;
            return Task.CompletedTask;
        }
        return CheckoutAsync();
    }
    private async Task OpenShiftAndCheckoutAsync()
    {
        if (_openingFloat < 0) { _openingError = "El efectivo inicial no puede ser negativo."; return; }
        _saving = true;
        _openingError = null;
        try
        {
            _cashSession = await Store.OpenCashSessionAsync(_cashierUserId, new OpenCashSessionRequest(_registerCode, _openingFloat));
            _showOpeningPrompt = false;
            _openingFloat = 0;
            await CheckoutAsync();
        }
        catch (DomainException ex) { _openingError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo abrir el turno desde el punto de venta."); _openingError = "No se pudo abrir el turno. Actualiza el estado de caja e inténtalo de nuevo."; }
        finally { _saving = false; }
    }
    private void OnDiscountChanged(Guid productId) { if (!_canApplyDiscount) _discounts[productId].Percent = 0m; ResetCheckoutKey(); }
    private decimal DiscountPercent(Guid productId) => _discounts.GetValueOrDefault(productId)?.Percent ?? 0m;
    private decimal LineDiscount(ProductDto product, int quantity) => decimal.Round(decimal.Round(product.UnitPrice * quantity, 2, MidpointRounding.AwayFromZero) * DiscountPercent(product.Id) / 100m, 2, MidpointRounding.AwayFromZero);
    private decimal NetLineTotal(ProductDto product, int quantity) => decimal.Round(product.UnitPrice * quantity, 2, MidpointRounding.AwayFromZero) - LineDiscount(product, quantity);
    private async Task CheckoutAsync() { _saving = true; _error = null; try { var sale = await Store.CheckoutAsync(new CheckoutRequest(_customerId, SummaryPaymentMethod, _cart.Select(x => new CheckoutLine(x.Key, x.Value, DiscountPercent(x.Key))).ToArray(), _checkoutKey, _registerCode, _isCredit ? [] : _tenders.Select(x => new CheckoutPaymentLine(x.PaymentMethodId, x.Amount, x.Reference)).ToArray(), _sellerUserId, _isCredit ? _dueDate : null, ParkedSaleId: _parkedSaleId), _cashierUserId); _notice = _isCredit ? $"Cuenta {sale.Number} creada · vence {sale.DueDate:dd/MM/yyyy}" : $"Venta {sale.Number} completada · {Money(sale.Total)}"; _lastSaleId = sale.Id; ResetCartState(); await RefreshParkedSalesAsync(); _cashSession = await Store.GetCurrentCashSessionAsync(_registerCode); await LoadProductsAsync(); } catch (DomainException ex) { _error = ex.Message; await LoadProductsAsync(); } catch (Exception ex) { Logger.LogError(ex, "No se pudo completar el checkout."); _error = "No se pudo completar la operación. Revisa la caja y el inventario e inténtalo de nuevo; el mismo intento se reconocerá al reintentar."; await LoadProductsAsync(); } finally { _saving = false; } }
    private PaymentMethod SummaryPaymentMethod => _isCredit ? PaymentMethod.Credit : _tenders.Count > 1 ? PaymentMethod.Other : _paymentMethods.FirstOrDefault(x => x.Id == _tenders.FirstOrDefault()?.PaymentMethodId)?.Type switch { PaymentMethodType.Cash => PaymentMethod.Cash, PaymentMethodType.Card => PaymentMethod.Card, PaymentMethodType.Transfer => PaymentMethod.Transfer, _ => PaymentMethod.Other };
    private void OnSaleModeChanged() { if (!_isCredit && _tenders.Count == 0 && _paymentMethods.FirstOrDefault(x => x.Type == PaymentMethodType.Cash) is { } cash) _tenders.Add(new(cash.Id, Total)); ResetCheckoutKey(); }
    private sealed class TenderForm(Guid paymentMethodId, decimal amount) { public Guid PaymentMethodId { get; set; } = paymentMethodId; public decimal Amount { get; set; } = amount; public string? Reference { get; set; } }
    private sealed class CartDiscountForm { public decimal Percent { get; set; } }
    private void SelectGroup(string group) { _category = group; _subcategory = null; }
    private string CategoryClass(string? value) => $"rounded-full border px-3 py-2 text-xs font-semibold whitespace-nowrap transition {(_category == value ? "border-brand-600 bg-brand-50 text-brand-700" : "border-slate-200 bg-white text-slate-600 hover:border-brand-300 hover:text-brand-700")}";
    private string SubcategoryClass(string? value) => $"rounded-full border px-3 py-2 text-xs font-semibold whitespace-nowrap transition {(_subcategory == value ? "border-brand-600 bg-brand-50 text-brand-700" : "border-slate-200 bg-white text-slate-600 hover:border-brand-300 hover:text-brand-700")}";
    private static string ProductGroup(string category) => category.Split(" / ", 2)[0];
    private static string ProductSubgroup(string category) { var parts = category.Split(" / ", 2); return parts.Length > 1 ? parts[1] : ""; }
    private static string Money(decimal amount) => DisplayFormat.Money(amount, showCents: true);
    private string TaxLabel(ProductDto product) => product.TaxRateOverride is { } rate ? rate == 0 ? "Exento" : $"Impuesto {rate * 100m:0.##}%" : $"Impuesto general {_taxRate * 100m:0.##}%";
    private static string ProductIcon(string category) => category.Contains("Café", StringComparison.OrdinalIgnoreCase) ? "☕" : category.Contains("Bebida", StringComparison.OrdinalIgnoreCase) ? "◉" : category.Contains("Accesorio", StringComparison.OrdinalIgnoreCase) ? "◌" : "✳";
    private static string ArtClass(string category) => category.Contains("Café", StringComparison.OrdinalIgnoreCase) ? "bg-amber-50 text-amber-800" : category.Contains("Bebida", StringComparison.OrdinalIgnoreCase) ? "bg-sky-50 text-sky-700" : category.Contains("Accesorio", StringComparison.OrdinalIgnoreCase) ? "bg-violet-50 text-violet-700" : "bg-emerald-50 text-emerald-700";
}


