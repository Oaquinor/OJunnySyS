@page "/app/pos"
@attribute [Authorize(Roles = "Administrator,Manager,Cashier")]
@inject StoreService Store
@inject TenantSettingsService TenantSettings
@inject PosRegisterService PosRegisters
@inject WarehouseService WarehouseService
@inject PosPaymentMethodService PaymentMethods
@inject TenantUserService TenantUsers
@inject AuthenticationStateProvider AuthenticationState
@inject ILogger<Pos> Logger

<PageTitle>Punto de venta · OjunnySyS</PageTitle>
<PageHeader Eyebrow="VENTAS / PUNTO DE VENTA" Title="Punto de venta" Description="Agrega productos, elige cómo cobrar y listo.">
    <Actions><div class="pos-terminal-select"><label for="pos-terminal">Terminal<select id="pos-terminal" @bind="_registerCode" @bind:after="OnRegisterChangedAsync"><option value="">Selecciona un terminal</option>@foreach (var register in _registers) { <option value="@register.Code">@register.Name</option> }</select></label></div><a class="register-status" href="/app/cash"><span class="@(CashOpen ? "online-dot" : "cash-closed-dot")"></span><span><strong>@(CashOpen ? "Caja abierta" : "Caja cerrada")</strong><small>@(_registers.FirstOrDefault(x => x.Code == _registerCode)?.Name ?? _registerCode) · @_warehouses.FirstOrDefault(x => x.Id == _warehouseId)?.Name · administrar</small></span></a></Actions>
</PageHeader>
@if (_loading)
{
    <div class="loading-panel" role="status">Preparando caja, terminales, impuestos y catálogo…</div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="inline-error cash-error" role="alert">@_loadError <button type="button" class="button button-secondary button-small" @onclick="InitializeAsync">Reintentar</button></div>
}
else
{
@if (!string.IsNullOrWhiteSpace(_notice)) { <div class="success-banner">✓ @_notice @if (_lastSaleId is { } saleId) { <a class="receipt-quick-link" href="/app/receipts/@saleId">Ver recibo</a> }<button @onclick="() => _notice = null">×</button></div> }
@if (!CashOpen && !string.IsNullOrEmpty(_registerCode)) { <div class="inline-error cash-error">Abre el turno de @_registers.FirstOrDefault(x => x.Code == _registerCode)?.Name antes de cobrar. <a href="/app/cash">Ir a caja y arqueo →</a></div> }
@if (_registers.Count == 0) { <div class="inline-error cash-error">No hay terminales POS activos. Pide al administrador que configure uno en <a href="/app/pos/registers">Terminales POS</a>.</div> }
<div class="pos-layout">
    <section class="pos-catalog">
        <div class="pos-search-row"><SearchField @bind-Value="_search" @bind-Value:after="LoadProductsAsync" CssClass="search-box pos-search" Placeholder="Buscar producto o escanear código…" /><span class="result-count">@_filteredProducts.Count() productos</span></div>
        <div class="category-tabs"><button class="@CategoryClass(null)" @onclick="() => _category = null">Todos</button>@foreach (var category in _categories) { <button class="@CategoryClass(category)" @onclick="() => _category = category">@category</button> }</div>
        <div class="pos-product-grid">
            @foreach (var product in _filteredProducts)
            {
                var inCart = _cart.GetValueOrDefault(product.Id);
                <button class="pos-product-card" @onclick="() => Add(product)" disabled="@(inCart >= product.StockOnHand)">
                    <span class="pos-product-art @ArtClass(product.Category)">@ProductIcon(product.Category)<span class="add-product">＋</span></span>
                    <span class="pos-product-info"><strong>@product.Name</strong><small>@product.Category · @_cart.GetValueOrDefault(product.Id) en orden · @TaxLabel(product)</small><b>@Money(product.UnitPrice)</b></span>
                    @if (product.StockOnHand <= 5) { <span class="stock-hint">Quedan @product.StockOnHand</span> }
                </button>
            }
        </div>
    </section>
    <aside class="order-panel">
        <div class="order-header"><div><span class="eyebrow">VENTA ACTUAL</span><h2>Tu orden <span class="order-count">@_cart.Values.Sum()</span></h2></div><button class="clear-button" @onclick="ClearCart" disabled="@(_cart.Count == 0)">Vaciar</button></div>
        <div class="customer-select"><label for="customer">Cliente</label><select id="customer" @bind="_customerId" @bind:after="ResetCheckoutKey"><option value="">Consumidor final</option>@foreach (var customer in _customers) { <option value="@customer.Id">@customer.Name</option> }</select></div>
        <div class="customer-select"><label for="seller">Vendedor</label><select id="seller" @bind="_sellerUserId" @bind:after="ResetCheckoutKey"><option value="">Sin asignar</option>@foreach (var seller in _salespeople) { <option value="@seller.Id">@seller.DisplayName</option> }</select></div>
        <div class="order-lines">
            @if (_cart.Count == 0) { <div class="cart-empty"><span>▣</span><strong>Tu orden está vacía</strong><p>Selecciona un producto para comenzar la venta.</p></div> }
            @foreach (var line in CartLines)
            {
                <div class="order-line"><span class="line-art @ArtClass(line.Product.Category)">@ProductIcon(line.Product.Category)</span><div class="line-details"><strong>@line.Product.Name</strong><small>@Money(line.Product.UnitPrice) / unidad</small><div class="quantity-control"><button @onclick="() => ChangeQuantity(line.Product, -1)">−</button><span>@line.Quantity</span><button @onclick="() => ChangeQuantity(line.Product, 1)" disabled="@(line.Quantity >= line.Product.StockOnHand)">＋</button></div>@if (_canApplyDiscount) { <label class="line-discount">Descuento (%)<NumericInput aria-label="Descuento por producto (%)" @bind-Value="_discounts[line.Product.Id].Percent" @bind-Value:after="() => OnDiscountChanged(line.Product.Id)" min="0" max="100" step="0.01" /></label> }@if (LineDiscount(line.Product, line.Quantity) > 0) { <small class="line-discount-total">Descuento: −@Money(LineDiscount(line.Product, line.Quantity))</small> }</div><strong class="line-total">@Money(NetLineTotal(line.Product, line.Quantity))</strong></div>
            }
        </div>
        <div class="order-summary"><div><span>Subtotal</span><strong>@Money(GrossSubtotal)</strong></div>@if (DiscountTotal > 0) { <div><span>Descuento</span><strong>−@Money(DiscountTotal)</strong></div> }<div><span>Base imponible</span><strong>@Money(Subtotal)</strong></div><div><span>Impuesto</span><strong>@Money(Tax)</strong></div><div class="grand-total"><span>Total</span><strong>@Money(Total)</strong></div></div>
        <div class="payment-method"><div class="payment-config-heading"><label for="sale-mode">Forma de venta</label></div><select id="sale-mode" @bind="_isCredit" @bind:after="OnSaleModeChanged"><option value="false">Cobro inmediato</option><option value="true">A crédito</option></select>
        @if (_isCredit) { <label class="customer-select">Vencimiento<InputDate @bind-Value="_dueDate" @bind-Value:after="ResetCheckoutKey" /></label><small>El saldo quedará en cuentas por cobrar; no se suma a la caja hasta registrar un abono.</small> }
        else { <div class="payment-config-heading"><label>Distribución de pago</label><button type="button" class="button button-secondary button-small" @onclick="AddTender" disabled="@(_tenders.Count >= 10 || _tenders.Count >= _paymentMethods.Count)">＋ Dividir pago</button></div>
            @foreach (var tender in _tenders) { <div class="pos-tender-row"><select aria-label="Medio de pago" @bind="tender.PaymentMethodId" @bind:after="ResetCheckoutKey">@foreach (var method in AvailableMethods(tender)) { <option value="@method.Id">@method.Name</option> }</select><NumericInput aria-label="Importe de pago" @bind-Value="tender.Amount" @bind-Value:after="ResetCheckoutKey" min="0.01" step="0.01" /><span>@Money(tender.Amount)</span>@if (_tenders.Count > 1) { <button type="button" class="icon-button" @onclick="() => RemoveTender(tender)" aria-label="Quitar medio">×</button> }</div> }
            @if (_paymentMethods.FirstOrDefault(x => x.Id == _tenders.FirstOrDefault()?.PaymentMethodId) is { } selected && (!string.IsNullOrWhiteSpace(selected.Instructions) || !string.IsNullOrWhiteSpace(selected.AccountLabel) || !string.IsNullOrWhiteSpace(selected.AccountReference) || !string.IsNullOrWhiteSpace(selected.QrPayload))) { <small class="payment-instructions">@selected.Instructions @selected.AccountLabel @selected.AccountReference @selected.QrPayload</small> }
            <small class="tender-balance">@if (TenderBalance == 0) { <span>Pago completo</span> } else if (TenderBalance > 0) { <span>Falta @Money(TenderBalance)</span> } else { <span>Exceso @Money(-TenderBalance)</span> }</small> }
        </div>
        <button class="button button-primary checkout-button" @onclick="CheckoutAsync" disabled="@(_cart.Count == 0 || _saving || (!_isCredit && !CashOpen) || (_isCredit ? (_customerId is null || _dueDate is null) : (_paymentMethods.Count == 0 || TenderBalance != 0 || _tenders.Any(x => x.Amount <= 0))))">@(_saving ? "Procesando…" : _isCredit ? "Crear cuenta · " + Money(Total) : "Cobrar · " + Money(Total)) <span>→</span></button>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error">@_error</div> }
        <div class="secure-note">▣ Transacción registrada de forma segura</div>
    </aside>
</div>
}

@code {
    private List<ProductDto> _products = [];
    private List<CustomerDto> _customers = [];
    private List<TenantMemberDto> _salespeople = [];
    private List<PosRegisterDto> _registers = [];
    private List<WarehouseDto> _warehouses = [];
    private CashSessionDto? _cashSession;
    private Guid _cashierUserId;
    private Guid? _lastSaleId;
    private readonly Dictionary<Guid, int> _cart = [];
    private readonly Dictionary<Guid, CartDiscountForm> _discounts = [];
    private string _search = "";
    private string? _category, _error, _notice;
    private Guid? _customerId;
    private bool _isCredit;
    private bool _canApplyDiscount;
    private DateOnly? _dueDate = DateOnly.FromDateTime(DateTime.Today).AddDays(30);
    private Guid? _sellerUserId;
    private string _registerCode = "MAIN";
    private Guid _warehouseId;
    private IReadOnlyList<TenantPaymentMethodDto> _paymentMethods = [];
    private readonly List<TenderForm> _tenders = [];
    private bool _saving, _loading = true;
    private string? _loadError;
    private Guid _checkoutKey = Guid.NewGuid();
    private decimal _taxRate = 0.18m;
    private IReadOnlyList<string> _categories => _products.Select(x => x.Category).Distinct().Order().ToArray();
    private IEnumerable<ProductDto> _filteredProducts => _products.Where(x => (_category is null || x.Category == _category) && x.StockOnHand > 0);
    private IEnumerable<(ProductDto Product, int Quantity)> CartLines => _cart.Select(x => (_products.FirstOrDefault(p => p.Id == x.Key), x.Value)).Where(x => x.Item1 is not null).Select(x => (x.Item1!, x.Value));
    private decimal GrossSubtotal => CartLines.Sum(x => decimal.Round(x.Product.UnitPrice * x.Quantity, 2, MidpointRounding.AwayFromZero));
    private decimal DiscountTotal => CartLines.Sum(x => LineDiscount(x.Product, x.Quantity));
    private decimal Subtotal => GrossSubtotal - DiscountTotal;
    private decimal Tax => CartLines.Sum(x => decimal.Round(NetLineTotal(x.Product, x.Quantity) * (x.Product.TaxRateOverride ?? _taxRate), 2, MidpointRounding.AwayFromZero));
    private decimal Total => Subtotal + Tax;
    private decimal TenderBalance => decimal.Round(Total - _tenders.Sum(x => x.Amount), 2);
    private bool CashOpen => _cashSession?.Status == CashSessionStatus.Open;
    protected override Task OnInitializedAsync() => InitializeAsync();
    private async Task InitializeAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var principal = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            _canApplyDiscount = principal.IsInRole("Administrator") || principal.IsInRole("Manager");
            if (!Guid.TryParse(principal.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier), out _cashierUserId))
                throw new InvalidOperationException("No se pudo identificar al cajero.");

            _registers = (await PosRegisters.GetRegistersAsync(includeInactive: false)).ToList();
            _warehouses = (await WarehouseService.GetAsync(includeInactive: false)).ToList();
            _salespeople = (await TenantUsers.GetActiveSalespeopleAsync()).ToList();
            if (_registers.All(x => x.Code != _registerCode)) _registerCode = _registers.FirstOrDefault()?.Code ?? "";
            _warehouseId = _registers.FirstOrDefault(x => x.Code == _registerCode)?.WarehouseId ?? Guid.Empty;
            _paymentMethods = await PaymentMethods.GetAsync(false);
            if (_tenders.Count == 0 && _paymentMethods.FirstOrDefault(x => x.Type == PaymentMethodType.Cash) is { } cashMethod)
                _tenders.Add(new(cashMethod.Id, 0));
            _taxRate = (await TenantSettings.GetAsync()).DefaultTaxRate;
            _cashSession = string.IsNullOrEmpty(_registerCode) ? null : await Store.GetCurrentCashSessionAsync(_registerCode);
            await LoadProductsAsync();
            _customers = (await Store.SearchCustomersAsync(null)).ToList();
            ResetCheckoutKey();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo preparar el punto de venta.");
            _loadError = "No se pudo cargar la caja. Comprueba tu conexión y vuelve a intentarlo.";
        }
        finally
        {
            _loading = false;
        }
    }
    private async Task OnRegisterChangedAsync() { ClearCart(); _error = null; _warehouseId = _registers.FirstOrDefault(x => x.Code == _registerCode)?.WarehouseId ?? Guid.Empty; _cashSession = string.IsNullOrEmpty(_registerCode) ? null : await Store.GetCurrentCashSessionAsync(_registerCode); await LoadProductsAsync(); }
    private async Task LoadProductsAsync() => _products = _warehouseId == Guid.Empty ? [] : (await Store.SearchProductsInWarehouseAsync(_search, _warehouseId)).ToList();
    private void ResetCheckoutKey() { _checkoutKey = Guid.NewGuid(); if (_tenders.Count == 1) _tenders[0].Amount = Total; }
    private IEnumerable<TenantPaymentMethodDto> AvailableMethods(TenderForm tender) => _paymentMethods.Where(m => m.Id == tender.PaymentMethodId || _tenders.All(x => x == tender || x.PaymentMethodId != m.Id));
    private void AddTender() { var available = _paymentMethods.FirstOrDefault(m => _tenders.All(x => x.PaymentMethodId != m.Id)); if (available is null) return; _tenders.Add(new(available.Id, 0)); ResetCheckoutKey(); }
    private void RemoveTender(TenderForm tender) { _tenders.Remove(tender); ResetCheckoutKey(); }
    private void Add(ProductDto product) { if (_cart.GetValueOrDefault(product.Id) < product.StockOnHand) { _cart[product.Id] = _cart.GetValueOrDefault(product.Id) + 1; _discounts.TryAdd(product.Id, new()); ResetCheckoutKey(); } _error = null; }
    private void ChangeQuantity(ProductDto product, int delta) { var quantity = _cart.GetValueOrDefault(product.Id) + delta; if (quantity <= 0) { _cart.Remove(product.Id); _discounts.Remove(product.Id); ResetCheckoutKey(); } else if (quantity <= product.StockOnHand) { _cart[product.Id] = quantity; ResetCheckoutKey(); } }
    private void ClearCart() { _cart.Clear(); _discounts.Clear(); ResetCheckoutKey(); _error = null; }
    private void OnDiscountChanged(Guid productId) { if (!_canApplyDiscount) _discounts[productId].Percent = 0m; ResetCheckoutKey(); }
    private decimal DiscountPercent(Guid productId) => _discounts.GetValueOrDefault(productId)?.Percent ?? 0m;
    private decimal LineDiscount(ProductDto product, int quantity) => decimal.Round(decimal.Round(product.UnitPrice * quantity, 2, MidpointRounding.AwayFromZero) * DiscountPercent(product.Id) / 100m, 2, MidpointRounding.AwayFromZero);
    private decimal NetLineTotal(ProductDto product, int quantity) => decimal.Round(product.UnitPrice * quantity, 2, MidpointRounding.AwayFromZero) - LineDiscount(product, quantity);
    private async Task CheckoutAsync() { _saving = true; _error = null; try { var sale = await Store.CheckoutAsync(new CheckoutRequest(_customerId, SummaryPaymentMethod, _cart.Select(x => new CheckoutLine(x.Key, x.Value, DiscountPercent(x.Key))).ToArray(), _checkoutKey, _registerCode, _isCredit ? [] : _tenders.Select(x => new CheckoutPaymentLine(x.PaymentMethodId, x.Amount, x.Reference)).ToArray(), _sellerUserId, _isCredit ? _dueDate : null), _cashierUserId); _notice = _isCredit ? $"Cuenta {sale.Number} creada · vence {sale.DueDate:dd/MM/yyyy}" : $"Venta {sale.Number} completada · {Money(sale.Total)}"; _lastSaleId = sale.Id; ClearCart(); _sellerUserId = null; _isCredit = false; _cashSession = await Store.GetCurrentCashSessionAsync(_registerCode); await LoadProductsAsync(); } catch (DomainException ex) { _error = ex.Message; await LoadProductsAsync(); } catch (Exception ex) { Logger.LogError(ex, "No se pudo completar el checkout."); _error = "No se pudo completar la operación. Revisa la caja y el inventario e inténtalo de nuevo; el mismo intento se reconocerá al reintentar."; await LoadProductsAsync(); } finally { _saving = false; } }
    private PaymentMethod SummaryPaymentMethod => _isCredit ? PaymentMethod.Credit : _tenders.Count > 1 ? PaymentMethod.Other : _paymentMethods.FirstOrDefault(x => x.Id == _tenders.FirstOrDefault()?.PaymentMethodId)?.Type switch { PaymentMethodType.Cash => PaymentMethod.Cash, PaymentMethodType.Card => PaymentMethod.Card, PaymentMethodType.Transfer => PaymentMethod.Transfer, _ => PaymentMethod.Other };
    private void OnSaleModeChanged() { if (!_isCredit && _tenders.Count == 0 && _paymentMethods.FirstOrDefault(x => x.Type == PaymentMethodType.Cash) is { } cash) _tenders.Add(new(cash.Id, Total)); ResetCheckoutKey(); }
    private sealed class TenderForm(Guid paymentMethodId, decimal amount) { public Guid PaymentMethodId { get; set; } = paymentMethodId; public decimal Amount { get; set; } = amount; public string? Reference { get; set; } }
    private sealed class CartDiscountForm { public decimal Percent { get; set; } }
    private string CategoryClass(string? value) => _category == value ? "category-tab active" : "category-tab";
    private static string Money(decimal amount) => DisplayFormat.Money(amount, showCents: true);
    private string TaxLabel(ProductDto product) => product.TaxRateOverride is { } rate ? rate == 0 ? "Exento" : $"Impuesto {rate * 100m:0.##}%" : $"Impuesto general {_taxRate * 100m:0.##}%";
    private static string ProductIcon(string category) => category.Contains("Café", StringComparison.OrdinalIgnoreCase) ? "☕" : category.Contains("Bebida", StringComparison.OrdinalIgnoreCase) ? "◉" : category.Contains("Accesorio", StringComparison.OrdinalIgnoreCase) ? "◌" : "✳";
    private static string ArtClass(string category) => category.Contains("Café", StringComparison.OrdinalIgnoreCase) ? "art-coffee" : category.Contains("Bebida", StringComparison.OrdinalIgnoreCase) ? "art-drink" : category.Contains("Accesorio", StringComparison.OrdinalIgnoreCase) ? "art-accessory" : "art-gift";
}


