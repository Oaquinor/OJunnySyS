@page "/app/receipts/{SaleId:guid}"
@attribute [Authorize(Roles = "Administrator,Manager,Cashier")]
@inject StoreService Store
@inject TenantSettingsService TenantConfig
@inject OJunnySyS.Application.Abstractions.IBusinessClock Clock
@inject OJunnySyS.Application.Services.PosPaymentMethodService PaymentMethods
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationState
@inject ILogger<Receipt> Logger
@inject IJSRuntime JS

<PageTitle>Recibo · OJunnySyS</PageTitle>
<PageHeader Eyebrow="VENTAS / RECIBO" Title="Comprobante de venta" Description="Consulta o imprime el detalle de esta transacción.">
    <Actions><a class="button button-secondary" href="/app/sales">Volver a ventas</a>@if (_receipt is not null) { <button class="button button-primary" @onclick="PrintAsync">Imprimir recibo</button> }</Actions>
</PageHeader>

@if (_loading) { <div class="panel receipt-loading">Cargando recibo…</div> }
else if (_receipt is null) { <EmptyState Icon="▤" Title="No encontramos este recibo" Description="La venta no existe o no pertenece a tu empresa." /> }
else
{
    <article class="receipt-paper receipt-@(_settings?.ReceiptDesign ?? "classic") receipt-font-@(_settings?.ReceiptFontFamily ?? "modern") @(_settings?.ReceiptCompactLineSpacing == true ? "receipt-compact-lines" : "")" style="--receipt-width:@((_settings?.ReceiptPaperWidthMm ?? 80) + "mm");--receipt-font-size:@((_settings?.ReceiptFontSize ?? 12) + "pt");--receipt-margin-left:@((_settings?.ReceiptMarginLeftMm ?? 0) + "mm");--receipt-margin-right:@((_settings?.ReceiptMarginRightMm ?? 0) + "mm")">
        <div class="receipt-content">
        <header class="receipt-brand"><span class="brand-mark">O<span>.</span></span><div><strong>@(_settings?.LegalName is { Length: > 0 } ? _settings.LegalName : _settings?.Name ?? "OJunnySyS")</strong><small>COMPROBANTE DE VENTA</small></div></header>
        @if (_settings is not null)
        {
            @if (!string.IsNullOrWhiteSpace(_settings.TaxIdentifier) || !string.IsNullOrWhiteSpace(_settings.BusinessPhone) || !string.IsNullOrWhiteSpace(_settings.BusinessAddress))
            {
                <div class="receipt-business">@if (!string.IsNullOrWhiteSpace(_settings.TaxIdentifier)) { <span>RNC: @_settings.TaxIdentifier</span> } @if (!string.IsNullOrWhiteSpace(_settings.BusinessPhone)) { <span>@_settings.BusinessPhone</span> } @if (!string.IsNullOrWhiteSpace(_settings.BusinessAddress)) { <span>@_settings.BusinessAddress</span> }</div>
            }
            @if (!string.IsNullOrWhiteSpace(_settings.ReceiptHeader)) { <div class="receipt-note">@_settings.ReceiptHeader</div> }
        }
        <div class="receipt-rule"></div>
        <div class="receipt-meta"><div><span>RECIBO</span><strong class="mono">@_receipt.Number</strong></div><div><span>FECHA</span><strong>@Clock.ToBusinessTime(_receipt.CreatedAtUtc).ToString("dd MMM yyyy · HH:mm")</strong></div><div><span>CAJA</span><strong>@(_receipt.RegisterCode ?? "—")</strong></div></div>
        @if (_settings?.ReceiptShowCustomer != false) { <div class="receipt-customer"><span>CLIENTE</span><strong>@_receipt.CustomerName</strong></div> }
        @if (!string.IsNullOrWhiteSpace(_receipt.SellerName)) { <div class="receipt-customer"><span>VENDEDOR</span><strong>@_receipt.SellerName</strong></div> }
        <div class="table-wrap"><table><thead><tr><th>ARTÍCULO</th><th class="align-right">CANT.</th>@if (_settings?.ReceiptShowUnitPrice != false) { <th class="align-right">PRECIO</th> }@if (_settings?.ReceiptShowLineTotals != false) { <th class="align-right">IMPORTE</th> }</tr></thead><tbody>@foreach (var line in _receipt.Lines) { <tr><td><strong>@line.ProductName</strong><small class="receipt-sku">Impuesto @($"{line.TaxRate * 100m:0.##}%")</small>@if (_settings?.ReceiptShowSku != false) { <small class="receipt-sku">@line.Sku</small> }</td><td class="align-right">@line.Quantity</td>@if (_settings?.ReceiptShowUnitPrice != false) { <td class="align-right">@Money(line.UnitPrice)</td> }@if (_settings?.ReceiptShowLineTotals != false) { <td class="align-right">@Money(line.LineTotal)</td> }</tr> }</tbody></table></div>
        <div class="receipt-totals"><div><span>Subtotal</span><strong>@Money(_receipt.Subtotal)</strong></div>@if (_settings?.ReceiptShowTax != false) { @foreach (var tax in _receipt.Lines.GroupBy(x => x.TaxRate).OrderBy(x => x.Key)) { <div><span>Impuesto (@($"{tax.Key * 100m:0.##}%"))</span><strong>@Money(tax.Sum(x => x.TaxAmount))</strong></div> } }<div class="receipt-grand"><span>Total</span><strong>@Money(_receipt.Total)</strong></div></div>
        <div class="receipt-payment"><span>FORMA DE PAGO</span><strong>@(_receipt.Payments is { Count: > 0 } ? string.Join(" + ", _receipt.Payments.Select(x => $"{x.MethodName}: {Money(x.Amount)}")) : DisplayFormat.PaymentLabel(_receipt.PaymentMethod))</strong></div>
        @if (_receipt.Status == SaleStatus.Voided) { <div class="receipt-void">VENTA ANULADA</div> }
        <footer>@(_settings?.ReceiptFooter is { Length: > 0 } ? _settings.ReceiptFooter : "Gracias por su compra.")<br /><small>Comprobante generado por OJunnySyS</small></footer>
        </div>
    </article>
    @if (_receipt.Status == SaleStatus.Completed)
    {
        <section class="panel return-panel no-print">
            <div><span class="eyebrow">POSTVENTA</span><h2>Devolución / nota de crédito</h2><p>Saldo por cobrar: <strong>@Money(_receipt.BalanceDue)</strong>. La devolución reintegra los artículos al almacén original.</p></div>
            @if (!string.IsNullOrWhiteSpace(_returnError)) { <div class="inline-error">@_returnError</div> }
            @if (!string.IsNullOrWhiteSpace(_returnNotice)) { <div class="success-banner">✓ @_returnNotice</div> }
            <div class="table-wrap"><table><thead><tr><th>ARTÍCULO</th><th>VENDIDO</th><th>DEVUELTO</th><th>DISPONIBLE</th><th>CANTIDAD A DEVOLVER</th></tr></thead><tbody>
                @foreach (var line in _receipt.Lines)
                {
                    var returned = Returned(line.SaleLineId);
                    var remaining = line.Quantity - returned;
                    <tr><td>@line.ProductName <small class="mono">@line.Sku</small></td><td>@line.Quantity</td><td>@returned</td><td>@remaining</td><td><input type="number" min="0" max="@remaining" step="1" @bind="_returnQuantities[line.SaleLineId]" @bind:after="ResetReturnKey" disabled="@(remaining == 0)" aria-label="Cantidad a devolver de @line.ProductName" /></td></tr>
                }
            </tbody></table></div>
            <div class="return-actions">
                <label>Medio de reembolso (solo si el valor ya fue pagado)<select @bind="_refundPaymentMethodId" @bind:after="ResetReturnKey"><option value="">Aplicar al saldo de la cuenta</option>@foreach (var method in _paymentMethods) { <option value="@method.Id">@method.Name</option> }</select></label>
                <span>Crédito estimado: <strong>@Money(ReturnEstimate)</strong></span>
                <button class="button button-primary" @onclick="SubmitReturnAsync" disabled="_returning || !HasReturnLines">@(_returning ? "Procesando…" : "Registrar devolución")</button>
            </div>
            @if (_receipt.Returns is { Count: > 0 })
            {
                <div class="return-history"><h3>Notas de crédito registradas</h3>@foreach (var item in _receipt.Returns.OrderByDescending(x => x.CreatedAtUtc)) { <p><strong class="mono">@item.Number</strong> · @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @Money(item.Total) @if (item.RefundAmount > 0) { <small>(reembolsado @Money(item.RefundAmount))</small> } else { <small>(aplicado a cartera)</small> }</p> }</div>
            }
        </section>
    }
}

@code {
    [Parameter] public Guid SaleId { get; set; }
    private SaleReceiptDto? _receipt;
    private TenantBusinessSettingsDto? _settings;
    private IReadOnlyList<TenantPaymentMethodDto> _paymentMethods = [];
    private readonly Dictionary<Guid, int> _returnQuantities = [];
    private Guid? _refundPaymentMethodId;
    private Guid? _returnIdempotencyKey;
    private string? _returnError, _returnNotice;
    private bool _returning;
    private bool HasReturnLines => _returnQuantities.Values.Any(x => x > 0);
    private decimal ReturnEstimate => _receipt is null ? 0m : decimal.Round(_receipt.Lines.Sum(x => (decimal)_returnQuantities.GetValueOrDefault(x.SaleLineId) * x.UnitPrice) + _receipt.Lines.Sum(x => decimal.Round((decimal)_returnQuantities.GetValueOrDefault(x.SaleLineId) * x.UnitPrice * x.TaxRate, 2, MidpointRounding.AwayFromZero)), 2, MidpointRounding.AwayFromZero);
    private int Returned(Guid saleLineId) => _receipt?.Returns?.SelectMany(x => x.Lines).Where(x => x.SaleLineId == saleLineId).Sum(x => x.Quantity) ?? 0;
    private bool _loading = true;
    protected override async Task OnParametersSetAsync() { _loading = true; _receipt = await Store.GetSaleReceiptAsync(SaleId); _settings = await TenantConfig.GetAsync(); _paymentMethods = await PaymentMethods.GetAsync(false); _returnQuantities.Clear(); if (_receipt is not null) foreach (var line in _receipt.Lines) _returnQuantities[line.SaleLineId] = 0; _loading = false; }
    private async Task SubmitReturnAsync()
    {
        if (_receipt is null || !HasReturnLines) return;
        _returning = true; _returnError = null; _returnNotice = null;
        try
        {
            var auth = await AuthenticationState.GetAuthenticationStateAsync();
            var actor = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!Guid.TryParse(actor, out var actorId)) throw new DomainException("No se pudo identificar al usuario activo.");
            var lines = _returnQuantities.Where(x => x.Value > 0).Select(x => new SaleReturnLineRequest(x.Key, x.Value)).ToArray();
            _returnIdempotencyKey ??= Guid.NewGuid();
            await Store.ReturnSaleAsync(SaleId, actorId, new CreateSaleReturnRequest(_returnIdempotencyKey.Value, lines, _refundPaymentMethodId));
            _returnNotice = "Devolución registrada con su nota de crédito y movimiento contable.";
            _receipt = await Store.GetSaleReceiptAsync(SaleId);
            foreach (var line in _receipt!.Lines) _returnQuantities[line.SaleLineId] = 0;
            _refundPaymentMethodId = null;
            _returnIdempotencyKey = null;
        }
        catch (DomainException ex) { _returnError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo registrar la devolución de {SaleId}.", SaleId); _returnError = "No se pudo registrar la devolución. Verifica la caja y vuelve a intentar."; }
        finally { _returning = false; }
    }
    private void ResetReturnKey() => _returnIdempotencyKey = null;
    private Task PrintAsync() => JS.InvokeVoidAsync("window.print").AsTask();
    private static string Money(decimal value) => DisplayFormat.Money(value, showCents: true);
}
