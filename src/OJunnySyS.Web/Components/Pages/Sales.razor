@page "/app/sales"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Manager,Cashier")]
@inject StoreService Store
@inject OJunnySyS.Application.Abstractions.IBusinessClock Clock

<PageTitle>Ventas · OjunnySyS</PageTitle>
<PageHeader Eyebrow="VENTAS / HISTORIAL" Title="Historial de ventas" Description="Consulta las transacciones recientes de tu punto de venta.">
    <Actions><a class="button button-secondary" href="/app/receivables">Cuentas por cobrar</a><a class="button button-secondary" href="/app/cash">Caja y arqueo</a><a class="button button-primary" href="/app/pos"><span>＋</span> Nueva venta</a></Actions>
</PageHeader>
<div class="panel list-panel"><div class="list-toolbar"><span class="result-count">Últimas @_sales.Count ventas</span><span class="payment-pill">Actualizado ahora</span></div>@if (_sales.Count == 0) { <EmptyState Icon="↗" Title="Aún no hay ventas" Description="Las ventas completadas aparecerán en este historial."><ChildContent><a class="button button-secondary" href="/app/pos">Abrir punto de venta</a></ChildContent></EmptyState> } else { <div class="table-wrap"><table><thead><tr><th>REFERENCIA</th><th>CLIENTE</th><th>VENDEDOR</th><th>FECHA</th><th>MÉTODO DE PAGO</th><th>ESTADO</th><th>RECIBO</th><th class="align-right">TOTAL</th><th class="align-right">SALDO</th></tr></thead><tbody>@foreach (var sale in _sales) { <tr><td class="mono">@sale.Number</td><td>@sale.CustomerName</td><td>@(sale.SellerName ?? "—")</td><td>@Clock.ToBusinessTime(sale.CreatedAtUtc).ToString("dd MMM yyyy, HH:mm")</td><td>@(sale.PaymentSummary ?? DisplayFormat.PaymentLabel(sale.PaymentMethod))</td><td><span class="status-pill @(sale.BalanceDue > 0 ? "status-warning" : "")"><i></i>@(sale.BalanceDue > 0 ? "Pendiente" : "Completada")</span></td><td><a href="/app/receipts/@sale.Id">Ver recibo ↗</a></td><td class="align-right amount">@Money(sale.Total)</td><td class="align-right">@Money(sale.BalanceDue)</td></tr> }</tbody></table></div> }</div>
@code {
    private List<SaleDto> _sales = [];
    protected override async Task OnInitializedAsync() => _sales = (await Store.GetRecentSalesAsync(100)).ToList();
    private static string Money(decimal amount) => DisplayFormat.Money(amount, showCents: true);
}


