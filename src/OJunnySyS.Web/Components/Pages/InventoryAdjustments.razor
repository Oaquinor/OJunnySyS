@page "/app/inventory/adjustments"
@attribute [Authorize(Roles = "Administrator,Manager")]
@inject StoreService Store
@inject WarehouseService Warehouses
@inject AccountingService Accounting
@inject AuthenticationStateProvider AuthenticationState
@inject IBusinessClock Clock
@inject ILogger<InventoryAdjustments> Logger

<PageTitle>Ajustes de inventario · OJunnySyS</PageTitle>
<PageHeader Eyebrow="INVENTARIO / CONTROL" Title="Ajustes de inventario" Description="Registra sobrantes, mermas y conteos físicos con motivo, saldos, valoración y asiento contable.">
    <Actions><a class="button button-secondary" href="/app/inventory/warehouses">Administrar almacenes</a><a class="button button-secondary" href="/app/reports">Ver reportes</a></Actions>
</PageHeader>

@if (_loading)
{
    <div class="loading-panel">Cargando existencias y cuentas contables…</div>
}
else
{
    @if (_notice is not null) { <div class="success-banner inventory-adjustment-notice" role="status">✓ @_notice</div> }
    @if (_error is not null) { <div class="inline-error inventory-adjustment-notice" role="alert">@_error</div> }

    <div class="inventory-adjustment-layout">
        <section class="panel inventory-adjustment-form">
            <div class="panel-heading"><div><span class="eyebrow">CONTROL DE EXISTENCIAS</span><h2>Nuevo ajuste</h2><p>Los movimientos no se borran. Cada operación queda ligada al usuario y la cuenta elegida.</p></div></div>
            @if (_warehouses.Count == 0 || _accounts.Count == 0)
            {
                <div class="inventory-adjustment-setup">
                    @if (_warehouses.Count == 0) { <p>Primero configura un almacén activo.</p> }
                    @if (_accounts.Count == 0) { <p>No hay cuentas contables activas para registrar la contrapartida.</p> }
                    <a class="button button-secondary" href="/app/accounting">Revisar contabilidad</a>
                </div>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <div class="inventory-adjustment-fields">
                        <label>Movimiento<InputSelect @bind-Value="_form.Direction" @bind:after="OnDirectionChanged"><option value="1">Aumentar sobrante</option><option value="-1">Disminuir pérdida / merma</option><option value="0">Conciliar conteo físico</option></InputSelect></label>
                        <label>Almacén<InputSelect @bind-Value="_form.WarehouseId" @bind:after="LoadWarehouseProductsAsync"><option value="@Guid.Empty">Selecciona almacén</option>@foreach (var warehouse in _warehouses) { <option value="@warehouse.Id">@warehouse.Name · @warehouse.Code</option> }</InputSelect></label>
                        <label class="inventory-field-wide">Producto<InputSelect @bind-Value="_form.ProductId"><option value="@Guid.Empty">Selecciona producto</option>@foreach (var item in _warehouseProducts) { <option value="@item.Id">@item.Name · @item.Sku</option> }</InputSelect></label>
                        @if (SelectedProduct is { } product)
                        {
                            <div class="inventory-balance-preview"><span>Saldo actual del almacén</span><strong>@product.StockOnHand unidades</strong><small>SKU @product.Sku</small></div>
                        }
                        @if (_form.Direction == 0)
                        {
                            <label>Cantidad contada físicamente<NumericInput @bind-Value="_form.CountedQuantity" min="0" step="1" /><small class="inventory-field-help">Si difiere, se calcula la variación con el saldo bloqueado del almacén. El sobrante usa el costo promedio vigente.</small></label>
                            <div class="inventory-cost-note"><span>Saldo del sistema</span><strong>@(SelectedProduct?.StockOnHand ?? 0) unidades</strong><small>La cantidad final será el conteo que ingreses.</small></div>
                        }
                        else
                        {
                            <label>Cantidad @(_form.Direction > 0 ? "a agregar" : "a retirar")<NumericInput @bind-Value="_form.Quantity" min="1" step="1" /></label>
                            @if (_form.Direction > 0)
                            {
                                <label>Costo unitario de entrada<NumericInput @bind-Value="_form.UnitCost" min="0" step="0.0001" /><small class="inventory-field-help">Se usa para recalcular el costo promedio del producto. RD$0 agrega unidades sin costo conocido.</small></label>
                            }
                            else
                            {
                                <div class="inventory-cost-note"><span>Costo de salida</span><strong>Costo promedio del producto</strong><small>El servidor toma el costo vigente y retira primero las unidades sin costo conocido.</small></div>
                            }
                        }
                        <label class="inventory-field-wide">Cuenta de contrapartida<InputSelect @bind-Value="_form.CounterAccountId"><option value="@Guid.Empty">Selecciona cuenta</option>@foreach (var account in EligibleAccounts) { <option value="@account.Id">@account.Code · @account.Name</option> }</InputSelect><small class="inventory-field-help">@(_form.Direction > 0 ? "El sobrante acredita ingreso u otro resultado." : _form.Direction < 0 ? "La pérdida se carga a gasto u otro resultado." : "El servidor valida la cuenta según la diferencia encontrada; si coincide el conteo, no crea asiento.")</small></label>
                        <label class="inventory-field-wide">Motivo<InputTextArea @bind-Value="_form.Reason" maxlength="240" placeholder="Conteo físico, merma, daño, pérdida u otra causa documentada" /></label>
                    </div>
                    <div class="inventory-accounting-hint">La valoración y el asiento se calculan en el servidor. El historial conserva el costo, la cuenta y los saldos usados.</div>
                        <div class="inventory-adjustment-actions"><button class="button button-primary" type="submit" disabled="@(_saving || _form.ProductId == Guid.Empty || _form.WarehouseId == Guid.Empty || _form.CounterAccountId == Guid.Empty)">@(_saving ? "Registrando…" : _form.Direction > 0 ? "Registrar sobrante" : _form.Direction < 0 ? "Registrar pérdida" : "Conciliar conteo")</button></div>
                </EditForm>
            }
        </section>

        <section class="panel inventory-adjustment-history">
            <div class="panel-heading"><div><span class="eyebrow">TRAZABILIDAD</span><h2>Ajustes recientes</h2><p>@_adjustments.Count registro(s) · el historial es de solo lectura.</p></div></div>
            @if (_adjustments.Count == 0)
            {
                <EmptyState Icon="↕" Title="No hay ajustes registrados" Description="Los saldos cambian mediante recepción, venta, devolución, traslado o un ajuste autorizado y documentado." />
            }
            else
            {
                <div class="table-wrap"><table><thead><tr><th>DOCUMENTO / PRODUCTO</th><th>ALMACÉN / USUARIO</th><th>CAMBIO</th><th>VALORACIÓN</th><th>ASIENTO / MOTIVO</th></tr></thead><tbody>
                    @foreach (var item in _adjustments)
                    {
                        <tr><td><strong class="mono">@item.Number</strong><small class="inventory-history-sub">@item.ProductName · @item.ProductSku</small></td><td>@item.WarehouseName<small class="inventory-history-sub">@item.ActorName · @ClockDate(item.CreatedAtUtc)</small></td><td><strong class="@(item.QuantityDelta > 0 ? "inventory-increase" : item.QuantityDelta < 0 ? "inventory-decrease" : "")">@(item.QuantityDelta > 0 ? "+" : "")@item.QuantityDelta</strong><small class="inventory-history-sub">@(item.CountedQuantity is null ? $"{item.BalanceBefore} → {item.BalanceAfter}" : $"Conteo: {item.CountedQuantity} · {item.BalanceBefore} → {item.BalanceAfter}")</small></td><td>@Money(item.ValuationAmount)<small class="inventory-history-sub">@item.CounterAccountCode · @item.CounterAccountName</small></td><td>@(item.JournalEntryNumber ?? "Sin asiento · valor cero")<small class="inventory-history-sub">@item.Reason</small></td></tr>
                    }
                </tbody></table></div>
            }
        </section>
    </div>
}

@code {
    private readonly AdjustmentForm _form = new();
    private IReadOnlyList<WarehouseDto> _warehouses = [];
    private IReadOnlyList<ProductDto> _warehouseProducts = [];
    private IReadOnlyList<ChartAccountDto> _accounts = [];
    private IReadOnlyList<InventoryAdjustmentDto> _adjustments = [];
    private Guid _actorId;
    private bool _loading = true, _saving;
    private string? _error, _notice;
    private ProductDto? SelectedProduct => _warehouseProducts.SingleOrDefault(x => x.Id == _form.ProductId);
    private IEnumerable<ChartAccountDto> EligibleAccounts => _accounts.Where(x => x.IsActive &&
        (_form.Direction == 0 ? x.Type is AccountType.Revenue or AccountType.Expense or AccountType.Equity :
            _form.Direction > 0 ? x.Type is AccountType.Revenue or AccountType.Equity : x.Type is AccountType.Expense or AccountType.Equity));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var principal = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            if (!Guid.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out _actorId)) throw new InvalidOperationException("La sesión no contiene un usuario válido.");
            var warehouseTask = Warehouses.GetAsync(includeInactive: false);
            var accountTask = Accounting.GetChartOfAccountsAsync();
            var historyTask = Store.GetInventoryAdjustmentsAsync(150);
            await Task.WhenAll(warehouseTask, accountTask, historyTask);
            _warehouses = await warehouseTask; _accounts = await accountTask; _adjustments = await historyTask;
            _form.WarehouseId = _warehouses.FirstOrDefault(x => x.Code == "MAIN")?.Id ?? _warehouses.FirstOrDefault()?.Id ?? Guid.Empty;
            await LoadWarehouseProductsAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo preparar la pantalla de ajustes de inventario."); _error = "No se pudieron cargar los datos necesarios para ajustar existencias."; }
        finally { _loading = false; }
    }

    private async Task LoadWarehouseProductsAsync()
    {
        _form.ProductId = Guid.Empty;
        _warehouseProducts = _form.WarehouseId == Guid.Empty ? [] : await Store.SearchProductsInWarehouseAsync(null, _form.WarehouseId);
    }

    private void OnDirectionChanged()
    {
        if (!EligibleAccounts.Any(x => x.Id == _form.CounterAccountId)) _form.CounterAccountId = Guid.Empty;
    }

    private async Task SubmitAsync()
    {
        _saving = true; _error = null; _notice = null;
        try
        {
            if (_form.ProductId == Guid.Empty || _form.WarehouseId == Guid.Empty || _form.CounterAccountId == Guid.Empty)
                throw new DomainException("Selecciona el producto, el almacén y una cuenta de contrapartida.");
            if (_form.Direction > 0 && _form.UnitCost is null) throw new DomainException("Indica el costo unitario para registrar el sobrante.");
            var isCount = _form.Direction == 0;
            var result = await Store.AdjustInventoryAsync(new InventoryAdjustmentRequest(_form.IdempotencyKey, _form.ProductId, _form.WarehouseId,
                isCount ? 0 : checked(_form.Quantity * _form.Direction), !isCount && _form.Direction > 0 ? _form.UnitCost : null,
                _form.CounterAccountId, _form.Reason, isCount ? _form.CountedQuantity : null), _actorId);
            _notice = isCount
                ? $"Conteo {result.Number} registrado. Sistema: {result.BalanceBefore} · Físico: {result.CountedQuantity} · Diferencia: {result.QuantityDelta:+#;-#;0}. Valor: {Money(result.ValuationAmount)}."
                : $"Ajuste {result.Number} registrado. Saldo: {result.BalanceBefore} → {result.BalanceAfter}. Valor: {Money(result.ValuationAmount)}.";
            _notice += result.JournalEntryNumber is null ? " No generó asiento porque la diferencia no tiene valor contable." : $" Asiento {result.JournalEntryNumber}.";
            _form.IdempotencyKey = Guid.NewGuid(); _form.Quantity = 1; _form.CountedQuantity = 0; _form.UnitCost = null; _form.Reason = string.Empty;
            await Task.WhenAll(RefreshHistoryAsync(), LoadWarehouseProductsAsync());
        }
        catch (DomainException ex) { _error = ex.Message; }
        catch (OverflowException) { _error = "La cantidad excede el límite permitido."; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo registrar el ajuste de inventario."); _error = "No se pudo guardar. Recarga el historial antes de volver a enviar el ajuste."; }
        finally { _saving = false; }
    }

    private async Task RefreshHistoryAsync() => _adjustments = await Store.GetInventoryAdjustmentsAsync(150);
    private static string Money(decimal value) => DisplayFormat.Money(value, showCents: true);
    private string ClockDate(DateTimeOffset value) => Clock.ToBusinessTime(value).ToString("dd/MM/yyyy HH:mm");

    private sealed class AdjustmentForm
    {
        public Guid IdempotencyKey { get; set; } = Guid.NewGuid();
        public int Direction { get; set; } = 1;
        public Guid WarehouseId { get; set; }
        public Guid ProductId { get; set; }
        [Range(1, int.MaxValue)] public int Quantity { get; set; } = 1;
        [Range(0, int.MaxValue)] public int CountedQuantity { get; set; }
        [Range(0, 9999999999.9999)] public decimal? UnitCost { get; set; }
        public Guid CounterAccountId { get; set; }
        [Required, StringLength(240, MinimumLength = 3)] public string Reason { get; set; } = string.Empty;
    }
}
