@page "/app/reports/financial-statements"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Manager")]
@inject AccountingService Accounting
@inject TenantSettingsService TenantSettings
@inject OJunnySyS.Application.Abstractions.IBusinessClock Clock

<PageTitle>Estados financieros · OJunnySyS</PageTitle>
<PageHeader Eyebrow="ANÁLISIS / CONTABILIDAD" Title="Estados financieros" Description="Consulta resultados por período y la situación financiera al corte desde los asientos publicados." />

<div class="my-4 mb-5 flex flex-wrap gap-2" aria-label="Estados financieros">
    <a class="button button-secondary" href="#resultados">Estado de resultados</a>
    <a class="button button-secondary" href="#situacion">Estado de situación financiera</a>
    <a class="button button-secondary" href="/app/accounting#balance">Balance de comprobación</a>
</div>
<section class="panel report-filter">
    <label>Desde<InputDate @bind-Value="_from" /></label>
    <label>Hasta / corte<InputDate @bind-Value="_to" /></label>
    <button class="button button-primary" @onclick="LoadAsync" disabled="@_loading">@(_loading ? "Generando…" : "Actualizar estados")</button>
    <small class="report-filter-note">Solo se incluyen asientos publicados del libro contable de esta empresa.</small>
</section>
@if (_error is not null) { <div class="inline-error" role="alert">@_error</div> }
@if (_profit is not null && _position is not null)
{
    <section class="panel mb-5 scroll-mt-5 p-4 sm:p-6" id="resultados">
        <div class="mb-4"><span class="eyebrow">@_profit.From.ToString("dd/MM/yyyy") — @_profit.To.ToString("dd/MM/yyyy")</span><h2 class="mt-1 font-display text-xl font-bold text-ink">Estado de resultados</h2><p class="mt-1 text-sm text-muted">Ingresos y gastos netos contabilizados dentro del período.</p></div>
        <div class="stats-grid report-stats">
            <MetricCard Label="INGRESOS" Value="@Money(_profit.TotalRevenue)" Icon="↗" Tone="green" />
            <MetricCard Label="GASTOS" Value="@Money(_profit.TotalExpenses)" Icon="↘" Tone="amber" />
            <MetricCard Label="UTILIDAD / PÉRDIDA" Value="@Money(_profit.NetIncome)" Icon="◈" Tone="blue" />
        </div>
        <div class="report-grid">
            <StatementTable Title="Ingresos" Lines="_profit.Revenue" Total="_profit.TotalRevenue" BaseAmount="_profit.TotalRevenue" CurrencyCode="_currencyCode" />
            <StatementTable Title="Gastos" Lines="_profit.Expenses" Total="_profit.TotalExpenses" BaseAmount="_profit.TotalRevenue" CurrencyCode="_currencyCode" />
        </div>
        @if (_comparisonProfit is not null)
        {
            <section class="mt-6 border-t border-slate-200 pt-5" aria-label="Comparación de resultados con el período anterior">
                <div class="mb-3"><span class="eyebrow">COMPARATIVO</span><h3 class="mt-1 font-display text-lg font-bold text-ink">Contra el período anterior</h3><p class="mt-1 text-sm text-muted">@_comparisonProfit.From.ToString("dd/MM/yyyy") — @_comparisonProfit.To.ToString("dd/MM/yyyy")</p></div>
                @foreach (var metric in ProfitComparisonMetrics())
                {
                    <div class="grid grid-cols-1 items-center gap-3 border-b border-slate-100 py-3 sm:grid-cols-[minmax(7rem,.7fr)_minmax(7rem,2fr)_auto_auto_auto]">
                        <strong>@metric.Label</strong>
                        <div class="grid gap-1" role="img" aria-label="@metric.Label: actual @Money(metric.Current), anterior @Money(metric.Previous)">
                            <span class="block h-2 min-w-0 rounded-full bg-emerald-600" style="width:@BarWidth(metric.Current, metric.Previous)%"></span>
                            <span class="block h-2 min-w-0 rounded-full bg-slate-300" style="width:@BarWidth(metric.Previous, metric.Current)%"></span>
                        </div>
                        <span class="text-right tabular-nums">@Money(metric.Current)</span><small class="text-right text-muted">Anterior: @Money(metric.Previous)</small><b class="text-right @ProfitChangeTone(metric)">@ChangeText(metric.Current, metric.Previous)</b>
                    </div>
                }
                <div class="mt-3 flex flex-wrap gap-4 text-xs text-muted"><span class="flex items-center gap-2"><i class="size-2.5 rounded-full bg-emerald-600"></i>Período actual</span><span class="flex items-center gap-2"><i class="size-2.5 rounded-full bg-slate-300"></i>Período anterior</span></div>
            </section>
        }
    </section>
    <section class="panel mb-5 scroll-mt-5 p-4 sm:p-6" id="situacion">
        <div class="mb-4"><span class="eyebrow">AL @(_position.AsOfDate.ToString("dd/MM/yyyy"))</span><h2 class="mt-1 font-display text-xl font-bold text-ink">Estado de situación financiera</h2><p class="mt-1 text-sm text-muted">Activos = pasivos + patrimonio, incluido el resultado acumulado de las cuentas de ingreso y gasto.</p></div>
        <div class="report-grid">
            <StatementTable Title="Activos" Lines="_position.Assets" Total="_position.TotalAssets" BaseAmount="_position.TotalAssets" CurrencyCode="_currencyCode" />
            <StatementTable Title="Pasivos" Lines="_position.Liabilities" Total="_position.TotalLiabilities" BaseAmount="_position.TotalAssets" CurrencyCode="_currencyCode" />
            <StatementTable Title="Patrimonio" Lines="_position.Equity" Total="_position.TotalEquity" BaseAmount="_position.TotalAssets" CurrencyCode="_currencyCode" />
        </div>
        <div class="report-row"><div><strong>Resultado acumulado</strong><small>Ingresos menos gastos contabilizados al corte</small></div><strong>@Money(_position.CurrentAndAccumulatedResult)</strong></div>
        <div class="report-row"><div><strong>Pasivos + patrimonio</strong><small>Debe cuadrar con el total de activos</small></div><strong>@Money(_position.TotalLiabilities + _position.TotalEquity)</strong></div>
        <div class="mt-4"><span class="font-bold @(_position.TotalAssets == _position.TotalLiabilities + _position.TotalEquity ? "text-emerald-700" : "text-rose-700")">@(_position.TotalAssets == _position.TotalLiabilities + _position.TotalEquity ? "Estado cuadrado" : "El estado presenta una diferencia; revisa el libro y las cuentas")</span></div>
        @if (_comparisonPosition is not null)
        {
            <section class="mt-6 border-t border-slate-200 pt-5" aria-label="Comparación de situación financiera con el año anterior">
                <div class="mb-3"><span class="eyebrow">COMPARATIVO ANUAL</span><h3 class="mt-1 font-display text-lg font-bold text-ink">Contra el mismo corte del año anterior</h3><p class="mt-1 text-sm text-muted">Al @_comparisonPosition.AsOfDate.ToString("dd/MM/yyyy")</p></div>
                @foreach (var metric in PositionComparisonMetrics())
                {
                    <div class="grid grid-cols-1 items-center gap-3 border-b border-slate-100 py-3 sm:grid-cols-[minmax(7rem,.7fr)_minmax(7rem,2fr)_auto_auto_auto]">
                        <strong>@metric.Label</strong>
                        <div class="grid gap-1" role="img" aria-label="@metric.Label: actual @Money(metric.Current), año anterior @Money(metric.Previous)">
                            <span class="block h-2 min-w-0 rounded-full bg-emerald-600" style="width:@BarWidth(metric.Current, metric.Previous)%"></span>
                            <span class="block h-2 min-w-0 rounded-full bg-slate-300" style="width:@BarWidth(metric.Previous, metric.Current)%"></span>
                        </div>
                        <span class="text-right tabular-nums">@Money(metric.Current)</span><small class="text-right text-muted">Año anterior: @Money(metric.Previous)</small><b class="text-right text-slate-600">@ChangeText(metric.Current, metric.Previous)</b>
                    </div>
                }
                <div class="mt-3 flex flex-wrap gap-4 text-xs text-muted"><span class="flex items-center gap-2"><i class="size-2.5 rounded-full bg-emerald-600"></i>Corte actual</span><span class="flex items-center gap-2"><i class="size-2.5 rounded-full bg-slate-300"></i>Corte anterior</span></div>
            </section>
        }
    </section>
}

@code {
    private DateOnly _from, _to;
    private string _currencyCode = "DOP";
    private string? _error;
    private bool _loading;
    private ProfitAndLossDto? _profit;
    private FinancialPositionDto? _position;
    private ProfitAndLossDto? _comparisonProfit;
    private FinancialPositionDto? _comparisonPosition;

    protected override async Task OnInitializedAsync()
    {
        _to = DateOnly.FromDateTime(Clock.ToBusinessTime(Clock.UtcNow).DateTime);
        _from = new DateOnly(_to.Year, _to.Month, 1);
        _currencyCode = (await TenantSettings.GetAsync()).CurrencyCode;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _profit = await Accounting.GetProfitAndLossAsync(_from, _to);
            _position = await Accounting.GetFinancialPositionAsync(_to);
            var periodDays = _to.DayNumber - _from.DayNumber + 1;
            var previousTo = _from.AddDays(-1);
            var previousFrom = previousTo.AddDays(-(periodDays - 1));
            _comparisonProfit = await Accounting.GetProfitAndLossAsync(previousFrom, previousTo);
            _comparisonPosition = await Accounting.GetFinancialPositionAsync(_to.AddYears(-1));
        }
        catch (DomainException ex) { _profit = null; _position = null; _comparisonProfit = null; _comparisonPosition = null; _error = ex.Message; }
        finally { _loading = false; }
    }

    private IEnumerable<(string Label, decimal Current, decimal Previous)> ProfitComparisonMetrics()
    {
        if (_profit is null || _comparisonProfit is null) yield break;
        yield return ("Ingresos", _profit.TotalRevenue, _comparisonProfit.TotalRevenue);
        yield return ("Gastos", _profit.TotalExpenses, _comparisonProfit.TotalExpenses);
        yield return ("Utilidad / pérdida", _profit.NetIncome, _comparisonProfit.NetIncome);
    }

    private IEnumerable<(string Label, decimal Current, decimal Previous)> PositionComparisonMetrics()
    {
        if (_position is null || _comparisonPosition is null) yield break;
        yield return ("Activos", _position.TotalAssets, _comparisonPosition.TotalAssets);
        yield return ("Pasivos", _position.TotalLiabilities, _comparisonPosition.TotalLiabilities);
        yield return ("Patrimonio", _position.TotalEquity, _comparisonPosition.TotalEquity);
    }

    private static decimal BarWidth(decimal value, decimal other)
        => FinancialStatementAnalysisBuilder.ComparisonBarWidth(value, other);

    private static string ChangeText(decimal current, decimal previous) =>
        FinancialStatementAnalysisBuilder.FormatPercentageChange(current, previous);

    private static string ChangeTone(decimal current, decimal previous, bool lowerIsBetter = false) =>
        (lowerIsBetter ? current <= previous : current >= previous) ? "text-emerald-700" : "text-rose-700";
    private static string ProfitChangeTone((string Label, decimal Current, decimal Previous) metric) =>
        ChangeTone(metric.Current, metric.Previous, metric.Label == "Gastos");
    private string Money(decimal value) => DisplayFormat.Money(value, _currencyCode);
}
