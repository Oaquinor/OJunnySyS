@page "/app/pos/registers"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]
@inject PosRegisterService Registers
@inject WarehouseService WarehouseService
@inject ILogger<PosRegisters> Logger

<PageTitle>Terminales POS · OJunnySyS</PageTitle>
<PageHeader Eyebrow="CONFIGURACIÓN / POS" Title="Sucursales y terminales" Description="Administra cajas independientes para tus puntos de venta.">
    <Actions><a class="button button-secondary" href="/app/inventory/warehouses">Administrar almacenes</a><a class="button button-secondary" href="/app/pos">Volver al punto de venta</a></Actions>
</PageHeader>

@if (_loading)
{
    <div class="loading-panel">Cargando terminales…</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_notice)) { <div class="success-banner">✓ @_notice</div> }
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error">@_error</div> }

    <div class="pos-register-layout">
        <section class="panel pos-register-list">
            <div class="panel-heading"><div><span class="eyebrow">PUNTOS DE ATENCIÓN</span><h2>Terminales configurados</h2><p>El código es permanente para conservar la trazabilidad de caja y ventas.</p></div></div>
            @if (_registers.Count == 0)
            {
                <EmptyState Icon="▣" Title="No hay terminales" Description="Crea un terminal para habilitar la caja y el punto de venta." />
            }
            else
            {
                <div class="table-wrap"><table><thead><tr><th>TERMINAL</th><th>CÓDIGO</th><th>ALMACÉN</th><th>ESTADO</th><th>ACCIONES</th></tr></thead><tbody>
                    @foreach (var register in _registers)
                    {
                        <tr>
                            <td><strong>@register.Name</strong></td><td><span class="mono">@register.Code</span></td><td>@(_warehouses.FirstOrDefault(x => x.Id == register.WarehouseId)?.Name ?? "Almacén inactivo")</td>
                            <td><span class="status-pill @(register.IsActive ? "" : "status-warning")"><i></i>@(register.IsActive ? "Activo" : "Inactivo")</span></td>
                            <td class="pos-register-actions"><button class="button button-secondary" @onclick="() => Select(register)">Editar nombre</button><button class="button @(register.IsActive ? "button-secondary" : "button-primary")" @onclick="() => ToggleActiveAsync(register)">@((register.IsActive ? "Desactivar" : "Activar"))</button></td>
                        </tr>
                    }
                </tbody></table></div>
            }
        </section>

        <section class="panel pos-register-form-panel">
            <div class="panel-heading"><div><span class="eyebrow">NUEVO PUNTO DE ATENCIÓN</span><h2>Crear terminal</h2><p>Asigna un código corto para usarlo al abrir caja y vender.</p></div></div>
            <EditForm Model="_createForm" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <div class="form-grid"><label>Código<InputText @bind-Value="_createForm.Code" maxlength="40" placeholder="SUCURSAL-02" /></label><label>Nombre visible<InputText @bind-Value="_createForm.Name" maxlength="120" placeholder="Sucursal Norte" /></label><label class="full-span">Almacén<select @bind="_createForm.WarehouseId"><option value="">Selecciona el almacén</option>@foreach (var warehouse in _warehouses) { <option value="@warehouse.Id">@warehouse.Name</option> }</select></label></div>
                <ValidationSummary />
                <button class="button button-primary" type="submit" disabled="@(_saving || _warehouses.Count == 0)">@(_saving ? "Creando…" : "Crear terminal")</button>
            </EditForm>

            @if (_editForm is not null)
            {
                <hr />
                <div class="panel-heading"><div><span class="eyebrow">EDITAR TERMINAL</span><h2>@_editForm.Code</h2></div></div>
                <EditForm Model="_editForm" OnValidSubmit="SaveNameAsync">
                    <DataAnnotationsValidator />
                    <div class="form-grid"><label>Nombre visible<InputText @bind-Value="_editForm.Name" maxlength="120" /></label><label>Almacén<select @bind="_editForm.WarehouseId">@foreach (var warehouse in _warehouses) { <option value="@warehouse.Id">@warehouse.Name</option> }</select></label></div>
                    <ValidationSummary />
                    <div class="modal-actions"><button class="button button-secondary" type="button" @onclick="CancelEdit">Cancelar</button><button class="button button-primary" type="submit" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar nombre")</button></div>
                </EditForm>
            }
        </section>
    </div>

    <p class="muted-foot pos-register-note">No se puede desactivar un terminal con turno abierto ni dejar la empresa sin terminales POS activos. Cada terminal vende desde el almacén asignado; cambia esa asignación únicamente con la caja cerrada.</p>
}

@code {
    private List<PosRegisterDto> _registers = [];
    private List<WarehouseDto> _warehouses = [];
    private CreateForm _createForm = new();
    private EditFormModel? _editForm;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _notice;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try { _warehouses = (await WarehouseService.GetAsync(includeInactive: false)).ToList(); _registers = (await Registers.GetRegistersAsync(includeInactive: true)).ToList(); if (_createForm.WarehouseId == Guid.Empty) _createForm.WarehouseId = _warehouses.FirstOrDefault(x => x.Code == "MAIN")?.Id ?? _warehouses.FirstOrDefault()?.Id ?? Guid.Empty; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudieron cargar los terminales POS."); _error = "No se pudieron cargar los terminales."; }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        _saving = true; _error = null; _notice = null;
        try { var register = await Registers.CreateAsync(new CreatePosRegisterRequest(_createForm.Code, _createForm.Name, _createForm.WarehouseId)); _createForm = new() { WarehouseId = _warehouses.FirstOrDefault(x => x.Code == "MAIN")?.Id ?? Guid.Empty }; _notice = $"Terminal {register.Name} creado."; await LoadAsync(); }
        catch (DomainException ex) { _error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo crear un terminal POS."); _error = "No se pudo crear el terminal."; }
        finally { _saving = false; }
    }

    private void Select(PosRegisterDto register) => _editForm = new EditFormModel { Id = register.Id, Code = register.Code, Name = register.Name, WarehouseId = register.WarehouseId, Revision = register.Revision };
    private void CancelEdit() => _editForm = null;

    private async Task SaveNameAsync()
    {
        if (_editForm is null) return;
        _saving = true; _error = null; _notice = null;
        try { await Registers.UpdateAsync(_editForm.Id, new UpdatePosRegisterRequest(_editForm.Name, _editForm.WarehouseId, _editForm.Revision)); _notice = "Terminal actualizado."; _editForm = null; await LoadAsync(); }
        catch (ConcurrencyConflictException ex) { _error = ex.Message; await LoadAsync(); }
        catch (DomainException ex) { _error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo actualizar el terminal POS."); _error = "No se pudo actualizar el terminal."; }
        finally { _saving = false; }
    }

    private async Task ToggleActiveAsync(PosRegisterDto register)
    {
        _saving = true; _error = null; _notice = null;
        try { await Registers.SetActiveAsync(register.Id, new SetPosRegisterActiveRequest(!register.IsActive, register.Revision)); _notice = register.IsActive ? "Terminal desactivado." : "Terminal activado."; await LoadAsync(); }
        catch (ConcurrencyConflictException ex) { _error = ex.Message; await LoadAsync(); }
        catch (DomainException ex) { _error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo cambiar el estado del terminal POS."); _error = "No se pudo actualizar el estado del terminal."; }
        finally { _saving = false; }
    }

    private sealed class CreateForm
    {
        [Required, StringLength(40, MinimumLength = 1), RegularExpression("^[A-Za-z0-9][A-Za-z0-9_-]*$", ErrorMessage = "Usa letras, números, guiones y guiones bajos.")]
        public string Code { get; set; } = "";
        [Required, StringLength(120, MinimumLength = 2)] public string Name { get; set; } = "";
        public Guid WarehouseId { get; set; }
    }

    private sealed class EditFormModel
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = "";
        public Guid WarehouseId { get; set; }
        [Required, StringLength(120, MinimumLength = 2)] public string Name { get; set; } = "";
        public long Revision { get; set; }
    }
}
