<div class="mb-4 flex items-center gap-3 px-2 pb-2 lg:mb-7 lg:pb-0">
    <div class="grid size-9 shrink-0 place-items-center rounded-xl bg-brand-600 font-display text-xl font-extrabold text-white">O<span class="text-emerald-200">.</span></div>
    <div class="flex min-w-0 flex-col"><strong class="font-display text-lg font-extrabold tracking-tight text-ink">ojunny<span class="text-brand-500">sys</span></strong><small class="text-xs font-bold tracking-[0.15em] text-muted">GESTIÓN COMERCIAL</small></div>
</div>

<nav class="grid max-h-[36dvh] grid-cols-2 gap-1 overflow-y-auto md:flex md:max-h-none md:flex-col md:overflow-visible" aria-label="Navegación principal">
    <span class="hidden px-3 pb-1 text-xs font-bold tracking-[0.12em] text-muted md:block md:pt-0">GENERAL</span>
    <NavItem Href="/app" Icon="⌂" Match="NavLinkMatch.All">Resumen</NavItem>
    <AuthorizeView Roles="Administrator,Manager">
        <NavItem Href="/app/customers" Icon="♧">Clientes <span class="ml-auto rounded bg-brand-100 px-1.5 py-0.5 text-xs font-bold text-brand-500">CRM</span></NavItem>
        <NavItem Href="/app/products" Icon="▦">Productos</NavItem>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator,Manager,Salesperson">
        <NavItem Href="/app/crm" Icon="↗">Oportunidades y tareas</NavItem>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator,Manager">
        <NavItem Href="/app/crm/segments" Icon="◉">Segmentos CRM</NavItem>
        <NavItem Href="/app/accounting" Icon="▤">Contabilidad</NavItem>
        <NavItem Href="/app/reports/financial-statements" Icon="▥">Estados financieros</NavItem>
        <NavItem Href="/app/banking" Icon="⌂">Bancos y conciliaciones</NavItem>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator">
        <NavItem Href="/app/workspace" Icon="◫">Mi empresa</NavItem>
        <NavItem Href="/app/users" Icon="♙">Usuarios y accesos</NavItem>
        <NavItem Href="/app/settings" Icon="⚙">Empresa e impuestos</NavItem>
        <NavItem Href="/app/inventory/warehouses" Icon="▤">Almacenes</NavItem>
        <NavItem Href="/app/pos/registers" Icon="▣">Terminales POS</NavItem>
        <NavItem Href="/app/settings/payments" Icon="＄">Medios de pago</NavItem>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator,Manager">
        <NavItem Href="/app/inventory/adjustments" Icon="↕">Ajustes de inventario</NavItem>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator,Manager,PurchasingAgent">
        <NavItem Href="/app/purchases" Icon="↗">Compras y proveedores</NavItem>
    </AuthorizeView>
    <span class="col-span-2 mt-3 hidden px-3 pb-1 text-xs font-bold tracking-[0.12em] text-muted md:col-span-1 md:block">VENTAS</span>
    <AuthorizeView Roles="Administrator,Manager,Salesperson">
        <NavItem Href="/app/sales/quotes" Icon="◇">Cotizaciones</NavItem>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator,Manager,Cashier">
        <NavItem Href="/app/cash" Icon="＄">Caja y arqueo</NavItem>
        <NavItem Href="/app/pos" Icon="▣">Punto de venta <span class="ml-auto text-xs text-emerald-500">●</span></NavItem>
        <NavItem Href="/app/sales" Icon="▤">Historial de ventas</NavItem>
        <NavItem Href="/app/receivables" Icon="＄">Cuentas por cobrar</NavItem>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator,Manager">
        <span class="col-span-2 mt-3 hidden px-3 pb-1 text-xs font-bold tracking-[0.12em] text-muted md:col-span-1 md:block">ANÁLISIS</span>
        <NavItem Href="/app/reports" Icon="▥">Reportes</NavItem>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator,Manager,Cashier,Salesperson">
        <NavItem Href="/app/reports/customer-statement" Icon="▤">Estado de cuenta</NavItem>
    </AuthorizeView>
</nav>

<div class="mt-3 border-t border-line pt-3 md:mt-auto">
    <AuthorizeView>
        <Authorized Context="auth">
            <div class="flex items-center gap-2">
                <div class="grid size-8 shrink-0 place-items-center rounded-full bg-brand-100 text-xs font-bold text-brand-500">@Initials(auth.User.Identity?.Name)</div>
                <div class="flex min-w-0 flex-1 flex-col gap-0.5"><strong class="truncate text-xs font-bold">@auth.User.Identity?.Name</strong><small class="text-xs text-muted">@RoleLabel(auth.User)</small></div>
                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <button class="rounded-md border border-line bg-white px-2 py-1.5 text-xs text-slate-600 hover:border-brand-100 hover:text-brand-600" type="submit" title="Cerrar sesión" aria-label="Cerrar sesión">Salir</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private static string Initials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "U";
        var pieces = value.Split(['@', '.', ' ', '-'], StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(pieces.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole("PlatformAdministrator") ? "Administración de plataforma" : user.IsInRole("Administrator") ? "Administrador" : user.IsInRole("Manager") ? "Gerente" : user.IsInRole("PurchasingAgent") ? "Compras" : user.IsInRole("Cashier") ? "Cajero" : "Usuario";
}

