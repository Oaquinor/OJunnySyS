<div class="@CssClass">
    <span aria-hidden="true">⌕</span>
    <input value="@Value" placeholder="@Placeholder" @oninput="HandleInputAsync" />
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Buscar…";
    [Parameter] public string CssClass { get; set; } = "search-box";

    private Task HandleInputAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");
}
