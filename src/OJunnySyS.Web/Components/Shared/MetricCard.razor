<article class="flex min-h-32 flex-col rounded-xl border border-line bg-white p-4">
    <div class="flex items-center justify-between gap-2 text-xs font-bold tracking-[0.09em] text-muted"><span>@Label</span><span class="grid size-7 place-items-center rounded-lg text-sm @ToneClasses">@Icon</span></div>
    <strong class="my-2 block font-display text-2xl font-bold tracking-tight text-ink">@Value</strong>
    <div class="flex items-center gap-2 text-xs text-muted">@ChildContent</div>
</article>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "•";
    [Parameter] public string Tone { get; set; } = "green";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ToneClasses => Tone switch
    {
        "lilac" => "bg-violet-50 text-violet-700",
        "blue" => "bg-sky-50 text-sky-700",
        "amber" => "bg-amber-50 text-amber-700",
        _ => "bg-brand-50 text-brand-500"
    };
}
