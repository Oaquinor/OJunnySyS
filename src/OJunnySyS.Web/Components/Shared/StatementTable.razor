<section class="panel report-panel">
    <div class="panel-heading"><div><h2>@Title</h2><p>@Lines.Count cuenta(s) con saldo en la consulta.</p></div></div>
    @if (Lines.Count == 0)
    {
        <EmptyState Icon="▤" Title="Sin movimientos" Description="No hay saldos contabilizados en esta sección para el período seleccionado." />
    }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>CÓDIGO</th><th>CUENTA</th><th class="align-right">ANÁLISIS VERTICAL</th><th class="align-right">SALDO</th></tr></thead><tbody>
            @foreach (var line in Lines) { <tr><td class="mono">@line.Code</td><td>@line.Name</td><td class="vertical-cell"><span>@FinancialStatementAnalysisBuilder.VerticalPercent(line.Amount, BaseAmount).ToString("0.0") %</span><span class="vertical-track" aria-hidden="true"><i style="width:@VerticalWidth(line.Amount)%"></i></span></td><td class="align-right amount">@Money(line.Amount)</td></tr> }
        </tbody><tfoot><tr><th colspan="2">TOTAL @Title.ToUpperInvariant()</th><th></th><th class="align-right">@Money(Total)</th></tr></tfoot></table></div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<FinancialStatementLineDto> Lines { get; set; } = [];
    [Parameter] public decimal Total { get; set; }
    [Parameter] public decimal BaseAmount { get; set; }
    [Parameter] public string CurrencyCode { get; set; } = "DOP";
    private decimal VerticalWidth(decimal amount) => Math.Min(100, Math.Abs(FinancialStatementAnalysisBuilder.VerticalPercent(amount, BaseAmount)));
    private string Money(decimal value) => DisplayFormat.Money(value, CurrencyCode);
}
