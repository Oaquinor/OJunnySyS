@page "/app/pos/client"
@attribute [Authorize(Roles = "Administrator,Manager,Cashier")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject PosApiClient PosApi
@inject AuthenticationStateProvider AuthenticationState
@inject IJSRuntime JS

<PageTitle>POS cliente · OJunnySyS</PageTitle>
<main class="grid gap-5">
    <header class="flex flex-wrap items-end justify-between gap-4">
        <div class="grid gap-1"><span class="text-xs font-bold tracking-[.14em] text-brand-600">PUNTO DE VENTA · CLIENTE WEBASSEMBLY</span><h1 class="font-display text-3xl font-bold tracking-tight text-ink">POS de respuesta rápida</h1><p class="text-sm text-slate-600">Esta pantalla corre en el navegador y usa la API protegida de OJunnySyS.</p></div>
        <label class="grid min-w-52 gap-1.5 text-sm font-semibold text-slate-700">Terminal<select class="min-h-11 rounded-xl border border-slate-200 bg-white px-3" value="@_registerCode" @onchange="ChangeRegisterAsync"><option value="">Selecciona una terminal</option>@foreach (var register in _registers) { <option value="@register.Code">@register.Name</option> }</select></label>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error)) { <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800">@_error</div> }
    @if (!string.IsNullOrWhiteSpace(_notice)) { <div role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900">@_notice</div> }
    @if (_lastSaleId is { } saleId) { <a class="w-fit rounded-lg font-semibold text-brand-700 underline underline-offset-4" href="/app/receipts/@saleId">Abrir e imprimir el recibo</a> }
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950"><span><strong>@(_online ? "Conectado" : "Sin conexión")</strong> · Las ventas solo se registran cuando el servidor confirma la transacción.@if (_cart.Count > 0 && _offlineDraftSaved) { <span class="font-semibold"> Borrador cifrado guardado en este dispositivo; pendiente de revisión y confirmación.</span> }</span><a class="font-semibold underline" href="/app/pos">Abrir POS actual</a></div>
    @if (!string.IsNullOrWhiteSpace(_offlineStorageError)) { <div role="status" class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">@_offlineStorageError</div> }
    @if (_parkedSaleId is not null) { <div class="rounded-xl border border-sky-200 bg-sky-50 p-3 text-sm text-sky-900"><strong>Venta retomada</strong> · Sus artículos y descuentos están protegidos hasta cobrar o cancelar esta espera.</div> }
    @if (_parkedSales.Count > 0)
    {
        <section class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4">
            <div class="flex items-center justify-between gap-3"><div><h2 class="font-display text-lg font-bold text-ink">Ventas en espera</h2><p class="text-xs text-slate-500">Terminal @_registerCode · @_parkedSales.Count pendientes</p></div><button type="button" class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold" @onclick="RefreshParkedSalesAsync" disabled="@_busy">Actualizar</button></div>
            @foreach (var parked in _parkedSales)
            {
                <article class="grid gap-3 rounded-xl border border-slate-100 bg-slate-50 p-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
                    <div class="grid min-w-0 gap-1"><strong class="text-sm text-ink">@parked.CustomerName</strong><span class="text-xs text-slate-600">@parked.Lines.Sum(x => x.Quantity) artículos · @string.Join(" · ", parked.Lines.Select(x => $"{x.Quantity} {x.ProductName}"))</span><small class="text-xs text-slate-500">Guardada @parked.CreatedAtUtc.ToLocalTime().ToString("g")</small></div>
                    @if (!_canApplyDiscount && parked.Lines.Any(x => x.DiscountPercent > 0m)) { <small class="text-xs text-amber-800">Esta venta tiene descuentos; solo un administrador o gerente puede retomarla con sus descuentos.</small> }
                    <div class="flex flex-wrap gap-2"><button type="button" class="rounded-lg bg-brand-600 px-3 py-2 text-xs font-bold text-white disabled:opacity-50" @onclick="() => ResumeParkedSaleAsync(parked, false)" disabled="@(!_online || _busy || _cart.Count > 0 || _parkedSaleId is not null || (!_canApplyDiscount && parked.Lines.Any(x => x.DiscountPercent > 0m)) )">Retomar</button><button type="button" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 disabled:opacity-50" @onclick="() => ResumeParkedSaleAsync(parked, true)" disabled="@(!_online || _busy || _cart.Count > 0 || _parkedSaleId is not null)">Editar</button><button type="button" class="rounded-lg border border-rose-200 bg-white px-3 py-2 text-xs font-semibold text-rose-700 disabled:opacity-50" @onclick="() => CancelParkedSaleAsync(parked)" disabled="@(!_online || _busy)">Cancelar</button></div>
                </article>
            }
        </section>
    }

    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-sm text-slate-500" role="status">Cargando productos, terminales y caja…</div>
    }
    else
    {
        <div class="grid min-w-0 gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(20rem,24rem)]">
            <section class="grid min-w-0 gap-4">
                <form class="flex flex-wrap gap-2" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <input id="pos-search" class="min-h-11 min-w-48 flex-1 rounded-xl border border-slate-200 px-3 text-sm" @bind="_search" placeholder="Buscar por nombre, SKU o código de barras" aria-label="Buscar productos" />
                    <button class="min-h-11 rounded-xl bg-brand-600 px-4 text-sm font-bold text-white disabled:opacity-50" type="submit" disabled="@_busy">Buscar</button>
                </form>
                @if (_registers.Count == 0) { <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">No hay terminales activas configuradas para esta empresa.</div> }
                else if (_products.Count == 0) { <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">No encontramos productos disponibles para esta terminal.</div> }
                else
                {
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 2xl:grid-cols-3">
                        @foreach (var product in _products)
                        {
                            var quantity = _cart.GetValueOrDefault(product.Id);
                            <button type="button" class="grid min-h-32 content-between gap-3 rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-sm transition hover:border-brand-300 hover:shadow-md disabled:cursor-not-allowed disabled:opacity-50" @onclick="() => AddAsync(product)" disabled="@(quantity >= product.StockOnHand || _busy || _parkedSaleId is not null)">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl)) { <img class="h-24 w-full rounded-xl bg-slate-50 object-contain" src="@product.ImageUrl" alt="Imagen de @product.Name" loading="lazy" /> }
                                <span class="grid gap-1"><strong class="text-sm text-ink">@product.Name</strong><small class="text-xs text-slate-500">@product.Sku · @_cart.GetValueOrDefault(product.Id) en orden</small></span>
                                <span class="flex items-end justify-between gap-3"><strong class="text-lg font-bold text-brand-700">@Money(product.UnitPrice)</strong><small class="text-xs text-slate-500">Disponible: @product.StockOnHand</small></span>
                            </button>
                        }
                    </div>
                }
            </section>

            <aside class="grid h-fit gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-3"><div><span class="text-xs font-bold tracking-widest text-slate-400">VENTA ACTUAL</span><h2 class="font-display text-xl font-bold text-ink">Orden</h2><span class="text-xs font-semibold @(_cashSession?.Status == CashSessionStatus.Open ? "text-emerald-700" : "text-amber-800")">@(_cashSession?.Status == CashSessionStatus.Open ? "Turno abierto" : "Turno cerrado") · @_registerCode</span></div><div class="flex items-center gap-2"><a class="text-xs font-semibold text-brand-700 underline" href="/app/cash">Administrar caja</a><span class="rounded-full bg-brand-50 px-3 py-1 text-sm font-bold text-brand-700">@_cart.Values.Sum()</span></div></div>
                @if (_cart.Count == 0) { <p class="rounded-xl bg-slate-50 p-4 text-sm text-slate-500">Agrega productos para iniciar una venta.</p> }
                else
                {
                    <div class="grid gap-2">
                        @foreach (var entry in _cart.ToArray())
                        {
                            var product = _cartProducts.GetValueOrDefault(entry.Key);
                            if (product is null) { continue; }
                            <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 border-b border-slate-100 py-2"><span class="grid min-w-0 gap-1"><strong class="truncate text-sm text-ink">@product.Name</strong><small class="text-xs text-slate-500">@entry.Value × @Money(product.UnitPrice)</small>@if (_canApplyDiscount) { <label class="grid max-w-32 gap-1 text-xs font-semibold text-slate-600">Descuento (%)<input type="number" min="0" max="100" step="0.01" class="min-h-9 rounded-lg border border-slate-200 px-2 text-xs" value="@DiscountPercent(product.Id).ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="e => SetDiscount(product.Id, e.Value?.ToString())" disabled="@(_busy || _parkedSaleId is not null)" /></label> }<small class="text-xs font-semibold text-brand-700">Importe: @Money(LineTotal(product, entry.Value))</small></span><span class="flex items-center gap-1"><button type="button" class="grid size-8 place-items-center rounded-lg border border-slate-200 disabled:opacity-40" @onclick="() => ChangeQuantityAsync(product, -1)" disabled="@(_parkedSaleId is not null)" aria-label="Quitar uno">−</button><strong class="w-6 text-center text-sm">@entry.Value</strong><button type="button" class="grid size-8 place-items-center rounded-lg border border-slate-200 disabled:opacity-40" @onclick="() => ChangeQuantityAsync(product, 1)" disabled="@(_parkedSaleId is not null || entry.Value >= product.StockOnHand)" aria-label="Agregar uno">+</button></span></div>
                        }
                    </div>
                }
                <label class="grid gap-1.5 text-sm font-semibold text-slate-700">Cliente<select id="customer" class="min-h-11 rounded-xl border border-slate-200 bg-white px-3" @bind="_customerId" @bind:after="ResetOrderKeys" disabled="@(_parkedSaleId is not null)"><option value="">Consumidor final</option>@foreach (var customer in _customers) { <option value="@customer.Id">@customer.Name</option> }</select></label>
                <label class="grid gap-1.5 text-sm font-semibold text-slate-700">Vendedor<select id="seller" class="min-h-11 rounded-xl border border-slate-200 bg-white px-3" @bind="_sellerId" @bind:after="ResetOrderKeys" disabled="@(_parkedSaleId is not null)"><option value="">Sin asignar</option>@foreach (var seller in _sellers) { <option value="@seller.Id">@seller.DisplayName</option> }</select></label>
                <label class="grid gap-1.5 text-sm font-semibold text-slate-700">Forma de venta<select id="sale-mode" class="min-h-11 rounded-xl border border-slate-200 bg-white px-3" @bind="_isCredit" @bind:after="OnSaleModeChanged" disabled="@(_parkedSaleId is not null)"><option value="false">Cobro inmediato</option><option value="true">A crédito</option></select></label>
                @if (_isCredit)
                {
                    <label class="grid gap-1.5 text-sm font-semibold text-slate-700">Vencimiento<InputDate class="min-h-11 rounded-xl border border-slate-200 bg-white px-3 text-sm" @bind-Value="_dueDate" @bind-Value:after="ResetCheckoutKey" disabled="@(_parkedSaleId is not null)" /></label>
                }
                else
                {
                    <div class="grid gap-2 sm:col-span-2">
                        <div class="flex items-center justify-between gap-3"><strong class="text-sm text-slate-700">Distribución de pago</strong><button type="button" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 disabled:opacity-50" @onclick="AddTender" disabled="@(_busy || _parkedSaleId is not null || _tenders.Count >= 10 || _tenders.Count >= _paymentOptions.Count)">＋ Dividir pago</button></div>
                        @foreach (var tender in _tenders)
                        {
                            <div class="grid grid-cols-[minmax(0,1fr)_minmax(6rem,.55fr)_auto] items-center gap-2">
                                <select aria-label="Medio de pago" class="min-h-11 min-w-0 rounded-xl border border-slate-200 bg-white px-3 text-sm" @bind="tender.PaymentMethodId" @bind:after="ResetCheckoutKey" disabled="@(_busy || _parkedSaleId is not null)">@foreach (var method in AvailableMethods(tender)) { <option value="@method.Id">@method.Name</option> }</select>
                                <InputNumber aria-label="Importe del medio de pago" min="0" step="0.01" class="min-h-11 min-w-0 rounded-xl border border-slate-200 px-3 text-sm" @bind-Value="tender.Amount" @bind-Value:after="ResetCheckoutKey" disabled="@(_busy || _parkedSaleId is not null)" />
                                @if (_tenders.Count > 1) { <button type="button" class="grid size-9 place-items-center rounded-lg border border-slate-200 text-slate-600" @onclick="() => RemoveTender(tender)" disabled="@(_busy || _parkedSaleId is not null)" aria-label="Quitar medio de pago">×</button> }
                            </div>
                        }
                        <small class="text-xs font-semibold @(TenderBalance == 0 ? "text-emerald-700" : "text-amber-800")">@(TenderBalance == 0 ? "Pago completo" : TenderBalance > 0 ? $"Falta {Money(TenderBalance)}" : $"Exceso {Money(-TenderBalance)}")</small>
                    </div>
                }
                <div class="grid gap-2 border-t border-slate-200 pt-4 text-sm"><div class="flex items-center justify-between text-slate-600"><span>Subtotal</span><span>@Money(GrossSubtotal)</span></div>@if (DiscountTotal > 0m) { <div class="flex items-center justify-between text-rose-700"><span>Descuento</span><span>−@Money(DiscountTotal)</span></div> }<div class="flex items-center justify-between text-slate-600"><span>Base imponible</span><span>@Money(NetSubtotal)</span></div><div class="flex items-center justify-between text-slate-600"><span>Impuestos</span><span>@Money(TaxTotal)</span></div><div class="flex items-center justify-between border-t border-slate-100 pt-2 font-bold text-ink"><span>Total estimado</span><strong class="text-2xl">@Money(EstimatedTotal)</strong></div></div>
                <small class="text-xs leading-5 text-slate-500">El borrador de la orden se conserva cifrado por empresa y usuario. Sin conexión no se confirma venta ni recibo; al volver, revisa el catálogo actualizado y confirma para que el servidor valide precios, caja, impuestos e inventario. El crédito requiere cliente y vencimiento.</small>
                <div class="flex flex-wrap items-center gap-2 border-t border-slate-200 pt-3 text-xs text-slate-500" aria-label="Atajos de teclado"><span class="font-semibold">Atajos:</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans">F2</kbd> Buscar</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans">F3</kbd> Cliente</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans">F4</kbd> Vendedor</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans">F6</kbd> Pago</span><span><kbd class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans">F9</kbd> Cobrar</span></div>
                <div class="flex flex-wrap gap-2"><button id="pos-checkout" type="button" class="min-h-11 flex-1 rounded-xl bg-brand-600 px-4 text-sm font-bold text-white disabled:cursor-not-allowed disabled:opacity-50" @onclick="CheckoutAsync" disabled="@(!CanCheckout)">@(_busy ? "Procesando…" : _isCredit ? "Crear cuenta · " + Money(EstimatedTotal) : "Completar venta")</button><button type="button" class="min-h-11 rounded-xl border border-slate-200 px-3 text-sm font-semibold text-slate-600 disabled:opacity-50" @onclick="ParkCurrentSaleAsync" disabled="@(!_online || _cart.Count == 0 || _busy || _parkedSaleId is not null || _isCredit)">En espera</button><button type="button" class="min-h-11 rounded-xl border border-slate-200 px-3 text-sm font-semibold text-slate-600 disabled:opacity-50" @onclick="ClearCartAsync" disabled="@(_cart.Count == 0 || _busy)">Vaciar</button></div>
            </aside>
        </div>
    }
</main>

@code {
    private IReadOnlyList<PosRegisterDto> _registers = [];
    private IReadOnlyList<ProductDto> _products = [];
    private IReadOnlyList<CustomerDto> _customers = [];
    private IReadOnlyList<TenantMemberDto> _sellers = [];
    private IReadOnlyList<TenantPaymentMethodDto> _paymentOptions = [];
    private IReadOnlyList<ParkedSaleDto> _parkedSales = [];
    private TenantBusinessSettingsDto? _settings;
    private CashSessionDto? _cashSession;
    private readonly Dictionary<Guid, int> _cart = [];
    private readonly Dictionary<Guid, ProductDto> _cartProducts = [];
    private readonly Dictionary<Guid, decimal> _discounts = [];
    private readonly List<TenderForm> _tenders = [];
    private string _registerCode = string.Empty, _search = string.Empty;
    private Guid? _customerId, _sellerId, _parkedSaleId;
    private DateOnly? _dueDate = DateOnly.FromDateTime(DateTime.Today).AddDays(30);
    private bool _loading = true, _busy, _online = true, _isCredit, _canApplyDiscount;
    private string? _error, _notice;
    private Guid _checkoutKey = Guid.NewGuid();
    private Guid _parkKey = Guid.NewGuid();
    private Guid? _lastSaleId;
    private DotNetObjectReference<PosClientPage>? _self;
    private IJSObjectReference? _networkModule;
    private IJSObjectReference? _shortcutsModule;
    private IJSObjectReference? _offlineModule;
    private OfflineDraft? _offlineDraft;
    private bool _offlineDraftSaved;
    private string? _offlineStorageError;
    private string _currencyCode = "DOP";
    private decimal _defaultTaxRate;

    private decimal GrossSubtotal => _cart.Sum(item =>
    {
        var product = _cartProducts.GetValueOrDefault(item.Key);
        if (product is null) return 0m;
        return decimal.Round(product.UnitPrice * item.Value, 2, MidpointRounding.AwayFromZero);
    });
    private decimal NetSubtotal => _cart.Sum(item => _cartProducts.TryGetValue(item.Key, out var product) ? LineTotal(product, item.Value) : 0m);
    private decimal DiscountTotal => GrossSubtotal - NetSubtotal;
    private decimal TaxTotal => _cart.Sum(item =>
    {
        var product = _cartProducts.GetValueOrDefault(item.Key);
        if (product is null) return 0m;
        var rate = product.TaxProfileRate ?? product.TaxRateOverride ?? _settings?.DefaultTaxRate ?? _defaultTaxRate;
        return decimal.Round(LineTotal(product, item.Value) * rate, 2);
    });
    private decimal EstimatedTotal => NetSubtotal + TaxTotal;
    private decimal TenderBalance => decimal.Round(EstimatedTotal - _tenders.Sum(x => x.Amount), 2, MidpointRounding.AwayFromZero);
    private bool CanCheckout => !_busy && _online && _cart.Count > 0 && _cartProducts.Count == _cart.Count && !string.IsNullOrWhiteSpace(_registerCode) &&
        (_isCredit ? _customerId is not null && _dueDate is not null : _cashSession?.Status == CashSessionStatus.Open && _tenders.Count > 0 &&
            _tenders.All(x => x.PaymentMethodId != Guid.Empty && x.Amount > 0m) && _tenders.Select(x => x.PaymentMethodId).Distinct().Count() == _tenders.Count && TenderBalance == 0m);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var principal = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            _canApplyDiscount = principal.IsInRole("Administrator") || principal.IsInRole("Manager");
            _currencyCode = principal.FindFirst("currency_code")?.Value ?? "DOP";
            if (decimal.TryParse(principal.FindFirst("default_tax_rate")?.Value, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var tenantTaxRate))
                _defaultTaxRate = tenantTaxRate;
            try
            {
                var userId = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var tenantId = principal.FindFirst("tenant_id")?.Value;
                if (!string.IsNullOrWhiteSpace(userId) && !string.IsNullOrWhiteSpace(tenantId))
                {
                    _offlineModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pos-offline-drafts.js");
                    await _offlineModule.InvokeVoidAsync("initialize", userId, tenantId);
                    _offlineDraft = await _offlineModule.InvokeAsync<OfflineDraft?>("loadDraft");
                    if (_offlineDraft is not null && _offlineDraft.SavedAtUtc < DateTimeOffset.UtcNow.AddDays(-7))
                    {
                        await _offlineModule.InvokeVoidAsync("clearDraft");
                        _offlineDraft = null;
                    }
                    var cachedCatalog = await _offlineModule.InvokeAsync<OfflineCatalog?>("loadCatalog");
                    if (cachedCatalog is not null)
                    {
                        _products = cachedCatalog.Products;
                        _registers = [cachedCatalog.Register];
                        _registerCode = cachedCatalog.Register.Code;
                        _currencyCode = cachedCatalog.CurrencyCode;
                        _defaultTaxRate = cachedCatalog.DefaultTaxRate;
                    }
                    RestoreDraft(_offlineDraft);
                }
                else _offlineStorageError = "No se guardará una orden sin asociarla a la empresa y usuario de la sesión.";
            }
            catch (JSException) { _offlineStorageError = "El navegador no habilitó el almacenamiento cifrado del borrador. La orden solo permanecerá en esta pantalla."; }
            var registersTask = PosApi.GetRegistersAsync();
            var methodsTask = PosApi.GetPaymentOptionsAsync();
            var sellersTask = PosApi.GetSellersAsync();
            var settingsTask = PosApi.GetBusinessSettingsAsync();
            var customersTask = PosApi.SearchCustomersAsync();
            await Task.WhenAll(registersTask, methodsTask, sellersTask, settingsTask, customersTask);
            _registers = await registersTask;
            _paymentOptions = await methodsTask;
            _sellers = await sellersTask;
            _settings = await settingsTask;
            _customers = await customersTask;
            if (_paymentOptions.FirstOrDefault(x => x.Type == PaymentMethodType.Cash) is { } cashMethod)
                _tenders.Add(new TenderForm(cashMethod.Id, 0m));
            else if (_paymentOptions.FirstOrDefault() is { } firstMethod)
                _tenders.Add(new TenderForm(firstMethod.Id, 0m));
            _registerCode = _registers.FirstOrDefault(x => x.Code == _offlineDraft?.RegisterCode)?.Code ?? _registers.FirstOrDefault()?.Code ?? string.Empty;
            await LoadRegisterAsync();
            RestoreDraft(_offlineDraft);
            if (_offlineDraftSaved) ResetCheckoutKey();
        }
        catch (Exception ex) { _online = false; _error = _products.Count > 0 ? "Trabajando con el último catálogo cifrado de este dispositivo. Las ventas no pueden confirmarse hasta reconectar." : ex.Message; }
        finally { _loading = false; }

        _self = DotNetObjectReference.Create(this);
        _networkModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pos-network-status.js");
        await _networkModule.InvokeVoidAsync("watch", _self);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _shortcutsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pos-shortcuts.js");
        await _shortcutsModule.InvokeVoidAsync("register");
    }

    private async Task ChangeRegisterAsync(ChangeEventArgs args)
    {
        _registerCode = args.Value?.ToString() ?? string.Empty;
        ResetCartState(); _error = null;
        await ClearOfflineDraftAsync();
        await LoadRegisterAsync();
    }

    private async Task LoadRegisterAsync()
    {
        if (string.IsNullOrWhiteSpace(_registerCode)) { _products = []; _cashSession = null; _parkedSales = []; return; }
        var register = _registers.First(x => x.Code == _registerCode);
        var productsTask = PosApi.SearchProductsAsync(register.WarehouseId, _search);
        var cashTask = PosApi.GetCashSessionAsync(_registerCode);
        var parkedTask = PosApi.GetParkedSalesAsync(_registerCode);
        await Task.WhenAll(productsTask, cashTask, parkedTask);
        _products = await productsTask;
        _cashSession = await cashTask;
        _parkedSales = await parkedTask;
        if (_offlineModule is not null && _registers.FirstOrDefault(x => x.Code == _registerCode) is { } selectedRegister)
        {
            try
            {
                var cachedProducts = string.IsNullOrWhiteSpace(_search) ? _products : await PosApi.SearchProductsAsync(selectedRegister.WarehouseId, null);
                await _offlineModule.InvokeVoidAsync("saveCatalog", new OfflineCatalog(selectedRegister, cachedProducts, _currencyCode, _settings?.DefaultTaxRate ?? _defaultTaxRate));
            }
            catch (JSException) { _offlineStorageError = "No se pudo actualizar el catálogo cifrado sin conexión."; }
        }
    }

    private async Task SearchAsync()
    {
        _error = null;
        try { await LoadRegisterAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task AddAsync(ProductDto product)
    {
        if (_parkedSaleId is not null || _cart.GetValueOrDefault(product.Id) >= product.StockOnHand) return;
        _cart[product.Id] = _cart.GetValueOrDefault(product.Id) + 1;
        _cartProducts[product.Id] = product;
        ResetOrderKeys(); _error = null;
        await PersistOfflineDraftAsync();
    }

    private async Task ChangeQuantityAsync(ProductDto product, int delta)
    {
        if (_parkedSaleId is not null) return;
        var quantity = _cart.GetValueOrDefault(product.Id) + delta;
        if (quantity <= 0) { _cart.Remove(product.Id); _cartProducts.Remove(product.Id); _discounts.Remove(product.Id); }
        else if (quantity <= product.StockOnHand) _cart[product.Id] = quantity;
        ResetOrderKeys();
        await PersistOfflineDraftAsync();
    }

    private async Task ClearCartAsync()
    {
        if (_parkedSaleId is { } parkedId)
        {
            var parked = _parkedSales.FirstOrDefault(x => x.Id == parkedId);
            if (parked is not null) await CancelParkedSaleAsync(parked);
            else { _error = "Actualiza las ventas en espera antes de cancelar la venta retomada."; }
            return;
        }
        ResetCartState();
        await ClearOfflineDraftAsync();
    }

    private async Task ParkCurrentSaleAsync()
    {
        if (!_online || _busy || _cart.Count == 0 || _parkedSaleId is not null) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var parked = await PosApi.ParkSaleAsync(new ParkSaleRequest(_parkKey, _registerCode, _customerId, _sellerId,
                _cart.Select(x => new ParkedSaleLineRequest(x.Key, x.Value, DiscountPercent(x.Key))).ToArray()));
            _notice = $"Venta guardada en espera · {parked.Lines.Sum(x => x.Quantity)} artículos";
            ResetCartState();
            await ClearOfflineDraftAsync();
            await LoadRegisterAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ResumeParkedSaleAsync(ParkedSaleDto parked, bool edit)
    {
        if (_cart.Count > 0 || _busy || _parkedSaleId is not null) return;
        if (parked.CustomerId is { } customerId && _customers.All(x => x.Id != customerId)) { _error = "El cliente de esta venta ya no está disponible."; return; }
        if (parked.SellerUserId is { } sellerId && _sellers.All(x => x.Id != sellerId)) { _error = "El vendedor asignado ya no está disponible."; return; }
        _busy = true; _error = null;
        try
        {
            var found = new List<(ParkedSaleLineDto Line, ProductDto Product)>();
            var warehouseId = _registers.First(x => x.Code == _registerCode).WarehouseId;
            foreach (var line in parked.Lines)
            {
                var product = _products.FirstOrDefault(x => x.Id == line.ProductId)
                    ?? (await PosApi.SearchProductsAsync(warehouseId, line.Sku)).FirstOrDefault(x => x.Id == line.ProductId);
                if (product is null) { _error = $"El artículo {line.Sku} ya no está disponible en esta terminal."; return; }
                if (product.StockOnHand < line.Quantity) { _error = $"Existencia insuficiente para {line.Sku}; hay {product.StockOnHand} disponibles."; return; }
                found.Add((line, product));
            }
            if (edit)
            {
                await PosApi.CancelParkedSaleAsync(parked.Id, new CancelParkedSaleRequest(parked.Revision));
            }
            ResetCartState();
            _customerId = parked.CustomerId;
            _sellerId = parked.SellerUserId;
            foreach (var item in found)
            {
                _cart[item.Line.ProductId] = item.Line.Quantity;
                _cartProducts[item.Line.ProductId] = item.Product;
                _discounts[item.Line.ProductId] = item.Line.DiscountPercent;
            }
            if (!edit) _parkedSaleId = parked.Id;
            _notice = edit ? "Venta recuperada para editar · precios y existencias se recalcularán al cobrar." : "Venta retomada · verifica los datos antes de cobrar.";
            ResetCheckoutKey();
            if (edit) await LoadRegisterAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CancelParkedSaleAsync(ParkedSaleDto parked)
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            await PosApi.CancelParkedSaleAsync(parked.Id, new CancelParkedSaleRequest(parked.Revision));
            if (_parkedSaleId == parked.Id) ResetCartState();
            _notice = "Venta en espera cancelada";
            await LoadRegisterAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task RefreshParkedSalesAsync() => LoadRegisterAsync();

    private async Task CheckoutAsync()
    {
        if (!CanCheckout) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var request = new CheckoutRequest(_customerId, SummaryPaymentMethod,
                _cart.Select(item => new CheckoutLine(item.Key, item.Value, DiscountPercent(item.Key))).ToArray(), _checkoutKey, _registerCode,
                _isCredit ? [] : _tenders.Select(x => new CheckoutPaymentLine(x.PaymentMethodId, decimal.Round(x.Amount, 2, MidpointRounding.AwayFromZero))).ToArray(),
                _sellerId, _isCredit ? _dueDate : null, ParkedSaleId: _parkedSaleId);
            var sale = await PosApi.CheckoutAsync(request);
            _notice = _isCredit
                ? $"Cuenta {sale.Number} creada · vence {sale.DueDate:dd/MM/yyyy} · {Money(sale.Total)}"
                : $"Venta {sale.Number} confirmada por el servidor · {Money(sale.Total)}";
            _lastSaleId = sale.Id;
            ResetCartState();
            await ClearOfflineDraftAsync();
            await LoadRegisterAsync();
        }
        catch (Exception ex) { _error = ex.Message; try { await LoadRegisterAsync(); } catch { } }
        finally { _busy = false; }
    }

    private PaymentMethod SummaryPaymentMethod
    {
        get
        {
            if (_isCredit) return PaymentMethod.Credit;
            if (_tenders.Count != 1) return PaymentMethod.Other;
            return _paymentOptions.FirstOrDefault(x => x.Id == _tenders[0].PaymentMethodId)?.Type switch
            {
                PaymentMethodType.Cash => PaymentMethod.Cash,
                PaymentMethodType.Card => PaymentMethod.Card,
                PaymentMethodType.Transfer => PaymentMethod.Transfer,
                _ => PaymentMethod.Other
            };
        }
    }

    private IEnumerable<TenantPaymentMethodDto> AvailableMethods(TenderForm tender) =>
        _paymentOptions.Where(method => method.Id == tender.PaymentMethodId || _tenders.All(item => item == tender || item.PaymentMethodId != method.Id));

    private void AddTender()
    {
        var method = _paymentOptions.FirstOrDefault(candidate => _tenders.All(item => item.PaymentMethodId != candidate.Id));
        if (method is null || _tenders.Count >= 10) return;
        _tenders.Add(new TenderForm(method.Id, 0m));
        ResetCheckoutKey();
    }

    private void RemoveTender(TenderForm tender)
    {
        _tenders.Remove(tender);
        ResetCheckoutKey();
    }

    private void OnSaleModeChanged()
    {
        if (!_isCredit && _tenders.Count == 0 && _paymentOptions.FirstOrDefault(x => x.Type == PaymentMethodType.Cash) is { } cash)
            _tenders.Add(new TenderForm(cash.Id, 0m));
        ResetCheckoutKey();
    }

    private void ResetCheckoutKey() => ResetCheckoutKey(rebalanceTenders: true);
    private void ResetCheckoutKey(bool rebalanceTenders)
    {
        _checkoutKey = Guid.NewGuid();
        if (!rebalanceTenders || _isCredit || _tenders.Count == 0) return;
        if (_tenders.Count == 1) _tenders[0].Amount = EstimatedTotal;
        else _tenders[^1].Amount = Math.Max(0m, decimal.Round(EstimatedTotal - _tenders.Take(_tenders.Count - 1).Sum(x => x.Amount), 2, MidpointRounding.AwayFromZero));
    }

    private void ResetOrderKeys()
    {
        _parkKey = Guid.NewGuid();
        ResetCheckoutKey();
    }

    private void ResetCartState()
    {
        _cart.Clear(); _cartProducts.Clear(); _discounts.Clear(); _parkedSaleId = null; _isCredit = false;
        _customerId = null; _sellerId = null; _dueDate = DateOnly.FromDateTime(DateTime.Today).AddDays(30); _error = null;
        foreach (var tender in _tenders) tender.Amount = 0m;
        ResetOrderKeys();
    }

    private decimal DiscountPercent(Guid productId) => _canApplyDiscount ? _discounts.GetValueOrDefault(productId) : 0m;
    private decimal LineTotal(ProductDto product, int quantity)
    {
        var gross = decimal.Round(product.UnitPrice * quantity, 2, MidpointRounding.AwayFromZero);
        var discount = decimal.Round(gross * DiscountPercent(product.Id) / 100m, 2, MidpointRounding.AwayFromZero);
        return gross - discount;
    }

    private async Task SetDiscount(Guid productId, string? rawValue)
    {
        if (!_canApplyDiscount || _parkedSaleId is not null || !decimal.TryParse(rawValue, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var percent)) return;
        _discounts[productId] = decimal.Round(Math.Clamp(percent, 0m, 100m), 2, MidpointRounding.AwayFromZero);
        ResetOrderKeys();
        await PersistOfflineDraftAsync();
    }

    private string Money(decimal amount) => string.Format(System.Globalization.CultureInfo.GetCultureInfo("es-DO"), "{0} {1:N2}", _settings?.CurrencyCode ?? _currencyCode, amount);

    private sealed class TenderForm(Guid paymentMethodId, decimal amount)
    {
        public Guid PaymentMethodId { get; set; } = paymentMethodId;
        public decimal Amount { get; set; } = amount;
    }

    [JSInvokable]
    public async Task SetOnline(bool online)
    {
        var wasOnline = _online;
        _online = online;
        if (!online) _error = null;
        else if (!wasOnline && !_loading && !string.IsNullOrWhiteSpace(_registerCode))
        {
            try
            {
                var methodsTask = PosApi.GetPaymentOptionsAsync();
                var sellersTask = PosApi.GetSellersAsync();
                var settingsTask = PosApi.GetBusinessSettingsAsync();
                var customersTask = PosApi.SearchCustomersAsync();
                await Task.WhenAll(methodsTask, sellersTask, settingsTask, customersTask);
                _paymentOptions = await methodsTask; _sellers = await sellersTask; _settings = await settingsTask; _customers = await customersTask;
                if (_tenders.Count == 0 && _paymentOptions.FirstOrDefault(x => x.Type == PaymentMethodType.Cash) is { } cashMethod)
                    _tenders.Add(new TenderForm(cashMethod.Id, 0m));
                await LoadRegisterAsync();
                foreach (var entry in _cart.ToArray())
                    if (_products.FirstOrDefault(x => x.Id == entry.Key) is { } current) _cartProducts[entry.Key] = current;
                ResetCheckoutKey();
                _notice = _cart.Count > 0 ? "Conexión restablecida · revisa el borrador y confirma para validar datos actuales." : null;
            }
            catch { _online = false; _error = "Aún no se puede consultar el servidor. El borrador sigue pendiente."; }
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_networkModule is not null)
        {
            try { await _networkModule.InvokeVoidAsync("unwatch"); await _networkModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_shortcutsModule is not null)
        {
            try { await _shortcutsModule.InvokeVoidAsync("unregister"); await _shortcutsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_offlineModule is not null)
        {
            try { await _offlineModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private void RestoreDraft(OfflineDraft? draft)
    {
        if (draft is null || draft.Lines.Count == 0 || draft.SavedAtUtc < DateTimeOffset.UtcNow.AddDays(-7)) return;
        if (!string.IsNullOrWhiteSpace(_registerCode) && !string.Equals(draft.RegisterCode, _registerCode, StringComparison.OrdinalIgnoreCase)) return;
        _registerCode = draft.RegisterCode;
        _cart.Clear(); _cartProducts.Clear(); _discounts.Clear();
        foreach (var line in draft.Lines.Where(x => x.Product.Id != Guid.Empty && x.Quantity is > 0 and <= 10000).Take(200))
        {
            _cart[line.Product.Id] = line.Quantity;
            _cartProducts[line.Product.Id] = line.Product;
            if (_canApplyDiscount && line.DiscountPercent > 0m) _discounts[line.Product.Id] = Math.Clamp(line.DiscountPercent, 0m, 100m);
        }
        _offlineDraftSaved = _cart.Count > 0;
        if (_offlineDraftSaved) _notice = "Borrador local recuperado · verifica precios, caja e inventario antes de confirmar.";
    }

    private async Task PersistOfflineDraftAsync()
    {
        if (_offlineModule is null) return;
        if (_cart.Count == 0 || _parkedSaleId is not null) { await ClearOfflineDraftAsync(); return; }
        try
        {
            var lines = _cart.Select(item => new OfflineDraftLine(_cartProducts[item.Key], item.Value, DiscountPercent(item.Key))).ToArray();
            await _offlineModule.InvokeVoidAsync("saveDraft", new OfflineDraft(_registerCode, lines, DateTimeOffset.UtcNow));
            _offlineDraftSaved = true; _offlineStorageError = null;
        }
        catch (JSException) { _offlineDraftSaved = false; _offlineStorageError = "No se pudo cifrar este borrador; mantenlo abierto hasta recuperar conexión."; }
    }

    private async Task ClearOfflineDraftAsync()
    {
        if (_offlineModule is not null)
        {
            try { await _offlineModule.InvokeVoidAsync("clearDraft"); }
            catch (JSException) { _offlineStorageError = "No se pudo eliminar el borrador local cifrado."; }
        }
        _offlineDraft = null; _offlineDraftSaved = false;
    }

    private sealed record OfflineDraft(string RegisterCode, IReadOnlyList<OfflineDraftLine> Lines, DateTimeOffset SavedAtUtc);
    private sealed record OfflineDraftLine(ProductDto Product, int Quantity, decimal DiscountPercent);
    private sealed record OfflineCatalog(PosRegisterDto Register, IReadOnlyList<ProductDto> Products, string CurrencyCode, decimal DefaultTaxRate);
}
